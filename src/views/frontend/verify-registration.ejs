<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title || 'Verify Account - Saver Grocery' %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

  <style>
    body { font-family: "Segoe UI", Roboto, Arial; color:#222; background:#f8f9fa; }
    .brand-bar { background:#fff; border-bottom:4px solid #1b683f; padding:12px 0; }
    .card-box { border:1px solid #e6e6e6; border-radius:8px; padding:18px; background:#fff; }
    .small-muted { color:#6c757d; }
    .btn-success { background:#1b683f; border-color:#1b683f; }
  </style>
</head>
<body>

  <div class="brand-bar">
    <div class="container d-flex align-items-center justify-content-between">
      <img src="/images/logo.png" alt="Saver Grocery" style="height:48px;" onerror="this.src='https://via.placeholder.com/160x48?text=Saver+Logo'">
    </div>
  </div>

  <main class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-6">

        <div class="card-box">

          <h4 class="mb-3">Verify Your Account</h4>
          <p class="small-muted">
            We sent an OTP to your email and phone (if provided). Enter it below to complete registration.
          </p>

          <!-- show flash messages -->
          <div class="mt-2 mb-3">
            <% const flashSuccess = (messages && messages.success_msg) || (typeof success_msg !== 'undefined' && success_msg) || []; %>
            <% const flashError = (messages && messages.error_msg) || (typeof error_msg !== 'undefined' && error_msg) || []; %>

            <% if (Array.isArray(flashSuccess) && flashSuccess.length) { %>
              <% flashSuccess.forEach(m => { %>
                <div class="alert alert-success"><%= m %></div>
              <% }) %>
            <% } %>

            <% if (Array.isArray(flashError) && flashError.length) { %>
              <% flashError.forEach(m => { %>
                <div class="alert alert-danger"><%= m %></div>
              <% }) %>
            <% } %>
          </div>

          <!-- OTP form -->
          <form action="/verify-registration/<%= userId %>" method="post" class="row g-3">
            <% if (typeof csrfToken !== 'undefined') { %>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>

            <div class="col-12">
              <label class="form-label">Enter OTP</label>
              <input name="otp" type="text" maxlength="8" required class="form-control" placeholder="Enter the 4-6 digit OTP">
            </div>

            <div class="col-12 d-flex align-items-center">
              <button type="submit" class="btn btn-success">Verify</button>

              <form action="/verify-registration/<%= userId %>/resend" method="post" class="ms-3">
                <% if (typeof csrfToken !== 'undefined') { %>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% } %>
                <button type="submit" class="btn btn-outline-secondary">Resend OTP</button>
              </form>

              <a href="/login" class="ms-auto small">Back to login</a>
            </div>
          </form>

          <hr class="my-3">

          <p class="small text-muted mb-0">
            If you did not receive the OTP, check your spam folder or click <strong>Resend OTP</strong>.
          </p>

        </div>

      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
