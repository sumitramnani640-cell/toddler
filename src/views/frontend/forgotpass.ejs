<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Forgot Password - Saver Grocery</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <%- include("layouts/header") %>
  <!-- Breadcrumb -->
  <div class="container breadcrumb-area">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb bg-transparent p-0 mb-0">
        <li class="breadcrumb-item"><a href="#"><i class="fa fa-home"></i></a></li>
        <li class="breadcrumb-item">Account</li>
        <li class="breadcrumb-item active" aria-current="page">Forgot Password</li>
      </ol>
    </nav>
  </div>

  <!-- Main Content -->
  <main class="container my-4">
    <div class="row">
      <!-- Left: main form area (takes center wide space) -->
      <div class="col-lg-8">
        <div class="card-box">
          <h5 class="mb-3">FORGOT YOUR PASSWORD?</h5>
          <p class="text-muted">Enter the e-mail address associated with your account. Click submit to have a password reset link e-mailed to you.</p>

          <form id="forgotForm" class="row g-3 align-items-center">
            <div class="col-12 col-md-8">
              <label for="email" class="form-label small">E-Mail Address</label>
              <input id="email" type="email" class="form-control" placeholder="E-Mail Address" value="sumitramnani796@gmail.com" required>
            </div>
            <div class="col-12 col-md-4 d-flex align-items-end">
              <button type="submit" class="btn btn-success">Continue</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Right: account settings -->
      <div class="col-lg-4">
        <div class="card account-sidebar p-3 mb-4">
          <div class="card-body">
            <h6 class="mb-3"><i class="fa fa-user-circle"></i> ACCOUNT SETTINGS</h6>
            <ul class="list-unstyled mb-0">
              <li class="mb-2"><a href="#">Login</a></li>
              <li class="mb-2"><a href="#">Register</a></li>
              <li class="mb-2"><a href="#">Forgot Password</a></li>
              <li class="mb-2"><a href="#">My Account</a></li>
            </ul>
          </div>
        </div>

        <!-- small contact/promo -->
        <div class="card p-3">
          <div class="card-body small text-muted">
            <strong>SAVER GROCERY</strong><br>
            DSP Warehouse Complex, Block-C19, Al Barsha South, P.O.Box 251723, Dubai, United Arab Emirates
            <p class="mb-0 mt-2"><i class="fa fa-phone"></i> +971-542526215</p>
            <p class="mb-0"><i class="fa fa-envelope"></i> info@savergrocery.com</p>
          </div>
        </div>
      </div>
    </div>
  </main>

   <%- include("layouts/footer") %>
  <!-- Floating chat/help bubble (like screenshot) -->
  <div style="position:fixed; right:20px; bottom:90px; z-index:1050;">
    <div class="card p-2" style="width:220px; box-shadow:0 6px 18px rgba(0,0,0,.12);">
      <div class="small">Welcome to our site, if you need help simply reply to this message, we are online and ready to help.</div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // demo behavior for form
    document.getElementById('forgotForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const email = document.getElementById('email').value.trim();
      if (!email) {
        alert('Please enter your email address.');
        return;
      }
      // Replace with AJAX call or form submission to your backend
      alert('Password reset link sent to: ' + email + ' (demo).');
    });

    // keep category dropdown open on hover if desired (optional)
    (function(){
      const dropdownToggle = document.getElementById('categoryToggle');
      const dropdown = new bootstrap.Dropdown(dropdownToggle);
      // optional: open on hover for desktop
      if (window.matchMedia('(min-width: 768px)').matches) {
        dropdownToggle.parentElement.addEventListener('mouseenter', () => dropdown.show());
        dropdownToggle.parentElement.addEventListener('mouseleave', () => dropdown.hide());
      }
    })();
  </script>
</body>
</html>
