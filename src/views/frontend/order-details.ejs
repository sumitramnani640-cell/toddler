  <!-- footer -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div style="flex:1; min-width:220px">
          <div style="font-weight:700; color:var(--green)">SAVER GROCERY</div>
          <p class="muted" style="max-width:360px">Saver Grocery is the first food grocery in the region operating on a discount model, offering the best quality products to its customers at the best price.</p>
          <p class="muted">DSP Warehouse Complex, Al Barsha South, Dubai</p>
