<!-- save as order-details-static.html -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Order Information - Saver Grocery (Static)</title>

  <!-- minimal bootstrap-like reset (no external deps) -->
  <style>
    :root{
      --green:#0b662e;
      --dark-green:#087030;
      --muted:#6b6b6b;
      --card-bg:#fff;
      --border:#e6e6e6;
      --max-width:1100px;
    }
    *{box-sizing:border-box}
    body{font-family: "Segoe UI", Roboto, Arial, sans-serif; margin:0; color:#222; background:#f8fbfa}
    .container{max-width:var(--max-width); margin:0 auto; padding:18px}
    a{color:var(--green); text-decoration:none}

    /* top green strip */
    .top-strip{background:linear-gradient(90deg,var(--green),#145b2e); color:#fff; font-size:13px; padding:8px 0}
    .top-strip .inner{display:flex; justify-content:space-between; align-items:center; gap:12px}

    /* header */
    header{background:#fff; border-bottom:1px solid var(--border)}
    .header-inner{display:flex; align-items:center; gap:18px; padding:14px 0}
    .logo{display:flex; align-items:center; gap:12px}
    .logo img{height:44px; object-fit:contain; border-radius:6px}
    .search{flex:1}
    .search input{width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:6px}
    .account-cart{display:flex; gap:14px; align-items:center}

    /* nav categories row */
    .cats{background:#fff; border-bottom:1px solid var(--border); padding:8px 0; font-size:14px}
    .breadcrumb{padding:12px 0; color:var(--muted); font-size:14px}

    /* main layout */
    .layout{display:flex; gap:20px; align-items:flex-start}
    .main{flex:1}
    .sidebar{width:260px}

    /* card styling */
    .card{background:var(--card-bg); border:1px solid var(--border); border-radius:6px; padding:14px; margin-bottom:18px}
    h3.section-title{margin:0 0 12px; color:var(--green); font-size:18px}

    /* order details table */
    .order-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:10px; margin-bottom:12px}
    .order-grid .box{background:#fafafa; border:1px solid #eee; padding:8px; border-radius:4px; font-size:13px}
    .address{white-space:pre-line; font-size:13px; color:#333}

    table.order-table{width:100%; border-collapse:collapse; margin-top:8px}
    table.order-table thead th{background:#fbfbfb; text-align:left; padding:10px; border:1px solid #eee; font-weight:600}
    table.order-table td{padding:10px; border:1px solid #eee; vertical-align:middle; font-size:13px}
    table.order-table img{max-width:72px; max-height:48px; object-fit:cover; border-radius:4px}

    .totals{width:320px; margin-left:auto; margin-top:12px; font-size:14px}
    .totals .row{display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px dashed #eee}
    .totals .row.total{font-weight:700; border-top:1px solid #eee; padding-top:10px; margin-top:8px}

    /* sidebar */
    .sidebar .section-title{font-size:14px; margin-bottom:8px}
    .sidebar ul{list-style:none; padding:0; margin:0}
    .sidebar li{padding:8px 0; border-bottom:1px solid #f1f1f1}
    .logout{display:inline-block; margin-top:10px; background:var(--green); color:#fff; padding:8px 12px; border-radius:6px; text-align:center}

    /* footer */
    footer{background:#fff; border-top:1px solid var(--border); padding:18px 0; margin-top:28px; font-size:13px}
    .footer-grid{display:flex; gap:18px; flex-wrap:wrap}
    .muted{color:var(--muted)}

    /* responsive */
    @media (max-width:900px){
      .layout{flex-direction:column}
      .sidebar{width:100%}
      .totals{width:100%}
      .order-grid{grid-template-columns:1fr}
    }
  </style>
</head>
<body>

   <%- include("layouts/header") %>

  <!-- breadcrumb -->
  <div class="container breadcrumb">
    <span><a href="/">Home</a> / </span>
    <span style="color:#333"> Account </span>
    <span style="color:#999"> / Order History / Order Information</span>
  </div>

  <!-- main -->
  <div class="container">
    <div class="layout">
      <!-- main column -->
      <div class="main">

        <div class="card">
          <h3 class="section-title">ORDER HISTORY</h3>

          <!-- order header details -->
          <div style="display:flex; gap:14px; align-items:flex-start; flex-wrap:wrap">
            <div style="flex:1; min-width:220px">
              <div style="font-weight:700; margin-bottom:6px">Order Details</div>
              <div style="font-size:13px">
                <div><strong>Order ID:</strong> #3298</div>
                <div><strong>Date Added:</strong> 22 Nov, 2025</div>
                <div><strong>Payment Method:</strong> Cash On Delivery</div>
                <div><strong>Shipping Method:</strong> Free Shipping</div>
              </div>
            </div>

            <div style="flex:1; min-width:220px">
              <div style="font-weight:700; margin-bottom:6px">Payment & Shipping</div>
              <div style="font-size:13px">
                <div><strong>Payment Address</strong></div>
                <div class="address">sumit ramnani
100
10
Bairagarh
Abu Dhabi
United Arab Emirates</div>
              </div>
            </div>

            <div style="flex:1; min-width:220px">
              <div style="font-weight:700; margin-bottom:6px">Shipping Address</div>
              <div class="address">sumit ramnani
100
10
Bairagarh
Abu Dhabi
United Arab Emirates</div>
            </div>
          </div>

          <!-- products table -->
          <div style="margin-top:14px; overflow:auto">
            <table class="order-table" role="table" aria-label="Order products">
              <thead>
                <tr>
                  <th>Product Name</th>
                  <th>Model</th>
                  <th>Quantity</th>
                  <th>Price</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td style="display:flex; gap:10px; align-items:center">
                    <img src="https://via.placeholder.com/72x48?text=Salmon" alt="product">
                    <div>
                      <div style="font-weight:600">Santa Bremor Soft Smoked Salmon Fillet Slices 100g</div>
                    </div>
                  </td>
                  <td>4810168029449</td>
                  <td>1</td>
                  <td>AED 37.88</td>
                  <td>AED 37.88</td>
                </tr>

                <tr>
                  <td style="display:flex; gap:10px; align-items:center">
                    <img src="https://via.placeholder.com/72x48?text=Beetroot" alt="product">
                    <div>
                      <div style="font-weight:600">Allaire Baby Whole Beetroots 2 x 200g</div>
                    </div>
                  </td>
                  <td>3281440001001</td>
                  <td>1</td>
                  <td>AED 13.80</td>
                  <td>AED 13.80</td>
                </tr>

                <tr>
                  <td style="display:flex; gap:10px; align-items:center">
                    <img src="https://via.placeholder.com/72x48?text=Beans" alt="product">
                    <div>
                      <div style="font-weight:600">Giovanni White Beans Cannellini 400g</div>
                    </div>
                  </td>
                  <td>6299200036023</td>
                  <td>5</td>
                  <td>AED 4.50</td>
                  <td>AED 22.50</td>
                </tr>

                <tr>
                  <td style="display:flex; gap:10px; align-items:center">
                    <img src="https://via.placeholder.com/72x48?text=Mug" alt="product">
                    <div>
                      <div style="font-weight:600">Windel Mug Traditional Easter 9</div>
                    </div>
                  </td>
                  <td>4006813004004</td>
                  <td>12</td>
                  <td>AED 24.00</td>
                  <td>AED 288.00</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- totals -->
          <div class="totals card" aria-hidden="false" style="margin-top:14px; padding:12px">
            <div class="row"><div class="muted">Sub-Total</div><div>AED 362.18</div></div>
            <div class="row"><div class="muted">Shipping</div><div>AED 0.00</div></div>
            <div class="row"><div class="muted">VAT (5%)</div><div>AED 18.11</div></div>
            <div class="row total"><div>Total</div><div>AED 380.29</div></div>
          </div>

          <!-- order history log -->
          <div style="margin-top:18px">
            <h4 style="font-size:16px; margin:0 0 8px">Order History</h4>
            <table class="order-table" style="margin-top:6px">
              <thead><tr><th>Date Added</th><th>Status</th><th>Comment</th></tr></thead>
              <tbody>
                <tr><td>22 Nov, 2025</td><td>Processing</td><td>-</td></tr>
              </tbody>
            </table>
          </div>

          <div style="text-align:right; margin-top:14px">
            <a class="logout" href="/account">Continue</a>
          </div>
        </div>

      </div>

      <!-- sidebar -->
      <aside class="sidebar">
        <div class="card">
          <div class="section-title">ACCOUNT SETTINGS</div>
          <ul style="margin-top:8px; padding-left:0">
            <li><a href="/account">My Account</a></li>
            <li><a href="/account/edit">Edit Account</a></li>
            <li><a href="/account/password">Password</a></li>
            <li><a href="/account/address">Address Book</a></li>
          </ul>
        </div>

        <div class="card">
          <div class="section-title">MY ORDERS</div>
          <ul style="margin-top:8px">
            <li><a href="/orders">Order History</a></li>
            <li><a href="/orders/returns">Returns</a></li>
            <li><a href="/orders/transactions">Transactions</a></li>
          </ul>
        </div>

        <div class="card">
          <div class="section-title">MY STUFF</div>
          <ul style="margin-top:8px">
            <li><a href="/wishlist">Wishlist</a></li>
            <li><a href="/newsletter">Newsletter</a></li>
          </ul>

          <a href="/logout" class="logout" style="display:block; text-align:center; margin-top:12px">Logout</a>
        </div>
      </aside>
    </div>
  </div>

  <!-- footer -->
  <%- include("layouts/footer") %>

</body>
</html>
