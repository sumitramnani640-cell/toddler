<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title || 'Order History - Saver Grocery' %></title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <style>
    .dashboard-card {
      padding: 20px;
      border: 1px solid #eee;
      border-radius: 8px;
      background: #fff;
      transition: 0.2s;
    }
     /* ---------- Top thin nav ---------- */
    .nav-bottom { background: linear-gradient(135deg,#087030 0%,#0e6424 100%); color:#fff; }
    .nav-bottom a{ color:rgba(255,255,255,0.95); text-decoration:none; font-size:0.95rem; }

    /* ---------- Header / search ---------- */
    header.site-header{ background:#fff; padding:12px 0; border-bottom:1px solid #eee; }
    .site-logo { font-weight:700; color:#0b662e; font-size:1.25rem; display:flex; align-items:center; gap:.5rem }
    .site-logo i{ color:#0b662e }

    form.search-form .form-select,
    form.search-form .form-control { height:40px; border-radius:6px; }

    .dashboard-card:hover { background: #f9f9f9; }
    .sidebar-card { border-radius: 8px; border: 1px solid #eee; }
    .badge-cart { position: absolute; top: 0; right: -6px; }
    .order-screenshot { max-width: 60px; max-height: 40px; object-fit: cover; border-radius: 4px; }
  </style>

</head>
<body>

 <!-- thin topbar -->
  <div class="nav-bottom text-white small py-2">
    <div class="container d-flex justify-content-between">
      <div class="d-flex gap-4">
        <div><i class="fas fa-truck me-2"></i>Fast &amp; Free Delivery</div>
        <div><i class="fas fa-shopping-basket me-2"></i>Thousands of products</div>
      </div>
      <div><i class="fas fa-phone me-2"></i><a href="tel:+971542526215" class="text-white text-decoration-none">+971-542526215</a></div>
    </div>
  </div>

  <!-- header -->
  <header class="site-header">
    <div class="container d-flex align-items-center gap-3">
      <a href="/" class="site-logo"><i class="fas fa-shopping-cart"></i> Savers Grocery</a>

  





  <!-- Search Button -->
 <div class="flex-fill px-3 d-none d-md-block">
          <form action="/search" method="GET" class="d-flex">
            <input name="q" class="form-control me-2" type="search" placeholder="Search Products">
            <button class="btn btn-success" type="submit"><i class="fas fa-search"></i></button>
          </form>
        </div>


<div class="dropdown position-relative">

  <% if (!user) { %>
    <!-- 🚫 NOT LOGGED IN -->
    <a class="d-flex align-items-center text-decoration-none login-btn"
       style="color:#0b662e; cursor:pointer;"
       id="loginDropdown"
       data-bs-toggle="dropdown"
       aria-expanded="false">
      <i class="fas fa-user me-1"></i> Login & Register
    </a>

    <div class="dropdown-menu dropdown-menu-end p-3 shadow"
         aria-labelledby="loginDropdown"
         style="min-width:230px; border-radius:10px;">

      <h6 class="mb-1">Your Account</h6>
      <p class="small text-muted mb-2">Access account and manage orders</p>

      <div class="d-flex flex-column gap-2">
        <a href="/register" class="btn btn-sm btn-outline-dark w-100">
          <i class="fa fa-user-plus me-1"></i> Register
        </a>
        <a href="/login" class="btn btn-sm btn-success w-100">
          <i class="fa fa-sign-in-alt me-1"></i> Login
        </a>
      </div>

    </div>

  <% } else { %>
    <!-- ✅ LOGGED IN USER -->
    <a class="d-flex align-items-center text-decoration-none login-btn"
       style="color:#0b662e; cursor:pointer;"
       id="accountDropdown"
       data-bs-toggle="dropdown"
       aria-expanded="false">
      <i class="fas fa-user-circle me-1"></i> <%= user.name %>
    </a>

    <div class="dropdown-menu dropdown-menu-end p-3 shadow"
         aria-labelledby="accountDropdown"
         style="min-width:230px; border-radius:10px;">

      <h6 class="mb-1">Hello, <%= user.name %></h6>
      <p class="small text-muted mb-2">Manage your account</p>

      <div class="d-flex flex-column gap-2">
        <a href="/account" class="btn btn-sm btn-outline-dark w-100">
          <i class="fa fa-user me-1"></i> My Account
        </a>
      </div>

    </div>
  <% } %>

</div>


       <a href="/cart" class="position-relative" style="color:#0b662e;">
        <i class="fas fa-shopping-cart fa-lg"></i>
        <span class="badge bg-warning text-dark position-absolute top-0 start-100 translate-middle">
          <%= cartCount || 0 %>
        </span>
      </a>
</div>
</div>

    </div>
  </div>
</header>


<div class="nav-bottom text-white small py-2" style="background:#1b683f;">
  <div class="container d-flex justify-content-between align-items-center">

    <!-- LEFT SIDE -->
    <div class="d-flex align-items-center gap-3">
      <i class="fas fa-truck"></i>
      Next Standard Delivery Today 6:00 PM-10:00 PM
    </div>

    <!-- RIGHT SIDE -->
    <div class="d-flex align-items-center gap-2">
      <i class="fas fa-map-marker-alt"></i>
      <span>Deliver to: Dubai Festival City - Dubai</span>
    </div>

  </div>
</div>


<!-- MAIN CONTENT -->
<div class="container my-5">

  <!-- Breadcrumb -->
  <div class="mb-3">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
       <li class="breadcrumb-item">
  <i class="fa fa-user-pen"></i><a href="/account" style="color:#000000;border-radius:5px;text-decoration:none;margin-left:5px;">Account</a>
</li>

        <li class="breadcrumb-item active" aria-current="page">Order History</li>
      </ol>
    </nav>
  </div>

  <div class="row">

    <!-- Orders table -->
    <div class="col-md-9">
      <h5 class="fw-bold mb-3">ORDER HISTORY</h5>

      <div class="table-responsive">
        <table class="table table-bordered text-center align-middle">
          <thead class="table-light">
            <tr>
              <th>Order ID</th>
              <th>No Of Ordered Products</th>
              <th>Status</th>
              <th>Total</th>
              <th>Date Added</th>
              <th>View</th>
            </tr>
          </thead>

          <tbody>
            <% if (Array.isArray(orders) && orders.length) { %>
              <% orders.forEach(function(order){ %>
                <tr>
                  <td>#<%= order.id %></td>
                 
                  <td><%= (typeof order.itemsCount !== 'undefined') ? order.itemsCount : '-' %></td>
                  <td><%= order.status || '-' %></td>
                  <td><%= order.totalFormatted || '-' %></td>
                  <td><%= order.dateFormatted || '' %></td>
                  <td>
                    <a href="/order-details" class="btn btn-success btn-sm" title="View order">
                      <i class="fa fa-eye"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7">No orders found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-3">
        <span>
          <% if (typeof pagination !== 'undefined') { %>
            Showing <%= pagination.from %> to <%= pagination.to %> of <%= pagination.total %> (<%= pagination.pages %> Pages)
          <% } else { %>
            Showing <%= orders && orders.length ? orders.length : 0 %> orders
          <% } %>
        </span>

        <a href="/account" class="btn btn-success">Continue</a>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="col-md-3">
      <div class="card p-3 sidebar-card">

        <h6 class="fw-bold mb-3">
          <i class="fa fa-user text-success me-2"></i> ACCOUNT SETTINGS
        </h6>
        <ul class="list-unstyled mb-3">
          <li><a href="/account" class="d-block py-1">My Account</a></li>
          <li><a href="/account/edit" class="d-block py-1">Edit Account</a></li>
          <li><a href="/account/password" class="d-block py-1">Password</a></li>
          <li><a href="/account/address" class="d-block py-1">Address Book</a></li>
        </ul>



        <h6 class="fw-bold mt-4 mb-3">
          <i class="fa fa-folder text-success me-2"></i> MY STUFF
        </h6>
        <ul class="list-unstyled mb-3">
          <li><a href="/wishlist" class="d-block py-1">Wishlist</a></li>
          <li><a href="/newsletter" class="d-block py-1">Newsletter</a></li>
        </ul>


   <button id="logoutBtn" class="btn btn-danger btn-sm w-100">
    <i class="fa fa-sign-out-alt me-1"></i> Logout
</button>

<!-- Hidden form -->
<form id="logoutForm" action="/logout" method="POST" class="d-none"></form>

</form>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.getElementById("logoutBtn")?.addEventListener("click", function (e) {
    e.preventDefault();

    Swal.fire({
        title: 'Logout?',
        text: 'Do you want to log out from your account?',
        icon: 'warning',
        width: '320px',
        padding: '0.8rem',
        showCancelButton: true,
        confirmButtonText: 'Logout',
        cancelButtonText: 'Cancel',
        buttonsStyling: false,
        customClass: {
            popup: 'rounded-3',
            confirmButton: 'btn btn-danger me-2',
            cancelButton: 'btn btn-secondary'
        }
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById("logoutForm").submit();
        }
    });
});
</script>
      </div>
    </div>

  </div>
</div>

<!-- FOOTER -->
<footer class="mt-5">
    <div class="container"> <style>
      footer { background: #087030; padding: 40px 0; border-top: 1px solid #e0e0e0; }
      footer a { color: #ffffff; text-decoration: none; font-weight: bold; }
      footer a:hover { text-decoration: underline; }
    </style>
      <div class="row"><style>
      footer { background: #087030; padding: 40px 0; border-top: 1px solid #e0e0e0; }
      footer a { color: #ffffff; text-decoration: none; font-weight: bold; }
      footer a:hover { text-decoration: underline; }
    </style>
        <div class="col-sm-3"><h6 class="fw-bold">Get to Know Us</h6><a href="#">About</a></div>
        <div class="col-sm-3"><h6 class="fw-bold">Connect</h6><a href="#">Facebook</a></div>
        <div class="col-sm-3"><h6 class="fw-bold">Sell with us</h6><a href="#">Sell</a></div>
        <div class="col-sm-3"><h6 class="fw-bold">Help</h6><a href="#">Support</a></div>
      </div>



<br>
      
  <div class="col-md-4"><style>
      footer { background: #087030; padding: 40px 0; border-top: 1px solid #e0e0e0; }
      footer a { color: #ffffff; text-decoration: none; font-weight: bold; }
      footer a:hover { text-decoration: underline; }
    </style>
          <h6>SIGN UP FOR NEWSLETTER</h6>
<p class="small text-muted">Make sure that you never miss our interesting news and exclusive promotion.</p>

<!-- Alert Messages -->
<% if (typeof success !== "undefined") { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<% if (typeof error !== "undefined") { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<form class="d-flex" action="/subscribe" method="POST">
  <input class="form-control me-2" name="email" placeholder="Your email address" required>
  <button class="btn btn-success" type="submit">Subscribe</button>
</form>




        </div>
      </div>
    </div>



      <div class="text-center small mt-4">© <%= new Date().getFullYear() %> Savers Grocery — All Rights Reserved</div>
    </div>
  </footer>

</body>
</html>
