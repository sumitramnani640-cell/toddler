<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || "Savers Grocery" %></title>

  <!-- Bootstrap + icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
  
.product-card {
  position: relative; /* important */
  border-radius: 12px;
  overflow: hidden;
}

/* Cart button bottom-left */
.cart-btn-left {
  position: absolute;
  bottom: 12px;
  left: 12px;
}

.cart-btn-left .btn {
  padding: 6px 14px;
  font-size: 0.85rem;
  border-radius: 6px;
}
.wishlist-circle {
  width: 34px;
  height: 34px;
  padding: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wishlist-circle i {
  font-size: 14px;
}

/* optional hover effect */
.wishlist-circle:hover {
  background-color: #dc3545;
  color: #fff;
}

</style>
 
</head>
<body>

<%- include("layouts/header") %>
<!-- CATEGORIES BAR -->
<div class="categories-bar py-2">
  <div class="container d-flex align-items-center gap-4 flex-wrap">

    <!-- ALL CATEGORY DROPDOWN -->
    <div class="dropdown">
      <button class="btn btn-link text-dark fw-semibold dropdown-toggle p-0" type="button" data-bs-toggle="dropdown">
        All Category
      </button>
      <ul class="dropdown-menu">
        <% categories.forEach(cat => { %>
          <li><a class="dropdown-item" href="/category/<%= cat.slug %>"><%= cat.name %></a></li>
        <% }) %>
      </ul>
    </div>

    <!-- Dynamic Category List -->
    <div class="d-flex align-items-center gap-4 flex-wrap">
      <% categories.slice(0, 8).forEach(cat => { %>
        <a href="/category/<%= cat.slug %>" class="category-link text-dark">
          <%= cat.name %>
        </a>
      <% }) %>
    </div>

  </div>
</div>
  <main class="main-container">

    <!-- BANNER CAROUSEL -->
    <% if (banners && banners.length > 0) { %>
      <section class="py-4">
        <div class="container">
          <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
              <% banners.forEach((banner, index) => { %>
                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                  <img
                    src="<%= banner.image %>"
                    class="d-block w-100 banner-carousel"
                    alt="<%= banner.title || 'Banner' %>"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              <% }) %>
            </div>

            <% if (banners.length > 1) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
            <% } %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- SHOP BY CATEGORY -->
    <% if (categories && categories.length > 0) { %>
      <section id="categories">
        <div class="container">
          <div class="section-title">Shop by Category</div>
          <div class="category-grid mt-4">
            <% categories.slice(0,8).forEach(cat => { %>
              <div class="category-card">
                <a href="/category/<%= cat.slug %>">
                  <div class="category-img-wrap">
                    <!-- category.image assumed like "/uploads/categories/..." -->
                    <img src="<%= cat.image ? cat.image : '/placeholder.jpg' %>?v=<%= cat.updatedAt ? cat.updatedAt.getTime() : Date.now() %>" alt="<%= cat.name %>">
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- CATEGORY PREVIEWS (banner + fuller product cards) -->
    <% if (Array.isArray(categoriesWithPreview) && categoriesWithPreview.length) { %>
      <% categoriesWithPreview.slice(8, 13).forEach(({ category, previewProducts }) => { %>
        <section class="category-block">
          <div class="container">
            <!-- banner -->
            <div class="category-banner-wrap">
              <a href="/category/<%= category.slug %>" class="banner-link" aria-label="Open <%= category.name %> category">
                <img
                  src="<%= category.banner_image ? category.banner_image : '/placeholder-banner.jpg' %>?v=<%= category.updatedAt ? category.updatedAt.getTime() : Date.now() %>"
                  alt="<%= category.name %> banner"
                  class="category-banner-img"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </div>

            <div class="category-header">
              <h2><%= category.name %></h2>
              <a class="view-all-btn" href="/category/<%= category.slug %>">View All</a>
            </div>

            <div class="product-preview-grid mb-3">
              <% (previewProducts || []).forEach(product => { %>
                <div class="product-card">
                  <a href="/product/<%= product.slug %>">
                    <% 
                      // determine product image: product.images[0].filename OR product.image
                      var prodImg = (product.images && product.images.length) ? product.images[0].filename : (product.image || '/images/placeholder.png');
                    %>
                    <img src="<%= prodImg %>" alt="<%= product.name %>">

                    <h4><%= product.name %></h4>
                   <div class="price">
  <span class="price-label">Price:</span>
  ₹ <%= product.price %>
</div>


  <div class="d-flex align-items-center justify-content-end gap-5 mt-2">
  <!-- ADD BUTTON -->
 <form action="/cart/add" method="POST" class="cart-btn-left">
    <input type="hidden" name="productId" value="<%= product.id %>">
    <button type="submit" class="btn btn-success btn-sm">
     <i class="fa-solid fa-cart-shopping"></i> Add To Cart 
    </button>
  </form>

  <!-- WISHLIST BUTTON -->
<form action="/wishlist/add" method="POST" class="d-inline">
  <input type="hidden" name="productId" value="<%= product.id %>">

  <button type="submit" class="btn btn-outline-danger btn-sm wishlist-circle">
    <i class="far fa-heart"></i>
  </button>
</form>
</div>
              </a>
                </div>
              <% }) %>
            </div>
          </div>
        </section>
      <% }) %>
    <% } %>

    <!-- FEATURED PRODUCTS -->
  <% if (featuredProducts && featuredProducts.length > 0) { %>
<section id="products" class="py-5">
  <div class="container">
    <h3 class="mb-4 fw-bold text-center">Featured Products</h3>

    <div class="row">
      <% featuredProducts.slice(0, 4).forEach(function(prod) { %>
        <div class="col-md-3 mb-4">
          <div class="card product-card h-100">

            <!-- Product Image -->
            <div class="product-img">
              <img src="<%= prod.image || '/images/placeholder.png' %>" 
                   alt="<%= prod.name %>" class="img-fluid">
            </div>

            <!-- Product Info -->
            <div class="card-body d-flex flex-column">
              <h6 class="fw-bold text-truncate"><%= prod.name %></h6>
              <p class="text-success fw-bold">₹<%= Number(prod.price).toFixed(2) %></p>

              <!-- Spacer pushes buttons to bottom -->
              <div class="mt-auto d-grid gap-2">
              

                <div class="d-flex gap-2">
                  <form action="/cart/add" method="POST" class="flex-fill">
                    <input type="hidden" name="productId" value="<%= prod.id %>">
                    <button class="btn btn-success btn-sm w-100" <%= prod.stock <= 0 ? 'disabled' : '' %>>
                      <i class="fas fa-cart-plus me-1"></i>Add To Cart
                    </button>
                  </form>

                  <form action="/wishlist/add" method="POST">
                    <input type="hidden" name="productId" value="<%= prod.id %>">
                    <button class="btn btn-outline-danger btn-sm">
                      <i class="far fa-heart"></i>
                    </button>
                  </form>
                </div>
              </div>

            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

  </main>

  <!-- footer -->
  <%- include("layouts/footer") %>

 <!-- ================= SCRIPTS ================= -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- ================= WISHLIST POPUP ================= -->
<script>
(function () {
  const params = new URLSearchParams(window.location.search);
  const status = params.get('wishlist');

  if (status === 'added' || status === 'exists') {
    Swal.fire({
      title: status === 'added' ? 'Added to Wishlist' : 'Already in Wishlist',
      text: status === 'added'
        ? 'Your item was added to your wishlist.'
        : 'This item is already in your wishlist.',
      icon: status === 'added' ? 'success' : 'info',
      showCancelButton: true,
      confirmButtonText: 'Go to Wishlist',
      cancelButtonText: 'Continue Shopping',
      reverseButtons: true
    }).then(result => {
      if (result.isConfirmed) {
        window.location.href = '/wishlist';
      }
    });

    window.history.replaceState({}, document.title, window.location.pathname);
  }
})();
</script>
</body>
</html>
