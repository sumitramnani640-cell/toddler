    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        
    .hg-topbar, .hg-delivery { background:#1f7a4a; color:#fff; }
    .hg-topbar { font-size:14px; }
    .hg-topbar .icon { width:20px; display:inline-block; text-align:center; }
    .hg-main { background:#fff; border-top:4px solid transparent; border-bottom:1px solid #eee; }
    .hg-main .logo img { height:56px; }
    .hg-search .form-control { height:40px; border-radius:6px; }
    .hg-search .btn-search { height:40px; border-radius:6px; }
    .hg-cta .btn { border-radius:8px; }
    .hg-cart { position:relative; }
    .hg-cart .badge { position:absolute; top:-6px; right:-8px; background:#ffcc00; color:#000; font-weight:700; border-radius:50%; padding:4px 7px; }
    @media (max-width:767px) {
      .hg-search { display:none; }
      .hg-main .logo img { height:48px; }
    }
  
        /* ✅ Header */
        header,
        .nav-bottom {
            width: 100%;
            background: #ffffff;
            color: #000000;
        }

        /* ✅ Universal Layout */
        body,
        html {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #ffffff !important;
            overflow-x: hidden;
        }

        /* ✅ Center main content */
        .container,
        .container-fluid,
        .main-container {
            max-width: 1200px;
            width: 100%;
            margin: auto;
        }

        /* ✅ Full-Width Banner with No Clipping */
        .banner {
            width: 100%;
        }

        .banner img {
            width: 100%;
            height: auto;
            object-fit: cover;
            border-radius: 0 !important;
            display: block;
            object-fit: cover;
        }

        /* ✅ Category Section */
        .category-section {
            margin: 40px auto;
            background: #ffffff;
            padding: 20px 0;
            width: 100%;
            max-width: 1200px;
        }

        .banner-carousel {
            border-radius: 8px;
            height: 200px;
            object-fit: cover;
            width: 100%;
        }

        .category-header {
            text-align: left;
            font-family: 'Arial', sans-serif;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .category-header h2 {
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #000000;
            font-style: Arial, sans-serif;
            border-radius: 4px;
            font-weight: 700;
            font-size: 25px;
        }

        .view-all {
            font-size: 14px;
            text-decoration: none;
            color: #0073e6;
            font-weight: 600;
        }

        /* ✅ Product Grid */
        .products-container {
            display: flex;
            /* flex-wrap: wrap; */
            gap: 20px;
            justify-content: center;
            padding: 20px 0;
        }

        /* ✅ Product Card */
        .product-card {
            width: 230px;
            border: 1px solid #dddddd;
            border-radius: 12px;
            background: #ffffff;
            padding: 12px;
            transition: 0.25s ease;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.12);
        }

        .product-image img {
            width: 100%;
            height: 210px;
            object-fit: contain;
            border-radius: 8px;
        }

        /* ✅ Title */
        .product-title {
            text-align: center;
            font-size: 15px;
            font-weight: 700;
            margin: 10px 0 6px;
        }

        /* ✅ CTA Button */
        .add-btn {
            background: #000000;
            border: none;
            color: #fff;
            padding: 8px 0;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            width: 100%;
            transition: 0.25s;
            text-transform: uppercase;
        }

        .add-btn:hover {
            background: #005bb8;
        }

        /* ✅ Footer */
        footer {
            width: 100%;
            background: #31383f;
            color: #ffffff;
            text-align: center;
            padding: 35px 15px;
            font-size: 14px;
        }

        /* ✅ RESPONSIVE DESIGN */
        /* Tablet */
        @media (max-width: 991px) {
            .product-card {
                width: 200px;
            }

            .banner img {
                height: 230px;
            }
        }

        /* Large Phones */
        @media (max-width: 600px) {
            .product-card {
                width: 46%;
            }

            .banner img {
                height: 200px;
            }
        }

        /* Small Phones */
        @media (max-width: 420px) {
            .product-card {
                width: 90%;
            }

            .banner img {
                height: 180px;
            }
        }
    </style>
</head>

