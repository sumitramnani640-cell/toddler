   <form class="search-form d-flex flex-grow-1" action="/search" method="GET" style="max-width:900px;">

  <!-- Dynamic Category Dropdown
  <select name="category" class="form-select w-auto me-2" style="width:auto; min-width:130px;">
    <option value="">All Categories</option>
    <% if (categories && categories.length) { %>
      <% categories.forEach(cat => { %>
        <option 
          value="<%= cat.slug %>"
          <%= category === cat.slug ? 'selected' : '' %>>
          <%= cat.name %>
        </option>
      <% }) %>
    <% } %>
  </select> -->

  <!-- Search Input -->
  <input type="text" name="q" class="form-control"
    placeholder="Search products..."
    value="<%= q || '' %>">

  <!-- Search Button -->
  <button class="btn ms-2" style="background:#0b662e;color:#fff;border:none">
    <i class="fas fa-search"></i>
  </button>

</form>


<div class="dropdown position-relative">

  <% if (!user) { %>
    <!-- 🚫 NOT LOGGED IN -->
    <a class="d-flex align-items-center text-decoration-none login-btn"
       style="color:#0b662e; cursor:pointer;"
       id="loginDropdown"
       data-bs-toggle="dropdown"
       aria-expanded="false">
      <i class="fas fa-user me-1"></i> Login & Register
    </a>

    <div class="dropdown-menu dropdown-menu-end p-3 shadow"
         aria-labelledby="loginDropdown"
         style="min-width:230px; border-radius:10px;">

      <h6 class="mb-1">Your Account</h6>
      <p class="small text-muted mb-2">Access account and manage orders</p>

      <div class="d-flex flex-column gap-2">
        <a href="/register" class="btn btn-sm btn-outline-dark w-100">
          <i class="fa fa-user-plus me-1"></i> Register
        </a>
        <a href="/login" class="btn btn-sm btn-success w-100">
          <i class="fa fa-sign-in-alt me-1"></i> Login
        </a>
      </div>

    </div>

  <% } else { %>
    <!-- ✅ LOGGED IN USER -->
    <a class="d-flex align-items-center text-decoration-none login-btn"
       style="color:#0b662e; cursor:pointer;"
       id="accountDropdown"
       data-bs-toggle="dropdown"
       aria-expanded="false">
      <i class="fas fa-user-circle me-1"></i> <%= user.name %>
    </a>

    <div class="dropdown-menu dropdown-menu-end p-3 shadow"
         aria-labelledby="accountDropdown"
         style="min-width:230px; border-radius:10px;">

      <h6 class="mb-1">Hello, <%= user.name %></h6>
      <p class="small text-muted mb-2">Manage your account</p>

      <div class="d-flex flex-column gap-2">
        <a href="/account" class="btn btn-sm btn-outline-dark w-100">
          <i class="fa fa-user me-1"></i> My Account
        </a>

      

   <button id="logoutBtn" class="btn btn-danger btn-sm w-100">
    <i class="fa fa-sign-out-alt me-1"></i> Logout
</button>

<!-- Hidden form -->
<form id="logoutForm" action="/logout" method="POST" class="d-none"></form>

</form>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.getElementById("logoutBtn")?.addEventListener("click", function (e) {
    e.preventDefault();

    Swal.fire({
        title: 'Logout?',
        text: 'Do you want to log out from your account?',
        icon: 'warning',
        width: '320px',
        padding: '0.8rem',
        showCancelButton: true,
        confirmButtonText: 'Logout',
        cancelButtonText: 'Cancel',
        buttonsStyling: false,
        customClass: {
            popup: 'rounded-3',
            confirmButton: 'btn btn-danger me-2',
            cancelButton: 'btn btn-secondary'
        }
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById("logoutForm").submit();
        }
    });
});
</script>



      </div>

    </div>
  <% } %>

</div>


       <a href="/cart" class="position-relative" style="color:#0b662e;">
        <i class="fas fa-shopping-cart fa-lg"></i>
        <span class="badge bg-warning text-dark position-absolute top-0 start-100 translate-middle">
          <%= cartCount || 0 %>
        </span>
      </a>
</div>
</div>

    </div>
  </div>
</header>


<div class="nav-bottom text-white small py-2" style="background:#1b683f;">
  <div class="container d-flex justify-content-between align-items-center">

    <!-- LEFT SIDE -->
    <div class="d-flex align-items-center gap-3">
      <i class="fas fa-truck"></i>
      Next Standard Delivery Today 6:00 PM-10:00 PM
    </div>

    <!-- RIGHT SIDE -->
    <div class="d-flex align-items-center gap-2">
      <i class="fas fa-map-marker-alt"></i>
      <span>Deliver to: Dubai Festival City - Dubai</span>
    </div>

  </div>
</div>


<!-- CATEGORIES BAR -->
<div class="categories-bar py-2">
  <div class="container d-flex align-items-center gap-4 flex-wrap">

    <!-- ALL CATEGORY DROPDOWN -->
    <div class="dropdown">
      <button class="btn btn-link text-dark fw-semibold dropdown-toggle p-0" type="button" data-bs-toggle="dropdown">
        All Category
      </button>
      <ul class="dropdown-menu">
        <% categories.forEach(cat => { %>
          <li><a class="dropdown-item" href="/category/<%= cat.slug %>"><%= cat.name %></a></li>
        <% }) %>
      </ul>
    </div>

    <!-- Dynamic Category List -->
    <div class="d-flex align-items-center gap-4 flex-wrap">
      <% categories.slice(0, 8).forEach(cat => { %>
        <a href="/category/<%= cat.slug %>" class="category-link text-dark">
          <%= cat.name %>
        </a>
      <% }) %>
    </div>

  </div>
</div>



  </header>

  <main class="main-container">

    <!-- BANNER CAROUSEL -->
    <% if (banners && banners.length > 0) { %>
      <section class="py-4">
        <div class="container">
          <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
              <% banners.forEach((banner, index) => { %>
                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                  <img
                    src="<%= banner.image %>"
                    class="d-block w-100 banner-carousel"
                    alt="<%= banner.title || 'Banner' %>"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              <% }) %>
            </div>

            <% if (banners.length > 1) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
            <% } %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- SHOP BY CATEGORY -->
    <% if (categories && categories.length > 0) { %>
      <section id="categories">
        <div class="container">
          <div class="section-title">Shop by Category</div>
          <div class="category-grid mt-4">
            <% categories.slice(0,8).forEach(cat => { %>
              <div class="category-card">
                <a href="/shop/<%= cat.slug %>">
                  <div class="category-img-wrap">
                    <!-- category.image assumed like "/uploads/categories/..." -->
                    <img src="<%= cat.image ? cat.image : '/placeholder.jpg' %>?v=<%= cat.updatedAt ? cat.updatedAt.getTime() : Date.now() %>" alt="<%= cat.name %>">
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- CATEGORY PREVIEWS (banner + fuller product cards) -->
    <% if (Array.isArray(categoriesWithPreview) && categoriesWithPreview.length) { %>
      <% categoriesWithPreview.slice(8, 13).forEach(({ category, previewProducts }) => { %>
        <section class="category-block">
          <div class="container">
            <!-- banner -->
            <div class="category-banner-wrap">
              <a href="/shop/<%= category.slug %>" class="banner-link" aria-label="Open <%= category.name %> category">
                <img
                  src="<%= category.banner_image ? category.banner_image : '/placeholder-banner.jpg' %>?v=<%= category.updatedAt ? category.updatedAt.getTime() : Date.now() %>"
                  alt="<%= category.name %> banner"
                  class="category-banner-img"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </div>

            <div class="category-header">
              <h2><%= category.name %></h2>
              <a class="view-all-btn" href="/shop/<%= category.slug %>">View All</a>
            </div>

            <div class="product-preview-grid mb-3">
              <% (previewProducts || []).forEach(product => { %>
                <div class="product-card">
                  <a href="/product/<%= product.slug %>">
                    <% 
                      // determine product image: product.images[0].filename OR product.image
                      var prodImg = (product.images && product.images.length) ? product.images[0].filename : (product.image || '/images/placeholder.png');
                    %>
                    <img src="<%= prodImg %>" alt="<%= product.name %>">

                    <h4><%= product.name %></h4>
                    <div class="price">₹ <%= product.price %>
                    
                    </div>

  <div class="d-flex align-items-center justify-content-end gap-5 mt-2">
  <!-- ADD BUTTON -->
  <form action="/cart/add" method="POST" class="d-inline">
    <input type="hidden" name="productId" value="<%= product.id %>">

    <button type="submit" 
            class="btn btn-success btn-sm px-3 py-2 d-flex align-items-center">
      <i class="fas fa-cart-plus me-2"></i>
      Add
    </button>
  </form>

  <!-- WISHLIST BUTTON -->
  <button class="btn btn-outline-dark btn-sm px-3 py-2 d-flex align-items-center">
    <i class="fas fa-heart me-2" style="font-size:14px;"></i>
    Wishlist
  </button>

</div>


                  </a>
                </div>
              <% }) %>
            </div>
          </div>
        </section>
      <% }) %>
    <% } %>

    <!-- FEATURED PRODUCTS -->
    <% if (featuredProducts && featuredProducts.length > 0) { %>
      <section id="products" class="py-5">
        <div class="container">
          <h3 class="mb-4 fw-bold text-center">Featured Products</h3>
          <div class="row">
            <% featuredProducts.slice(0, 4).forEach(function(prod) { %>
              <div class="col-md-3 mb-4">
                <div class="card featured-card">
                  <img src="<%= prod.image || '/images/placeholder.png' %>" alt="<%= prod.name %>">
                  <div>
                    <h6 class="fw-bold text-truncate"><%= prod.name %></h6>
                    <p class="text-muted small"><%= prod.description ? prod.description.substring(0,70) : '' %>...</p>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <span class="text-success fw-bold">₹ <%= prod.price %></span>
                      <span class="badge bg-<%= (prod.stock > 0) ? 'success' : 'danger' %>">
                        <%= (prod.stock > 0) ? 'In Stock' : 'Out Of Stock' %>
                      </span>
                    </div>
                    <div class="d-flex gap-2">
                      <a href="/product/<%= prod.slug %>" class="btn btn-sm btn-primary">View</a>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %> 

  </main>

  <!-- footer -->
  <footer class="mt-5">
    <div class="container"> <style>
      footer { background: #087030; padding: 40px 0; border-top: 1px solid #e0e0e0; }
      footer a { color: #ffffff; text-decoration: none; font-weight: bold; }
      footer a:hover { text-decoration: underline; }
    </style>
