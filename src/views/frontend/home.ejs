<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || "Savers Grocery" %></title>

  <!-- Bootstrap + icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    /* ---------- Reset & base ---------- */
    *{box-sizing:border-box;margin:0;padding:0}
    body,html{font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;background:#fff;color:#222}
    .container{max-width:1200px;margin:0 auto;padding:0 1rem}

    /* ---------- Top thin nav ---------- */
    .nav-bottom { background: linear-gradient(135deg,#087030 0%,#0e6424 100%); color:#fff; }
    .nav-bottom a{ color:rgba(255,255,255,0.95); text-decoration:none; font-size:0.95rem; }

    /* ---------- Header / search ---------- */
    header.site-header{ background:#fff; padding:12px 0; border-bottom:1px solid #eee; }
    .site-logo { font-weight:700; color:#0b662e; font-size:1.25rem; display:flex; align-items:center; gap:.5rem }
    .site-logo i{ color:#0b662e }

    form.search-form .form-select,
    form.search-form .form-control { height:40px; border-radius:6px; }

    /* ---------- HERO / BANNER CAROUSEL ---------- */
    .banner-carousel { height:250px; width:100%; object-fit:cover; border-radius:6px; display:block; }

    /* ---------- SHOP BY CATEGORY (cards like product) ---------- */
    #categories { padding:40px 0; background:#f7faf9; }
    #categories .section-title { text-align:center; font-size:28px; margin-bottom:20px; font-weight:700; }

    .category-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; align-items:stretch; }
    .category-card { background:#fff; border-radius:12px; box-shadow:0 8px 24px rgba(18,38,63,0.06); overflow:hidden; display:flex; flex-direction:column; }
    .category-card a{ display:block; color:inherit; text-decoration:none; height:100% }
    .category-img-wrap { height:290px; display:flex; align-items:center; justify-content:center; padding:14px; background:#fff }
    .category-img-wrap img { width:100%; height:100%; object-fit:cover; border-radius:8px; transition:transform .25s; }
    .category-card:hover .category-img-wrap img{ transform:scale(1.03) }

    /* hide small caption area to match "image-only" look */
    .category-card .card-body{ padding:10px; text-align:center; display:none; }

    /* ---------- Category Block (banner + product preview row) ---------- */
    .category-block{ margin:40px 0; padding:0 0 6px; }
    .category-banner-wrap{ width:100%; display:flex; justify-content:center; margin: 20px 0; padding:0 12px; }
    .category-banner-wrap .banner-link { display:block; width:100%; max-width:2000px; border-radius:8px; overflow:hidden; box-shadow:0 8px 30px rgba(15,40,60,0.06); }
    .category-banner-img { display:block; width:100%; height:200px; object-fit:cover; object-position:center; transition:transform .35s ease; }
    .category-banner-wrap .banner-link:hover .category-banner-img { transform: translateY(-2px) scale(1.01); }

    .category-header { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-top:12px; margin-bottom:8px; }
    .category-header h2 { color:#0b662e; font-weight:700; margin:0; font-size:20px; }
    .view-all-btn { color:#0b662e; text-decoration:none; font-weight:600; }

    /* ---------- PRODUCT PREVIEW GRID (fuller product cards) ---------- */
    .product-preview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 12px;
    }

    .product-card {
      background: #fff;
      border-radius: 12px;
      padding: 14px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
      transition: transform .18s ease, box-shadow .18s ease;
      display:flex;
      flex-direction:column;
      height:100%;
    }

    .product-card:hover { transform: translateY(-6px); box-shadow: 0 14px 34px rgba(0,0,0,0.10); }

    .product-card a { color:inherit; text-decoration:none; display:block; height:100%; }
    .product-card img { width:100%; height:170px; object-fit:contain; border-radius:8px; background:#fff; display:block; margin:0 auto; }
    .product-card h4 { font-size:1rem; margin:10px 0 6px; color:#333; height:44px; overflow:hidden; }
    .product-card .price { color:#087030; font-weight:700; font-size:1.05rem; margin-bottom:10px; }
    .actions { margin-top:auto; display:flex; gap:8px; align-items:center; justify-content:space-between; }
    .qty { width:60px; padding:6px; border-radius:6px; border:1px solid #ddd; text-align:center; }
    .add-to-cart { background:#087030; color:#fff; border:none; padding:8px 12px; border-radius:6px; cursor:pointer; }

    /* ---------- FEATURED PRODUCTS ---------- */
    #products { padding:40px 0; }
    .featured-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
    .featured-card{ background:#fff;border-radius:12px; box-shadow:0 8px 24px rgba(18,38,63,0.06); padding:12px; display:flex; flex-direction:column; gap:8px }
    .featured-card img{ width:100%; height:150px; object-fit:contain; border-radius:8px }
    .featured-card h6{ font-size:0.95rem; font-weight:700; color:#222; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
.login-btn:hover {
  color: #0b662e !important;
}

.dropdown-menu {
  margin-top: 8px !important;
}

    
    /* ---------- RESPONSIVE ---------- */
    @media (max-width:1199px){ .category-grid{ grid-template-columns:repeat(3,1fr) } .featured-grid{ grid-template-columns:repeat(3,1fr) } }
    @media (max-width: 900px){
      .category-grid{ grid-template-columns:repeat(2,1fr) }
      .product-preview-grid{ grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap:14px; }
      .category-banner-img{ height:220px; }
    }
    @media (max-width: 600px){
      .category-grid{ grid-template-columns:repeat(1,1fr) }
      .featured-grid{ grid-template-columns:repeat(2,1fr) }
      .category-banner-img{ height:160px; }
      .product-card img{ height:130px; }
    }
  </style>
</head>
<body>

  <!-- thin topbar -->
  <div class="nav-bottom text-white small py-2">
