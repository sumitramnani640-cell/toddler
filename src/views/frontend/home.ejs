        <option value="">All</option>
        <% if (Array.isArray(categories)) { %>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.slug || cat.id %>"><%= cat.name %></option>
          <% }) %>
        <% } %>
      </select>

      <input type="text" name="q" class="form-control" placeholder="Search products...">
      <button class="btn search-btn ms-2" type="submit" style="background:#fff;color:#02880d;border:none;">
        <i class="fas fa-search"></i>
      </button>
    </form>

    <!-- Cart (keeps static badge as in your original) -->
    <a href="/cart" class="text-black text-decoration-none position-relative">
