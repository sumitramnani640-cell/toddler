<body> <!-- ✅ AMAZON STYLE HEADER -->

<header class="text-white py-2" style="background:#ffffff;">

  <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
    <!-- Logo (static) -->
    <a href="/" class="text-black fw-bold fs-4 text-decoration-none d-flex align-items-center" style="background: linear-gradient(135deg, #087030 0%, #0e6424 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
      <i class="fas fa-shopping-cart me-2" style="background: linear-gradient(135deg, #087030 0%, #0e6424 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i> Savers Grocery
    </a>

    <!-- Search (only the category <select> is dynamic) -->
    <form class="d-flex flex-grow-1 mx-4" action="/search" method="GET" style="max-width:900px;">
      <select name="category" class="form-select w-auto me-2">
        <option value="">All</option>
        <% if (Array.isArray(categories)) { %>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.slug || cat.id %>"><%= cat.name %></option>
          <% }) %>
        <% } %>
      </select>

      <input type="text" name="q" class="form-control" placeholder="Search products...">
      <button class="btn search-btn ms-2" type="submit" style="background:#fff;color:#02880d;border:none;">
        <i class="fas fa-search"></i>
      </button>
    </form>

    <!-- Cart (keeps static badge as in your original) -->
    <a href="/cart" class="text-black text-decoration-none position-relative">
      <i class="fas fa-shopping-cart fa-lg"></i>
      <span class="badge rounded-pill bg-warning text-dark position-absolute top-0 start-100 translate-middle">0</span>
    </a>
  </div>
</header>

<!-- thin sub-nav (keeps static links) -->
<div class="nav-bottom text-white small py-2" style="background: linear-gradient(135deg, #087030 0%, #0e6424 100%);">
  <div class="container-fluid px-4 d-flex gap-4">
    <a href="# " class="text-white">Categories</a>
    <a href="#" class="text-white">Products</a>
    <a href="#" class="text-white">Contact</a>
  </div>
</div>


    <div class="main-container">
         <!-- ✅ BANNERS -->
        <% if (banners && banners.length> 0) { %> <section class="py-4">
                <div class="container">
                    <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            <% banners.forEach((banner, index)=> { %> <div
                                    class="carousel-item <%= index===0 ? 'active' : '' %>"> <img
                                        src="<%= banner.image %>" class="d-block w-100 banner-carousel" alt=""
                                        style="height: 300px; object-fit: cover; border-radius: 0;"> </div>
                                <% }) %>
                        </div>
                    </div>
                </div>
            </section>
            <% } %> <!-- ✅ CATEGORIES -->
<% if (categories && categories.length > 0) { %>
<section id="categories" class="py-5 bg-light">
  <div class="container">
    <h3 class="mb-4 fw-bold text-center">Shop by Category</h3>

    <div class="row">
      <% categories.slice(0,8).forEach(cat => { %>
        <div class="col-sm-6 col-md-3 mb-4">
          <div class="card category-card shadow-sm">
            <a href="/shop/<%= cat.slug %>" class="category-link d-block text-decoration-none text-reset">
              <!-- cover image -->
              <img
                src="/uploads/categories/<%= cat.image || 'placeholder.jpg' %>"
                alt="<%= cat.name %> category"
                class="card-img-top category-img"
                loading="lazy"
              >

              <div class="card-body text-center py-3">
                <h6 class="fw-bold mb-2"><%= cat.name %></h6>

                <!-- separate button (keeps proper semantics) -->
                <span class="d-inline-block">
                  <button type="button" class="btn btn-sm btn-warning view-more-btn" aria-label="View more <%= cat.name %>">
                    View More
                  </button>
                </span>
              </div>
            </a>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</section>
<% } %>


 <% categoriesWithPreview.slice(8, 13).forEach(({ category, previewProducts }) => { %>
  <section class="category-block">
    <div class="category-header">
      <h2><%= category.name %></h2>

      <a class="view-all-btn" href="/shop/<%= category.slug %>">View All</a>
    </div>
    <br>
    <br>

    <div class="product-preview-grid">
      <% previewProducts.forEach(product => { %>
        <div class="product-card">
          <a href="/product/<%= product.slug %>">
            <% if (product.images && product.images.length) { %>
              <img src="<%= product.images[0].filename %>" alt="<%= product.name %>">
            <% } else { %>
              <img src="/images/placeholder.png" alt="placeholder">
            <% } %>
            <h4><%= product.name %></h4>
            <div class="price">₹ <%= product.price %></div>
          </a>
        </div>
      <% }) %>
    </div>
  </section>
<% }) %>



                    <!-- ✅ FEATURED PRODUCTS -->
   <% if (featuredProducts && featuredProducts.length > 0) { %>
<section id="products" class="py-5">
  <div class="container">
    <h3 class="mb-4 fw-bold text-center">Featured Products</h3>
    <div class="row">
      <% featuredProducts.slice(0, 4).forEach(function(prod) { %>
        <div class="col-md-3 mb-4">
          <div class="card product-card shadow-sm">
            <img src="<%= prod.image %>" class="card-img-top" alt="<%= prod.name %>">
            <div class="card-body">
              <h6 class="fw-bold text-truncate"><%= prod.name %></h6>
              <p class="text-muted small"><%= prod.description ? prod.description.substring(0,50) : '' %>...</p>

              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-success fw-bold">$<%= prod.price %></span>
                <span class="badge bg-<%= (prod.stock > 0) ? 'success' : 'danger' %>">
                  <%= (prod.stock > 0) ? 'In Stock' : 'Out Of Stock' %>
                </span>
              </div>

              <div class="d-flex justify-content-between">
                <!-- Example Like button -->
                <button type="button"
                        class="btn btn-sm btn-outline-primary like-btn"
                        data-product-id="<%= prod.id %>">
                  <i class="bi bi-hand-thumbs-up"></i> <span class="like-text">Like</span>
                </button>

                <!-- Example View product -->
                <a href="/product/<%= prod.slug %>" class="btn btn-sm btn-primary">View</a>
              </div>

            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

            </div>
