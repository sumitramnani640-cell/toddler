<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title || 'Page - Saver Grocery' %></title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <style>
    /* ---------- Global ---------- */
    body {
      font-family: Arial, sans-serif;
      background: #fafafa;
      color: #333;
    }

    a { text-decoration: none; }


    /* ---------- CMS Page ---------- */
    .cms-wrapper {
      background:#fff;
      padding:25px;
      border-radius:8px;
      border:1px solid #eee;
      box-shadow:0 3px 6px rgba(0,0,0,0.04);
    }

    .cms-wrapper h1 {
      font-size:24px;
      font-weight:700;
      margin-bottom:15px;
      color:#0b662e;
      text-transform:uppercase;
    }

    .cms-content p {
      font-size:14px;
      line-height:1.7;
      margin-bottom:12px;
    }

    .cms-content ul,
    .cms-content ol {
      padding-left:20px;
      margin-bottom:12px;
    }

    .cms-content h2,
    .cms-content h3 {
      margin-top:15px;
      margin-bottom:8px;
      font-size:18px;
      font-weight:600;
    }

    /* ---------- Breadcrumb ---------- */
    .breadcrumb a { color:#000; }
  </style>
</head>
<body>

  <!-- HEADER -->
  <%- include("layouts/header") %>

  <!-- MAIN CONTENT -->
  <div class="container my-5">

    <!-- Breadcrumb -->
    <div class="mb-3">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item">
            <a href="/" style="color:#000000;border-radius:5px;text-decoration:none;">
              <i class="fa fa-home"></i> Home
            </a>
          </li>
          <li class="breadcrumb-item active" aria-current="page"><%= page.title %></li>
        </ol>
      </nav>
    </div>

    <!-- CMS CONTENT -->
    <div class="cms-wrapper">
      <h1><%= page.title %></h1>

    <div class="cms-content">
  <%- page.content.replace(/\n/g, '<br><br>') %>
</div>


    </div>

  </div>

  <!-- FOOTER -->
  <%- include("layouts/footer") %>

</body>
</html>
