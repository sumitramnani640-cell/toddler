<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'My Wishlist' %></title>

  <!-- Bootstrap + Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    .wishlist-table th, .wishlist-table td { vertical-align: middle; }
    .product-thumb { width:72px; height:72px; object-fit:cover; border-radius:6px; }
    .account-panel { border:1px solid #eee; border-radius:8px; padding:16px; background:#fff; }
    .account-panel a { display:block; padding:8px 0; color:#234d2f; text-decoration:none; }
    .account-panel a.active { font-weight:600; }
    @media (max-width:768px){ .product-thumb{ width:56px; height:56px } }
    /* ===== Wishlist Page ===== */

.wishlist-table {
  width: 100%;
  border-collapse: collapse;
}

.wishlist-table thead th {
  font-weight: 600;
  color: #111;
  border-bottom: 2px solid #e5e7eb;
  padding: 12px 8px;
}

.wishlist-table tbody tr {
  border-bottom: 1px solid #e5e7eb;
}

.wishlist-table tbody tr:last-child {
  border-bottom: none;
}

.wishlist-table td {
  padding: 14px 8px;
  vertical-align: middle;
}

/* ===== Product Cell ===== */
/* ===== Wishlist Product Row ===== */
.wishlist-table td .d-flex {
  align-items: center;
}

/* Product name link */
.wishlist-table td a.fw-semibold {
  font-size: 15px;
  font-weight: 600;
  color: #1f2937;           /* dark gray */
  text-decoration: none;
  line-height: 1.35;
  max-width: 240px;
  display: -webkit-box;
  -webkit-line-clamp: 2;    /* 2-line clamp */
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color 0.2s ease;
}

/* Hover effect */
.wishlist-table td a.fw-semibold:hover {
  color: #0b662e;           /* grocery green */
  text-decoration: underline;
}

/* Product image */
.product-thumb {
  width: 64px;
  height: 64px;
  object-fit: contain;
  border: 1px solid #eee;
  border-radius: 6px;
  background: #fff;
}

/* Mobile adjustments */
@media (max-width: 768px) {
  .wishlist-table td a.fw-semibold {
    font-size: 14px;
    max-width: 180px;
  }

  .product-thumb {
    width: 52px;
    height: 52px;
  }
}

.wishlist-product {
  display: flex;
  align-items: center;
  gap: 14px;
}

.wishlist-product img {
  width: 60px;
  height: 60px;
  object-fit: contain;
  border: 1px solid #eee;
  border-radius: 6px;
  background: #fff;
}

.wishlist-product a {
  font-weight: 500;
  color: #0d6efd;
  text-decoration: none;
}

.wishlist-product a:hover {
  text-decoration: underline;
}

/* ===== Mobile ===== */

@media (max-width: 768px) {
  .wishlist-table thead {
    display: none;
  }

  .wishlist-table tbody tr {
    display: block;
    padding: 10px 0;
  }

  .wishlist-table td {
    display: block;
    padding: 6px 0;
  }
}

  </style>
</head>

<body>

<%- include('layouts/header') %>

<div class="container py-4">

  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb bg-transparent p-0">
      <li class="breadcrumb-item"><a href="/"><i class="fa fa-home"></i></a></li>
      <li class="breadcrumb-item"><a href="/account">Account</a></li>
      <li class="breadcrumb-item active">My Wishlist</li>
    </ol>
  </nav>

  <div class="row g-4">

    <!-- LEFT -->
    <div class="col-lg-8">
      <h5 class="fw-bold mb-3">MY WISHLIST</h5>

      <% if (!wishlist?.items?.length) { %>
        <div class="alert alert-info">Your wishlist is empty.</div>
        <a href="/" class="btn btn-success">Continue Shopping</a>
      <% } else { %>

      <div class="table-responsive">
        <table class="table wishlist-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Stock</th>
              <th>Price</th>
              <th class="text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            <% wishlist.items.forEach(item => { const p = item.product; %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-3">
                    <img src="<%= p?.image ? '' + p.image : '/images/no-image.png' %>" class="product-thumb">
                    <a href="/product/<%= p.slug %>" class="fw-semibold"><%= p.name %></a>
                  </div>
                </td>

                <td><%= p.stock > 0 ? p.stock : 'Out of stock' %></td>
                <td>₹<%= Number(p.price).toFixed(2) %></td>

                <td class="text-center">
                  <form action="/cart/add" method="POST" class="d-inline">
                    <input type="hidden" name="productId" value="<%= p.id %>">
                    <button class="btn btn-success btn-sm" <%= p.stock <= 0 ? 'disabled' : '' %>>
                      <i class="fas fa-cart-plus"></i>
                    </button>
                  </form>

                  <form action="/wishlist/remove" method="POST" class="d-inline ms-1">
                    <input type="hidden" name="productId" value="<%= p.id %>">
                    <button class="btn btn-outline-danger btn-sm">
                      <i class="fas fa-times"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <form action="/wishlist/clear" method="POST" class="text-end">
        <button class="btn btn-outline-danger">Clear Wishlist</button>
      </form>

      <% } %>
    </div>

    <!-- RIGHT -->
    <div class="col-lg-4">
      <div class="account-panel">
        <div class="fw-semibold mb-3">
          <i class="fas fa-user me-1"></i> <%= user?.name || 'My Account' %>
        </div>
        <hr>
        <a href="/account">Account</a>
        <a href="/order-history">Order History</a>
        <a href="/account/newsletter">Newsletter</a>
        <hr>
        <button id="logoutBtn" class="btn btn-danger w-100">Logout</button>
      </div>
    </div>

  </div>
</div>

<form id="logoutForm" action="/logout" method="POST"></form>

<%- include('layouts/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.getElementById('logoutBtn')?.addEventListener('click', e => {
  e.preventDefault();
  Swal.fire({
    title: 'Logout?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Logout'
  }).then(r => r.isConfirmed && logoutForm.submit());
});
</script>

</body>
</html>
