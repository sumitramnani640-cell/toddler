<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || "My Wishlist" %></title>

  <!-- Bootstrap + Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    /* concise wishlist styles */
    .wishlist-table th, .wishlist-table td { vertical-align: middle; }
    .product-thumb { width:72px; height:72px; object-fit:cover; border-radius:6px; }
    .action-btns .btn { margin-left:6px; }
    .account-panel { border:1px solid #eee; border-radius:8px; padding:16px; background:#fff; }
    .account-panel a { display:block; padding:8px 0; color:#234d2f; text-decoration:none; }
    .account-panel a.active { font-weight:600; }
    @media (max-width: 768px){ .product-thumb{ width:56px; height:56px } }

    
/* ===== Wishlist Breadcrumb Styling ===== */

.container.py-4 {
  padding-top: 2rem !important;
  padding-bottom: 2rem !important;
}

.breadcrumb {
  background: transparent;
  padding: 0;
  margin-bottom: 0;
  font-size: 0.95rem;
}

.breadcrumb-item a {
  color: #444;
  text-decoration: none;
  transition: 0.2s;
}

.breadcrumb-item a:hover {
  color: #000;
}

.breadcrumb-item + .breadcrumb-item::before {
  color: #888; /* separator color */
}

.fa-home {
  font-size: 1rem;
  color: #444;
}

.breadcrumb .active {
  font-weight: 600;
  color: #222 !important;
}

/* Optional: subtle underline animation */
.breadcrumb-item a {
  position: relative;
}
.breadcrumb-item a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 0;
  height: 1px;
  background: #222;
  transition: width 0.2s;
}
.breadcrumb-item a:hover::after {
  width: 100%;
}


  </style>
</head>
<body>

  <!-- header -->
  <%- include("layouts/header") %>

  <div class="container py-4">
    <div class="row">
      <!-- breadcrumb -->
      <div class="col-12 mb-3">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb bg-transparent p-0 mb-0">
        <li class="breadcrumb-item"><a href="/"><i class="fa fa-home"></i></a></li>
        <!-- <li class="breadcrumb-item active">Account</li> -->
            <li class="breadcrumb-item"><a href="/account">Account</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Wishlist</li>
          </ol>
        </nav>
      </div>
    </div>

    <div class="row g-4">
      <!-- LEFT: wishlist content -->
      <div class="col-lg-8">
        <h5 class="fw-bold mb-3">MY WISHLIST</h5>

        <% if (!wishlist || !Array.isArray(wishlist.items) || wishlist.items.length === 0) { %>
          <div class="alert alert-info">You don't have any items in your wishlist.</div>
          <a href="/" class="btn btn-success">Continue shopping</a>
        <% } else { %>

          <div class="table-responsive">
            <table class="table wishlist-table align-middle">
              <thead>
                <tr>
                  <th>Product Name</th>
                  <th>Model</th>
                  <th>Stock</th>
                  <th>Unit Price</th>
                  <th class="text-center">Action</th>
                </tr>
              </thead>
              <tbody>
                <% wishlist.items.forEach(function(item){ %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <img src="<%= item.imageUrl || '/images/no-image.png' %>" alt="<%= item.name %>" class="product-thumb">
                        <div>
                          <a href="/product/<%= item.slug || item.productId %>" class="fw-semibold"><%= item.name %></a>
                          <% if (item.sku) { %><div class="small text-muted">SKU: <%= item.sku %></div><% } %>
                        </div>
                      </div>
                    </td>

                    <td><%= item.model || item.model_no || '-' %></td>

                    <td><% if (typeof item.stock === 'number') { %>
                        <%= item.stock > 0 ? item.stock : 'Out of stock' %>
                      <% } else { %>-<% } %></td>

                    <td>AED <%= (Number(item.price) || 0).toFixed(2) %></td>

                    <td class="text-center">
                      <div class="d-flex justify-content-center action-btns">
                        <!-- Add to cart form -->
                        <form action="/wishlist/add-to-cart" method="POST" style="display:inline-block;">
                          <input type="hidden" name="productId" value="<%= item.productId %>">
                          <input type="hidden" name="qty" value="1">
                          <button class="btn btn-success btn-sm" title="Add to cart" <% if (item.stock <= 0) { %> disabled <% } %>>
                            <i class="fas fa-shopping-cart"></i>
                          </button>
                        </form>

                        <!-- Remove from wishlist -->
                        <form action="/wishlist/remove" method="POST" style="display:inline-block; margin-left:6px;">
                          <input type="hidden" name="productId" value="<%= item.productId %>">
                          <button class="btn btn-outline-danger btn-sm" title="Remove">
                            <i class="fas fa-times"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-3">
            <a href="/" class="btn btn-secondary">Continue</a>

            <form action="/wishlist/clear" method="POST" onsubmit="return confirm('Remove all items from wishlist?');">
              <button class="btn btn-outline-danger">Clear wishlist</button>
            </form>
          </div>
        <% } %>
      </div>

      <!-- RIGHT: account sidebar -->
      <div class="col-lg-4">
        <div class="account-panel">
          <div class="d-flex align-items-center mb-3">
            <i class="fas fa-user-circle fa-2x me-2"></i>
            <div>
              <div class="small-muted">ACCOUNT</div>
              <div class="fw-semibold"><%= user && user.name ? user.name : 'My Account' %></div>
            </div>
          </div>

          <hr>

          <nav>
          <a href="/account" class="<%= (activePage === 'account') ? 'active' : '' %>">Account</a>
            <!-- <a href="/account/edit" class="<%= (activePage === 'edit') ? 'active' : '' %>">Edit Account</a>
            <a href="/account/password" class="<%= (activePage === 'password') ? 'active' : '' %>">Password</a>
            <a href="/account/preorder" class="<%= (activePage === 'preorder') ? 'active' : '' %>">Pre-Order</a>
            <a href="/account/address" class="<%= (activePage === 'address') ? 'active' : '' %>">Address Book</a> -->
          <!-- </nav> -->

          <!-- <hr> -->

          <!-- <div class="small text-muted mb-2">MY ORDERS</div> -->
          <!-- <nav> -->
            <a href="/order-history">Order History</a>
          </nav>

          <!-- <hr> -->

          <!-- <div class="small text-muted mb-2">MY STUFF</div>
          <nav> -->

            <a href="/account/newsletter">Newsletter</a>
          </nav>

          <hr>

        <button id="logoutBtn" class="btn btn-danger w-100">
              <i class="fa fa-sign-out-alt me-1"></i> Logout
            </button>
        </div>
      </div>
    </div>
  </div>

  <!-- footer -->
  <%- include("layouts/footer") %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>



<form id="logoutForm" action="/logout" method="POST" class="d-none"></form>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    (function() {
      function showLogoutConfirm() {
        return Swal.fire({
          title: 'Logout?',
          text: 'Do you want to log out from your account?',
          icon: 'warning',
          width: '320px',
          padding: '0.9rem',
          showCancelButton: true,
          confirmButtonText: 'Logout',
          cancelButtonText: 'Cancel',
          background: '#fff',
          buttonsStyling: false,
          customClass: {
            popup: 'rounded-3',
            confirmButton: 'btn btn-danger me-2',
            cancelButton: 'btn btn-secondary'
          }
        });
      }

      const topBtn = document.getElementById('logoutTriggerTop');
      if (topBtn) {
        topBtn.addEventListener('click', function(e) {
          e.preventDefault();
          showLogoutConfirm().then(res => {
            if (res.isConfirmed) document.getElementById('logoutForm').submit();
          });
        });
      }

      const sideBtn = document.getElementById('logoutBtn');
      if (sideBtn) {
        sideBtn.addEventListener('click', function(e) {
          e.preventDefault();
          showLogoutConfirm().then(res => {
            if (res.isConfirmed) document.getElementById('logoutForm').submit();
          });
        });
      }
    })();
  </script>