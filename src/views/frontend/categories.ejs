<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= category.name %> - Savers Grocery</title>

  <!-- Libraries -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/frontend/css/style.css">

  <style>
    /* Sidebar styles */
    .page-with-sidebar {
      min-height: calc(100vh - 160px); /* header + footer space */
    }
    .sidebar {
      min-height: 500px;
      border-right: 1px solid #e9ecef;
      padding-top: 10px;
    }
    .sidebar .list-group-item {
      border: none;
      padding-left: 0;
      padding-right: 0;
    }
    .sidebar .list-group-item.active {
      background-color: transparent;
      color: #198754;
      font-weight: 600;
    }
    /* Product card tweaks */
    .card-img-top {
      height: 160px;
      object-fit: contain;
      padding: 16px;
      background: #fff;
    }

    /* keep the existing inline tweaks */
    .top-bar, .sub-bar { background-color: #2f8a4a; }
    .main-header .btn-success { background-color: #198754; border-color: #198754; }
    .category-nav .nav-link { color: #000; font-weight: 500; }
    .category-nav .nav-link:hover { color: #198754; }

    /* Responsive: sticky sidebar on larger screens */
    @media (min-width: 768px) {
      .sidebar {
        position: sticky;
        top: 90px; /* below header */
      }
    }
  </style>
</head>
<body>

  <!-- ✅ HEADER START -->
  <header>
    <!-- Top green info bar -->
    <div class="top-bar bg-success text-white small">
      <div class="container d-flex align-items-center justify-content-between py-1">
        <div class="d-flex align-items-center gap-3">
          <div><i class="fas fa-shipping-fast me-2"></i> Fast &amp; Free Delivery</div>
          <div class="d-none d-md-flex align-items-center">
            <i class="fas fa-store me-2"></i> Shop from over thousand products
          </div>
        </div>
        <div class="d-flex align-items-center gap-3">
          <div class="d-none d-md-flex align-items-center">
            <i class="fas fa-phone me-2"></i>
            <a href="tel:+971542526215" class="text-white text-decoration-none">+971-542526215</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Main header: logo, search, CTAs -->
    <div class="main-header bg-white border-bottom">
      <div class="container d-flex align-items-center justify-content-between py-3">
        <!-- Logo + menu -->
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-light d-md-none" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-label="Toggle menu">
            <i class="fas fa-bars"></i>
          </button>
          <a href="/" class="text-black fw-bold fs-4 text-decoration-none d-flex align-items-center">
            <i class="fas fa-shopping-cart me-2"></i> Savers Grocery
          </a>
        </div>

        <!-- Search bar -->
        <div class="flex-fill px-3 d-none d-md-block">
          <form action="/search" method="GET" class="d-flex">
            <input name="q" class="form-control me-2" type="search" placeholder="Search Products">
            <button class="btn btn-success" type="submit"><i class="fas fa-search"></i></button>
          </form>
        </div>

        <!-- Buttons / actions -->
        <div class="d-flex align-items-center gap-2">
          <a href="/login" class="d-flex align-items-center text-decoration-none text-dark">
            <i class="fas fa-user-circle fs-5 me-1"></i>
            <span class="d-none d-lg-inline">Login &amp; Register</span>
          </a>

          <a href="/cart" class="btn btn-outline-secondary position-relative" aria-label="Cart">
            <i class="fas fa-shopping-cart"></i>
            <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
          </a>
        </div>
      </div>

      <!-- Mobile search -->
      <div class="container d-md-none py-2">
        <form action="/search" method="GET" class="d-flex">
          <input name="q" class="form-control me-2" type="search" placeholder="Search Products">
          <button class="btn btn-success" type="submit"><i class="fas fa-search"></i></button>
        </form>
      </div>
    </div>

    <!-- Delivery info bar -->
    <div class="sub-bar bg-success text-white small">
      <div class="container d-flex align-items-center justify-content-between py-1">
        <div><i class="fas fa-clock me-2"></i> Next Standard Delivery Today <strong>6:00 PM–10:00 PM</strong></div>
        <div><i class="fas fa-map-marker-alt me-1"></i> Deliver to: <strong>Dubai Festival City – Dubai</strong></div>
      </div>
    </div>
  </header>
  <!-- ✅ HEADER END -->

  <!-- PAGE CONTENT WITH SIDEBAR -->
  <div class="container page-with-sidebar py-4">
    <div class="row">
      <!-- SIDEBAR: visible md+ ; on small screens we'll use an offcanvas to show categories -->
      <aside class="col-md-3 d-none d-md-block sidebar">
        <div class="mb-3">
          <h5 class="fw-bold mb-3"><i class="fas fa-list me-2"></i> Categories</h5>

          <div class="list-group">
            <a href="/" class="list-group-item list-group-item-action d-flex align-items-center">
              <i class="fas fa-home me-2 text-muted"></i> Home
            </a>

            <!-- category breadcrumb / current -->
            <div class="list-group-item d-flex align-items-center">
              <i class="fas fa-angle-right me-2 text-muted"></i>
              <strong><%= category.name %></strong>
            </div>

            <% if (typeof categories !== 'undefined') { %>
              <% categories.forEach(cat => { %>
                <a href="/shop/<%= cat.slug %>" class="list-group-item list-group-item-action d-flex align-items-center">
                  <span class="flex-fill"><%= cat.name %></span>
                </a>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- optional filters or info -->
        <!-- <div class="mt-4">
          <h6>Filter</h6>
        </div> -->
      </aside>

      <!-- MAIN: products -->
      <main class="col-md-9 col-12">
        <!-- On small screens show a compact category bar + offcanvas toggle -->
        <div class="d-flex d-md-none align-items-center justify-content-between mb-3">
          <div>
            <button class="btn btn-outline-secondary" data-bs-toggle="offcanvas" data-bs-target="#categoriesOffcanvas">
              <i class="fas fa-list me-1"></i> Categories
            </button>
          </div>
          <div class="text-muted small align-self-center">
            <strong><%= category.name %></strong>
          </div>
        </div>

        <!-- Products grid -->
<div class="row justify-content-start g-3">
  <% if (products && products.length > 0) { %>
    <% products.slice(0, 15).forEach(product => { %>
      <div class="col-lg-4 col-md-6 col-sm-6 col-12 d-flex justify-content-center">
        <div class="card shadow-sm text-center" style="width: 300px; border-radius: 10px; height: 420px;">
          <img src="<%= product.image || 'placeholder.jpg' %>"  
               class="card-img-top" 
               alt="<%= product.name %>" 
               style="height:300px; object-fit: contain; padding:10px;">
          <div class="card-body p-2">
            <h6 class="fw-semibold text-truncate mb-1" title="<%= product.name %>"><%= product.name %></h6>
            <p class="text-success fw-bold mb-2">₹<%= product.price %></p>
            <a href="/product/<%= product.id %>" class="btn btn-dark btn-sm w-100">View Product</a>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="col-12 text-center">
      <h5 class="text-muted py-5">No products found in this category</h5>
    </div>
  <% } %>
</div>



        <!-- Simple pagination placeholder if you want to implement server-side pages -->
        <!-- Replace with actual pagination logic from your server -->
        <% if (products && products.length > 15) { %>
          <nav class="mt-4" aria-label="Products pagination">
            <ul class="pagination justify-content-center">
              <li class="page-item disabled"><a class="page-link">Previous</a></li>
              <li class="page-item active"><a class="page-link">1</a></li>
              <li class="page-item"><a class="page-link">2</a></li>
              <li class="page-item"><a class="page-link">Next</a></li>
            </ul>
          </nav>
        <% } %>
      </main>
    </div>
  </div>

  <!-- OFFCANVAS: categories for mobile -->
  <div class="offcanvas offcanvas-start" tabindex="-1" id="categoriesOffcanvas">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title">Categories</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
      <ul class="list-unstyled">
        <li><a href="/" class="d-block py-2 text-dark"><i class="fas fa-home me-2"></i> Home</a></li>
        <li class="py-2"><strong><i class="fas fa-angle-right me-2"></i><%= category.name %></strong></li>
        <% if (typeof categories !== 'undefined') { %>
          <% categories.forEach(cat => { %>
            <li><a href="/shop/<%= cat.slug %>" class="d-block py-2 text-dark"><%= cat.name %></a></li>
          <% }) %>
        <% } %>
      </ul>
    </div>
  </div>

  <!-- Offcanvas mobile menu (existing) -->
  <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title">Menu</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
      <ul class="list-unstyled">
        <li><a href="/" class="d-block py-2 text-dark">Home</a></li>
        <% if (typeof categories !== 'undefined') { %>
          <% categories.forEach(cat => { %>
            <li><a href="/shop/<%= cat.slug %>" class="d-block py-2 text-dark"><%= cat.name %></a></li>
          <% }) %>
        <% } %>
      </ul>
    </div>
  </div>

  <!-- ✅ FOOTER -->
  <footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="m-0">© 2025 Savers Grocery. All Rights Reserved.</p>
  </footer>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
