<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= category.name %> - Savers Grocery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/frontend/css/style.css">

</head>
<body>
    <!-- ✅ HEADER START -->
    <header class="bg-dark text-white py-3">
        <div class="container d-flex justify-content-between">
            <h4 class="m-0">Savers Grocery</h4>

            <nav>
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/">Home</a>
                    </li>
                    <% if (typeof categories !== 'undefined') { %>
                        <% categories.forEach(cat => { %>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/shop/<%= cat.slug %>"><%= cat.name %></a>
                            </li>
                        <% }) %>
                    <% } %>
                </ul>
            </nav>
        </div>
    </header>
    <!-- ✅ HEADER END -->
    <div class="container py-4">

        <h3 class="mb-4 fw-bold text-dark"><%= category.name %></h3>

        <div class="row g-4">

            <% if(products && products.length > 0) { %>
                <% products.forEach(product => { %>

                <div class="col-md-3 col-6">
                    <div class="card shadow-sm h-100">
                        <img src="/uploads/products/<%= product.image || 'placeholder.jpg' %>" 
                             class="card-img-top" 
                             alt="<%= product.name %>">

                        <div class="card-body text-center">
                            <h6 class="fw-bold text-truncate"><%= product.name %></h6>
                            <p class="text-success fw-bold">₹<%= product.price %></p>
                            

                            <a href="/product/<%= product.slug %>" class="btn btn-dark btn-sm w-100">
                                View Product
                            </a>
                        </div>
                    </div>
                </div>

                <% }) %>
            <% } else { %>
                <div class="col-12 text-center">
                    <h5 class="text-muted py-5">No products found in this category</h5>
                </div>
            <% } %>
        </div>
    </div>

    <!-- ✅ FOOTER START -->
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p class="m-0">© 2025 Savers Grocery. All Rights Reserved.</p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 