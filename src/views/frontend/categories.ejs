<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= category && category.name ? category.name : 'Category' %> - Savers Grocery</title>

  <!-- Libraries -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/frontend/css/style.css">

  <style>
    /* Sidebar styles */
    .page-with-sidebar {
      min-height: calc(100vh - 160px); /* header + footer space */
    }
    .sidebar {
      min-height: 500px;
      border-right: 1px solid #e9ecef;
      padding-top: 10px;
    }
    .sidebar .list-group-item {
      border: none;
      padding-left: 0;
      padding-right: 0;
    }
    .sidebar .list-group-item.active {
      background-color: transparent;
      color: #198754;
      font-weight: 600;
    }
    /* Product card tweaks */
    .card-img-top {
      height: 160px;
      object-fit: contain;
      padding: 16px;
      background: #fff;
    }

    /* keep the existing inline tweaks */
    .top-bar, .sub-bar { background-color: #2f8a4a; }
    .main-header .btn-success { background-color: #198754; border-color: #198754; }
    .category-nav .nav-link { color: #000; font-weight: 500; }
    .category-nav .nav-link:hover { color: #198754; }

    /* Responsive: sticky sidebar on larger screens */
    @media (min-width: 768px) {
      .sidebar {
        position: sticky;
        top: 90px; /* below header */
      }
    }
  </style>
</head>
<body>

<%- include("layouts/header") %>

  <!-- PAGE CONTENT WITH SIDEBAR -->
  <div class="container page-with-sidebar py-4">
    <div class="row">
      <!-- SIDEBAR: visible md+ ; on small screens we'll use an offcanvas to show categories -->
      <aside class="col-md-3 d-none d-md-block sidebar" aria-label="Categories">
        <div class="mb-3">
          <h5 class="fw-bold mb-3"><i class="fas fa-list me-2"></i> Categories</h5>

          <div class="list-group">
            <a href="/" class="list-group-item list-group-item-action d-flex align-items-center">
              <i class="fas fa-home me-2 text-muted"></i> Home
            </a>

            <!-- category breadcrumb / current -->
            <div class="list-group-item d-flex align-items-center" aria-current="true">
              <i class="fas fa-angle-right me-2 text-muted"></i>
              <strong><%= category && category.name ? category.name : 'Category' %></strong>
            </div>

            <% if (typeof categories !== 'undefined') { %>
              <% categories.forEach(cat => { %>
                <a href="/shop/<%= cat.slug %>" class="list-group-item list-group-item-action d-flex align-items-center">
                  <span class="flex-fill"><%= cat.name %></span>
                </a>
              <% }) %>
            <% } %>
          </div>
        </div>
      </aside>

      <!-- MAIN: products -->
      <main class="col-md-9 col-12" aria-label="Products">
        <!-- On small screens show a compact category bar + offcanvas toggle -->
        <div class="d-flex d-md-none align-items-center justify-content-between mb-3">
          <div>
            <button class="btn btn-outline-secondary" data-bs-toggle="offcanvas" data-bs-target="#categoriesOffcanvas" aria-controls="categoriesOffcanvas">
              <i class="fas fa-list me-1"></i> Categories
            </button>
          </div>
          <div class="text-muted small align-self-center">
            <strong><%= category && category.name ? category.name : 'Category' %></strong>
          </div>
        </div>

      <!-- Products grid -->
<div class="row justify-content-start g-3">
  <% if (products && products.length > 0) { %>

    <% products.slice(0, 15).forEach(product => { 
         const prodSlug = product.slug || product.id;
         const prodImg = product.imageUrl || product.image || '/images/no-image.png';
         const prodName = (product.name || 'Product').replace(/"/g, '&quot;');
    %>

      <div class="col-lg-4 col-md-6 col-sm-6 col-12 d-flex justify-content-center">

        <!-- 🔥 Entire card clickable -->
        <a href="/product/<%= prodSlug %>" 
           class="text-decoration-none text-dark w-100"
           style="max-width:300px;"
        >

          <div class="card shadow-sm text-center position-relative"
               style="width: 100%; border-radius: 10px; height: 420px;">


 
            <!-- Product Image -->
            <img 
              src="<%= product.image || 'placeholder.jpg' %>"  
              class="card-img-top"
              alt="<%= prodName %>"
              loading="lazy"
              onerror="this.onerror=null;this.src='/images/no-image.png';"
              style="height:300px; object-fit:contain; padding:10px;"
            >

            <div class="card-body p-2 d-flex flex-column">

              <!-- Name -->
              <h6 class="fw-semibold text-truncate mb-1" title="<%= prodName %>">
                <%= prodName %>
              </h6>

              <!-- Price -->
              <p class="text-success fw-bold mb-2">
                ₹<%= Number(product.price || 0).toFixed(2) %>
              </p>

              <!-- 🟢 Add to Cart button (does NOT trigger card link) -->
               <div class="d-flex align-items-center justify-content-end gap-5 mt-2">
  <!-- ADD BUTTON -->
  <form action="/cart/add" method="POST" class="d-inline">
    <input type="hidden" name="productId" value="<%= product.id %>">

    <button type="submit" 
            class="btn btn-success btn-sm px-3 py-2 d-flex align-items-center">
      <i class="fas fa-cart-plus me-2"></i>
      Add
    </button>
  </form>

  <!-- WISHLIST BUTTON -->
  <button class="btn btn-outline-dark btn-sm px-3 py-2 d-flex align-items-center">
    <i class="fas fa-heart me-2" style="font-size:14px;"></i>
    Wishlist
  </button>

</div>

            </div>
          </div>

        </a>
      </div>

    <% }) %>

  <% } else { %>
    <div class="col-12 text-center">
      <h5 class="text-muted py-5">No products found in this category</h5>
    </div>
  <% } %>
</div>


        <!-- Simple pagination placeholder if you want to implement server-side pages -->
        <% if (products && products.length > 15) { %>
          <nav class="mt-4" aria-label="Products pagination">
            <ul class="pagination justify-content-center">
              <li class="page-item disabled"><a class="page-link">Previous</a></li>
              <li class="page-item active"><a class="page-link">1</a></li>
              <li class="page-item"><a class="page-link">2</a></li>
              <li class="page-item"><a class="page-link">Next</a></li>
            </ul>
          </nav>
        <% } %>
      </main>
    </div>
  </div>

  <!-- OFFCANVAS: categories for mobile -->
  <div class="offcanvas offcanvas-start" tabindex="-1" id="categoriesOffcanvas" aria-labelledby="categoriesOffcanvasLabel">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title" id="categoriesOffcanvasLabel">Categories</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <ul class="list-unstyled">
        <li><a href="/" class="d-block py-2 text-dark"><i class="fas fa-home me-2"></i> Home</a></li>
        <li class="py-2"><strong><i class="fas fa-angle-right me-2"></i><%= category && category.name ? category.name : 'Category' %></strong></li>
        <% if (typeof categories !== 'undefined') { %>
          <% categories.forEach(cat => { %>
            <li><a href="/shop/<%= cat.slug %>" class="d-block py-2 text-dark"><%= cat.name %></a></li>
          <% }) %>
        <% } %>
      </ul>
    </div>
  </div>

  <!-- Offcanvas mobile menu (existing) -->
  <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title" id="mobileMenuLabel">Menu</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <ul class="list-unstyled">
        <li><a href="/" class="d-block py-2 text-dark">Home</a></li>
        <% if (typeof categories !== 'undefined') { %>
          <% categories.forEach(cat => { %>
            <li><a href="/shop/<%= cat.slug %>" class="d-block py-2 text-dark"><%= cat.name %></a></li>
          <% }) %>
        <% } %>
      </ul>
    </div>
  </div>

<%- include("layouts/footer") %>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Set cart count from server-provided local (if available) or fallback to localStorage
    (function() {
      // server can set: res.locals.cartCount = <number>
      var serverCartCount = <%= typeof cartCount !== 'undefined' ? Number(cartCount) : 'null'%>;
      var badge = document.getElementById('cart-count');

      if (serverCartCount !== null) {
        badge.textContent = serverCartCount;
      } else {
        try {
          var stored = localStorage.getItem('cart');
          if (stored) {
            var cart = JSON.parse(stored);
            var total = Array.isArray(cart) ? cart.reduce(function(s, it){ return s + (Number(it.quantity || 0)); }, 0) : 0;
            badge.textContent = total;
          }
        } catch (e) {
          // ignore JSON errors
        }
      }
    })();
  </script>
</body>
</html>
