<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || "Savers Grocery" %></title>

  <!-- Bootstrap + icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    /* ---------- Reset & base ---------- */
    *{box-sizing:border-box;margin:0;padding:0}
    body,html{font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;background:#fff;color:#222}
    .container{max-width:1200px;margin:0 auto;padding:0 1rem}

    /* ---------- Top thin nav ---------- */
    .nav-bottom { background: linear-gradient(135deg,#087030 0%,#0e6424 100%); color:#fff; }
    .nav-bottom a{ color:rgba(255,255,255,0.95); text-decoration:none; font-size:0.95rem; }

    /* ---------- Header / search ---------- */
    header.site-header{ background:#fff; padding:12px 0; border-bottom:1px solid #eee; }
    .site-logo { font-weight:700; color:#0b662e; font-size:1.25rem; display:flex; align-items:center; gap:.5rem }
    .site-logo i{ color:#0b662e }

    form.search-form .form-select,
    form.search-form .form-control { height:40px; border-radius:6px; }

    /* ---------- HERO / BANNER CAROUSEL ---------- */
    .banner-carousel { height:250px; width:100%; object-fit:cover; border-radius:6px; display:block; }

    /* ---------- SHOP BY CATEGORY (cards like product) ---------- */
    #categories { padding:40px 0; background:#f7faf9; }
    #categories .section-title { text-align:center; font-size:28px; margin-bottom:20px; font-weight:700; }

    .category-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; align-items:stretch; }
    .category-card { background:#fff; border-radius:12px; box-shadow:0 8px 24px rgba(18,38,63,0.06); overflow:hidden; display:flex; flex-direction:column; }
    .category-card a{ display:block; color:inherit; text-decoration:none; height:100% }
    .category-img-wrap { height:290px; display:flex; align-items:center; justify-content:center; padding:14px; background:#fff }
    .category-img-wrap img { width:100%; height:100%; object-fit:cover; border-radius:8px; transition:transform .25s; }
    .category-card:hover .category-img-wrap img{ transform:scale(1.03) }

    /* hide small caption area to match "image-only" look */
    .category-card .card-body{ padding:10px; text-align:center; display:none; }

    /* ---------- Category Block (banner + product preview row) ---------- */
    .category-block{ margin:40px 0; padding:0 0 6px; }
    .category-banner-wrap{ width:100%; display:flex; justify-content:center; margin: 20px 0; padding:0 12px; }
    .category-banner-wrap .banner-link { display:block; width:100%; max-width:2000px; border-radius:8px; overflow:hidden; box-shadow:0 8px 30px rgba(15,40,60,0.06); }
    .category-banner-img { display:block; width:100%; height:200px; object-fit:cover; object-position:center; transition:transform .35s ease; }
    .category-banner-wrap .banner-link:hover .category-banner-img { transform: translateY(-2px) scale(1.01); }

    .category-header { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-top:12px; margin-bottom:8px; }
    .category-header h2 { color:#0b662e; font-weight:700; margin:0; font-size:20px; }
    .view-all-btn { color:#0b662e; text-decoration:none; font-weight:600; }

    /* ---------- PRODUCT PREVIEW GRID (fuller product cards) ---------- */
    .product-preview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 12px;
    }

    .product-card {
      background: #fff;
      border-radius: 12px;
      padding: 14px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
      transition: transform .18s ease, box-shadow .18s ease;
      display:flex;
      flex-direction:column;
      height:100%;
    }

    .product-card:hover { transform: translateY(-6px); box-shadow: 0 14px 34px rgba(0,0,0,0.10); }

    .product-card a { color:inherit; text-decoration:none; display:block; height:100%; }
    .product-card img { width:100%; height:170px; object-fit:contain; border-radius:8px; background:#fff; display:block; margin:0 auto; }
    .product-card h4 { font-size:1rem; margin:10px 0 6px; color:#333; height:44px; overflow:hidden; }
    .product-card .price { color:#087030; font-weight:700; font-size:1.05rem; margin-bottom:10px; }
    .actions { margin-top:auto; display:flex; gap:8px; align-items:center; justify-content:space-between; }
    .qty { width:60px; padding:6px; border-radius:6px; border:1px solid #ddd; text-align:center; }
    .add-to-cart { background:#087030; color:#fff; border:none; padding:8px 12px; border-radius:6px; cursor:pointer; }

    /* ---------- FEATURED PRODUCTS ---------- */
    #products { padding:40px 0; }
    .featured-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
    .featured-card{ background:#fff;border-radius:12px; box-shadow:0 8px 24px rgba(18,38,63,0.06); padding:12px; display:flex; flex-direction:column; gap:8px }
    .featured-card img{ width:100%; height:150px; object-fit:contain; border-radius:8px }
    .featured-card h6{ font-size:0.95rem; font-weight:700; color:#222; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
.login-btn:hover {
  color: #0b662e !important;
}

.dropdown-menu {
  margin-top: 8px !important;
}

/* ---------- ACCOUNT / EDIT PAGE styles ---------- */
.btn-green {
  background-color: #0b662e;
  border-color: #0b662e;
  color: #fff;
  padding: 8px 20px;
  border-radius: 6px;
}
.btn-green:hover {
  background-color: #087030;
  border-color: #087030;
  color: #fff;
}
.form-label { font-weight:500; }
.dashboard-sidebar a { color:#333; text-decoration:none; }
.dashboard-sidebar a:hover { color:#0b662e; }

    
    /* ---------- RESPONSIVE ---------- */
    @media (max-width:1199px){ .category-grid{ grid-template-columns:repeat(3,1fr) } .featured-grid{ grid-template-columns:repeat(3,1fr) } }
    @media (max-width: 900px){
      .category-grid{ grid-template-columns:repeat(2,1fr) }
      .product-preview-grid{ grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap:14px; }
      .category-banner-img{ height:220px; }
    }
    @media (max-width: 600px){
      .category-grid{ grid-template-columns:repeat(1,1fr) }
      .featured-grid{ grid-template-columns:repeat(2,1fr) }
      .category-banner-img{ height:160px; }
      .product-card img{ height:130px; }
    }
  </style>
</head>
<body>

  <!-- thin topbar -->
  <div class="nav-bottom text-white small py-2">
    <div class="container d-flex justify-content-between">
      <div class="d-flex gap-4">
        <div><i class="fas fa-truck me-2"></i>Fast &amp; Free Delivery</div>
        <div><i class="fas fa-shopping-basket me-2"></i>Thousands of products</div>
      </div>
      <div><i class="fas fa-phone me-2"></i><a href="tel:+971542526215" class="text-white text-decoration-none">+971-542526215</a></div>
    </div>
  </div>

  <!-- header -->
  <header class="site-header">
    <div class="container d-flex align-items-center gap-3">
      <a href="/" class="site-logo"><i class="fas fa-shopping-cart"></i> Savers Grocery</a>

      <form class="search-form d-flex flex-grow-1" action="/search" method="GET" style="max-width:900px;">
        <input type="text" name="q" class="form-control"
          placeholder="Search products..."
          value="<%= q || '' %>">

        <button class="btn ms-2" style="background:#0b662e;color:#fff;border:none">
          <i class="fas fa-search"></i>
        </button>
      </form>

      <div class="dropdown position-relative">
        <% if (!user) { %>
          <!-- NOT LOGGED IN -->
          <a class="d-flex align-items-center text-decoration-none login-btn"
             style="color:#0b662e; cursor:pointer;"
             id="loginDropdown"
             data-bs-toggle="dropdown"
             aria-expanded="false">
            <i class="fas fa-user me-1"></i> Login & Register
          </a>

          <div class="dropdown-menu dropdown-menu-end p-3 shadow"
               aria-labelledby="loginDropdown"
               style="min-width:230px; border-radius:10px;">

            <h6 class="mb-1">Your Account</h6>
            <p class="small text-muted mb-2">Access account and manage orders</p>

            <div class="d-flex flex-column gap-2">
              <a href="/register" class="btn btn-sm btn-outline-dark w-100">
                <i class="fa fa-user-plus me-1"></i> Register
              </a>
              <a href="/login" class="btn btn-sm btn-success w-100">
                <i class="fa fa-sign-in-alt me-1"></i> Login
              </a>
            </div>

          </div>

        <% } else { %>
          <!-- LOGGED IN -->
          <a class="d-flex align-items-center text-decoration-none login-btn"
             style="color:#0b662e; cursor:pointer;"
             id="accountDropdown"
             data-bs-toggle="dropdown"
             aria-expanded="false">
            <i class="fas fa-user-circle me-1"></i> <%= user.name || user.firstName || user.email %>
          </a>

          <div class="dropdown-menu dropdown-menu-end p-3 shadow"
               aria-labelledby="accountDropdown"
               style="min-width:230px; border-radius:10px;">

            <h6 class="mb-1">Hello, <%= user.name || user.firstName || user.email %></h6>
            <p class="small text-muted mb-2">Manage your account</p>

            <div class="d-flex flex-column gap-2">
              <a href="/account" class="btn btn-sm btn-outline-dark w-100">
                <i class="fa fa-user me-1"></i> My Account
              </a>

              <button id="logoutBtn" class="btn btn-danger btn-sm w-100">
                <i class="fa fa-sign-out-alt me-1"></i> Logout
              </button>

              <form id="logoutForm" action="/logout" method="POST" class="d-none"></form>
            </div>

          </div>
        <% } %>
      </div>

      <a href="/cart" class="position-relative" style="color:#0b662e; margin-left:12px;">
        <i class="fas fa-shopping-cart fa-lg"></i>
        <span class="badge bg-warning text-dark position-absolute top-0 start-100 translate-middle">
          <%= cartCount || 0 %>
        </span>
      </a>
    </div>
  </header>

  <div class="nav-bottom text-white small py-2" style="background:#1b683f;">
    <div class="container d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-3">
        <i class="fas fa-truck"></i>
        Next Standard Delivery Today 6:00 PM-10:00 PM
      </div>
      <div class="d-flex align-items-center gap-2">
        <i class="fas fa-map-marker-alt"></i>
        <span>Deliver to: Dubai Festival City - Dubai</span>
      </div>
    </div>
  </div>

  <!-- CATEGORIES BAR -->
  <div class="categories-bar py-2">
    <div class="container d-flex align-items-center gap-4 flex-wrap">
      <div class="dropdown">
        <button class="btn btn-link text-dark fw-semibold dropdown-toggle p-0" type="button" data-bs-toggle="dropdown">
          All Category
        </button>
        <ul class="dropdown-menu">
          <% (categories || []).forEach(cat => { %>
            <li><a class="dropdown-item" href="/category/<%= cat.slug %>"><%= cat.name %></a></li>
          <% }) %>
        </ul>
      </div>

      <div class="d-flex align-items-center gap-4 flex-wrap">
        <% (categories || []).slice(0, 8).forEach(cat => { %>
          <a href="/category/<%= cat.slug %>" class="category-link text-dark">
            <%= cat.name %>
          </a>
        <% }) %>
      </div>
    </div>
  </div>

  <main class="main-container py-4">
    <div class="container">
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent px-0 mb-4">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item"><a href="/account">Account</a></li>
          <li class="breadcrumb-item active" aria-current="page">Edit Information</li>
        </ol>
      </nav>

      <div class="row">
        <!-- Main Content -->
        <div class="col-md-9">
          <h4 class="mb-4">MY ACCOUNT INFORMATION</h4>

          <div class="card p-4">

            <h5>Your Personal Details</h5>
            <hr>

            <% if (messages && messages.error) { %>
              <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <% if (messages && messages.success) { %>
              <div class="alert alert-success"><%= messages.success %></div>
            <% } %>

            <form action="/account/edit" method="POST" novalidate>

              <div class="mb-3">
                <label class="form-label">First Name *</label>
                <input type="text" name="firstName" value="<%= user.firstName || '' %>" class="form-control" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Last Name *</label>
                <input type="text" name="lastName" value="<%= user.lastName || '' %>" class="form-control" required>
              </div>

              <div class="mb-3">
                <label class="form-label">E-Mail *</label>
                <input type="email" name="email" value="<%= user.email || '' %>" class="form-control" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Telephone *</label>
                <div class="input-group">
                  <select name="countryCode" class="form-select" style="max-width:110px;">
                    <option value="+91" <%= (user.countryCode === "+91" || !user.countryCode) ? "selected" : "" %>>+91</option>
                    <option value="+1" <%= user.countryCode === "+1" ? "selected" : "" %>>+1</option>
                    <option value="+44" <%= user.countryCode === "+44" ? "selected" : "" %>>+44</option>
                  </select>
                  <input type="text" name="phone" value="<%= user.phone || '' %>" class="form-control" required>
                </div>
              </div>

              <div class="d-flex justify-content-between mt-4">
                <a href="/account" class="btn btn-secondary">Back</a>
                <button class="btn btn-green" type="submit">Continue</button>
              </div>

            </form>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="col-md-3">
          <div class="card p-3 dashboard-sidebar">

            <h6><i class="fa fa-user"></i> ACCOUNT SETTINGS</h6>
            <ul class="list-unstyled mt-2">
              <li><a href="/account">My Account</a></li>
              <li><a href="/account/edit">Edit Account</a></li>
              <li><a href="/account/password">Password</a></li>
              <li><a href="/address-book">Address Book</a></li>
            </ul>

            <hr>

            <h6><i class="fa fa-box"></i> MY ORDERS</h6>
            <ul class="list-unstyled mt-2">
              <li><a href="/orders">Order History</a></li>
              <li><a href="/returns">Returns</a></li>
              <li><a href="/transactions">Transactions</a></li>
            </ul>

            <hr>

            <h6><i class="fa fa-heart"></i> MY STUFF</h6>
            <ul class="list-unstyled mt-2">
              <li><a href="/wishlist">Wishlist</a></li>
              <li><a href="/newsletter">Newsletter</a></li>
            </ul>

            <hr>

            <a href="/logout" class="text-danger">Logout</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- footer (copied / adapted from your template) -->
  <footer class="mt-5">
    <div class="container">
      <div class="row">
        <div class="col-sm-3"><h6 class="fw-bold">Get to Know Us</h6><a href="#">About</a></div>
        <div class="col-sm-3"><h6 class="fw-bold">Connect</h6><a href="#">Facebook</a></div>
        <div class="col-sm-3"><h6 class="fw-bold">Sell with us</h6><a href="#">Sell</a></div>
        <div class="col-sm-3"><h6 class="fw-bold">Help</h6><a href="#">Support</a></div>
      </div>

      <br>

      <div class="row">
        <div class="col-md-8">
          <h6>SIGN UP FOR NEWSLETTER</h6>
          <p class="small text-muted">Make sure that you never miss our interesting news and exclusive promotion.</p>

          <% if (typeof success !== "undefined") { %>
            <div class="alert alert-success"><%= success %></div>
          <% } %>

          <% if (typeof error !== "undefined") { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <form class="d-flex" action="/subscribe" method="POST">
            <input class="form-control me-2" name="email" placeholder="Your email address" required>
            <button class="btn btn-success" type="submit">Subscribe</button>
          </form>
        </div>
      </div>

      <div class="text-center small mt-4">© <%= new Date().getFullYear() %> Savers Grocery — All Rights Reserved</div>
    </div>
  </footer>

  <!-- scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <!-- SweetAlert2 for logout confirmation -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    document.getElementById("logoutBtn")?.addEventListener("click", function (e) {
        e.preventDefault();
        Swal.fire({
            title: 'Logout?',
            text: 'Do you want to log out from your account?',
            icon: 'warning',
            width: '320px',
            padding: '0.8rem',
            showCancelButton: true,
            confirmButtonText: 'Logout',
            cancelButtonText: 'Cancel',
            buttonsStyling: false,
            customClass: {
                popup: 'rounded-3',
                confirmButton: 'btn btn-danger me-2',
                cancelButton: 'btn btn-secondary'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById("logoutForm").submit();
            }
        });
    });

    // Simple client-side: strip spaces from phone input
    document.addEventListener('DOMContentLoaded', function() {
      const phone = document.querySelector('input[name="phone"]');
      if (phone) {
        phone.addEventListener('input', () => {
          phone.value = phone.value.replace(/\s+/g, '');
        });
      }
    });
  </script>
</body>
</html>
