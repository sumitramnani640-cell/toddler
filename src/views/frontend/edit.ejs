<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || "Savers Grocery" %></title>

  <!-- Bootstrap + icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

   <%- include("layouts/header") %>

  <main class="main-container py-4">
    <div class="container">
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent px-0 mb-4">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item"><a href="/account">Account</a></li>
          <li class="breadcrumb-item active" aria-current="page">Edit Information</li>
        </ol>
      </nav>

      <div class="row">
        <!-- Main Content -->
        <div class="col-md-9">
          <h4 class="mb-4">MY ACCOUNT INFORMATION</h4>

          <div class="card p-4">

            <h5>Your Personal Details</h5>
            <hr>

            <% if (messages && messages.error) { %>
              <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <% if (messages && messages.success) { %>
              <div class="alert alert-success"><%= messages.success %></div>
            <% } %>

            <form action="/account/edit" method="POST" novalidate>

              <div class="mb-3">
                <label class="form-label">First Name *</label>
                <input type="text" name="firstName" value="<%= user.firstName || '' %>" class="form-control" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Last Name *</label>
                <input type="text" name="lastName" value="<%= user.lastName || '' %>" class="form-control" required>
              </div>

              <div class="mb-3">
                <label class="form-label">E-Mail *</label>
                <input type="email" name="email" value="<%= user.email || '' %>" class="form-control" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Telephone *</label>
                <div class="input-group">
                  <select name="countryCode" class="form-select" style="max-width:110px;">
                    <option value="+91" <%= (user.countryCode === "+91" || !user.countryCode) ? "selected" : "" %>>+91</option>
                    <option value="+1" <%= user.countryCode === "+1" ? "selected" : "" %>>+1</option>
                    <option value="+44" <%= user.countryCode === "+44" ? "selected" : "" %>>+44</option>
                  </select>
                  <input type="text" name="phone" value="<%= user.phone || '' %>" class="form-control" required>
                </div>
              </div>

              <div class="d-flex justify-content-between mt-4">
                <a href="/account" class="btn btn-secondary">Back</a>
                <button class="btn btn-green" type="submit">Continue</button>
              </div>

            </form>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="col-md-3">
          <div class="card p-3 dashboard-sidebar">

            <h6><i class="fa fa-user"></i> ACCOUNT SETTINGS</h6>
            <ul class="list-unstyled mt-2">
              <li><a href="/account">My Account</a></li>
              <li><a href="/account/edit">Edit Account</a></li>
              <li><a href="/account/password">Password</a></li>
              <li><a href="/address-book">Address Book</a></li>
            </ul>

            <hr>

            <h6><i class="fa fa-box"></i> MY ORDERS</h6>
            <ul class="list-unstyled mt-2">
              <li><a href="/orders">Order History</a></li>
              <li><a href="/returns">Returns</a></li>
              <li><a href="/transactions">Transactions</a></li>
            </ul>

            <hr>

            <h6><i class="fa fa-heart"></i> MY STUFF</h6>
            <ul class="list-unstyled mt-2">
              <li><a href="/wishlist">Wishlist</a></li>
              <li><a href="/newsletter">Newsletter</a></li>
            </ul>

            <hr>

            <a href="/logout" class="text-danger">Logout</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- footer (copied / adapted from your template) -->
   <%- include("layouts/footer") %>

  <!-- scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <!-- SweetAlert2 for logout confirmation -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    document.getElementById("logoutBtn")?.addEventListener("click", function (e) {
        e.preventDefault();
        Swal.fire({
            title: 'Logout?',
            text: 'Do you want to log out from your account?',
            icon: 'warning',
            width: '320px',
            padding: '0.8rem',
            showCancelButton: true,
            confirmButtonText: 'Logout',
            cancelButtonText: 'Cancel',
            buttonsStyling: false,
            customClass: {
                popup: 'rounded-3',
                confirmButton: 'btn btn-danger me-2',
                cancelButton: 'btn btn-secondary'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById("logoutForm").submit();
            }
        });
    });

    // Simple client-side: strip spaces from phone input
    document.addEventListener('DOMContentLoaded', function() {
      const phone = document.querySelector('input[name="phone"]');
      if (phone) {
        phone.addEventListener('input', () => {
          phone.value = phone.value.replace(/\s+/g, '');
        });
      }
    });
  </script>
</body>
</html>
