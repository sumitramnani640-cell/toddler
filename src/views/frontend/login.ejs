<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title || 'Login - Saver Grocery' %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

  <style>
    body { font-family: "Segoe UI", Roboto, Arial; color:#222; background:#fff; }
    .topbar { background:#225f40; color:#fff; font-size:.9rem; padding:.35rem 0; }
    .brand-bar { background:#fff; border-bottom:4px solid #1b683f; padding:12px 0; }
    .nav-bottom { background:#1b683f; color:#fff; padding:.45rem 0; font-size:.95rem; }
    .card-box { border-radius:6px; border:1px solid #e6e6e6; padding:18px; background:#fff; }
    .footer { padding:40px 0; border-top:1px solid #eee; }
    .btn-success { background:#1b683f; border-color:#1b683f; }
    .logo-small { height:42px; }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="container d-flex justify-content-between">
      <div><i class="fas fa-truck"></i> Fast & Free Delivery</div>
      <div><i class="fas fa-phone"></i> +971-542526215</div>
    </div>
  </div>

  <!-- BRAND BAR -->
  <div class="brand-bar">
    <div class="container d-flex align-items-center justify-content-between">
      <a href="/" class="d-flex align-items-center">
        <img src="/images/logo.png" alt="Saver Grocery" style="height:50px;"
             onerror="this.src='https://via.placeholder.com/160x50?text=Saver+Logo'">
      </a>

      <div class="flex-grow-1 mx-4">
        <form class="d-flex" method="GET" action="/search">
          <input class="form-control me-2" type="search" name="q" placeholder="Search Products">
          <button class="btn btn-success" type="submit"><i class="fas fa-search"></i></button>
        </form>
      </div>

      <div class="d-flex gap-3 align-items-center">
        <a class="btn btn-outline-success" href="/horeca">Horeca</a>
        <a class="btn btn-link" href="/login"><i class="fa fa-user"></i> Login & Register</a>
        <a class="btn btn-link" href="/cart"><i class="fa fa-shopping-cart"></i></a>
      </div>
    </div>
  </div>

  <!-- CATEGORY NAV -->
  <div class="nav-bottom">
    <div class="container d-flex align-items-center">
      <div><i class="fas fa-map-marker-alt"></i> Deliver to: Dubai Festival City - Dubai</div>
    </div>
  </div>

  <!-- MAIN -->
  <main class="container my-4">
    <div class="row g-4">

      <!-- Flash Messages -->
      <div class="col-12">
        <% if (success_msg && success_msg.length) { %>
          <% success_msg.forEach(m => { %>
            <div class="alert alert-success"><%= m %></div>
          <% }) %>
        <% } %>
        <% if (error_msg && error_msg.length) { %>
          <% error_msg.forEach(m => { %>
            <div class="alert alert-danger"><%= m %></div>
          <% }) %>
        <% } %>
      </div>

      <!-- Left -->
      <div class="col-lg-4">
        <div class="card-box">
          <h5>NEW CUSTOMER</h5>
          <p class="small text-muted">Create an account for a better shopping experience.</p>
          <a href="/register" class="btn btn-success">Continue</a>
        </div>
      </div>

      <!-- Middle: LOGIN -->
      <div class="col-lg-4">
        <div class="card-box">
          <h5>RETURNING CUSTOMER</h5>
          <p class="small text-muted">Login using your email and password.</p>

          <form method="POST" action="/login">
            <div class="mb-3">
              <label class="form-label small">E-Mail Address</label>
              <input type="email" name="email" class="form-control" required>
            </div>

            <div class="mb-3">
              <label class="form-label small">Password</label>
              <input type="password" name="password" class="form-control" required>
            </div>

            <div class="d-flex align-items-center">
              <button type="submit" class="btn btn-success">Login</button>
              <a href="/forgot-password" class="ms-auto small">Forgot Password?</a>
            </div>
          </form>
        </div>
      </div>

      <!-- Right -->
      <div class="col-lg-4">
        <div class="card account-sidebar p-3">
          <div class="card-body">
            <h6 class="mb-3"><i class="fa fa-user-circle"></i> ACCOUNT</h6>
            <ul class="list-unstyled small">
              <li><a href="/login">Login</a></li>
              <li><a href="/register">Register</a></li>
              <li><a href="/forgot-password">Forgot Password</a></li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <p class="small text-muted">
        &copy; Saver Grocery — All Rights Reserved
      </p>
    </div>
  </footer>
</body>
</html>
