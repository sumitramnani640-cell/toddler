<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Login - Saver Grocery</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

  <style>
    body { font-family: "Segoe UI", Roboto, Arial; color:#222; background:#fff; }
    .topbar { background:#225f40; color:#fff; font-size:.9rem; padding:.35rem 0; }
    .brand-bar { background:#fff; border-bottom:4px solid #1b683f; padding:12px 0; }
    .nav-bottom { background:#1b683f; color:#fff; padding:.45rem 0; font-size:.95rem; }
    .breadcrumb-area { padding:10px 0; }
    .card-box { border-radius:6px; border:1px solid #e6e6e6; padding:18px; background:#fff; }
    .page-title { font-size:1rem; font-weight:700; margin-bottom:14px; }
    .btn-success { background:#1b683f; border-color:#1b683f; }
    .account-sidebar { border-radius:8px; box-shadow:0 1px 4px rgba(0,0,0,.05); }
    .footer { padding:40px 0; border-top:1px solid #eee; }
    .logo-small { height:42px; }
    @media (max-width: 991px) {
      .brand-bar .search { margin-top:12px; }
    }
  </style>
</head>
<body>

  <!-- Topbar -->
  <div class="topbar">
    <div class="container d-flex justify-content-between">
      <div><i class="fas fa-truck"></i> Fast & Free Delivery</div>
      <div><i class="fas fa-phone"></i> +971-542526215</div>
    </div>
  </div>

  <!-- Brand & Search -->
  <div class="brand-bar">
    <div class="container d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <img src="https://via.placeholder.com/160x50?text=Saver+Logo" alt="Saver Grocery" style="height:50px;">
      </div>

      <div class="flex-grow-1 mx-4">
        <form class="d-flex" role="search">
          <input class="form-control me-2" type="search" placeholder="Search Products">
          <button class="btn btn-success" type="submit"><i class="fas fa-search"></i></button>
        </form>
      </div>

      <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-outline-success">Horeca</button>
        <a class="btn btn-link" href="#"><i class="fa fa-user"></i> Login & Register</a>
        <a class="btn btn-link" href="#"><i class="fa fa-shopping-cart"></i></a>
      </div>
    </div>
  </div>

  <!-- Green nav -->
  <div class="nav-bottom">
    <div class="container d-flex align-items-center">
      <div class="me-3"><i class="fas fa-map-marker-alt"></i> Deliver to: Dubai Festival City - Dubai</div>
      <nav class="ms-auto">
        <ul class="list-inline mb-0">
          <li class="list-inline-item text-white me-3">All Category</li>
          <li class="list-inline-item text-white me-3">Fresh Food</li>
          <li class="list-inline-item text-white me-3">Beverages</li>
          <li class="list-inline-item text-white me-3">Bakery</li>
        </ul>
      </nav>
    </div>
  </div>

  <!-- Breadcrumb -->
  <div class="container breadcrumb-area">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb bg-transparent p-0 mb-0">
        <li class="breadcrumb-item"><a href="#"><i class="fa fa-home"></i></a></li>
        <li class="breadcrumb-item">Account</li>
        <li class="breadcrumb-item active" aria-current="page">Login</li>
      </ol>
    </nav>
  </div>

  <!-- Main -->
  <main class="container my-4">
    <div class="row g-4">
      <!-- Left: New customer -->
      <div class="col-lg-4">
        <div class="card-box">
          <h5 class="page-title">NEW CUSTOMER</h5>
          <p class="mb-3"><strong>Register Account</strong></p>
          <p class="small text-muted">By creating an account you will be able to shop faster, be up to date on an order's status, and keep track of the orders you have previously made.</p>
          <a href="#" class="btn btn-success">Continue</a>
        </div>
      </div>

      <!-- Center: Returning customer -->
      <div class="col-lg-4">
        <div class="card-box">
          <h5 class="page-title">RETURNING CUSTOMER</h5>
          <p class="small text-muted mb-3">I am a returning customer</p>

          <form id="loginForm" autocomplete="on">
            <div class="mb-3">
              <label class="form-label small">E-Mail Address</label>
              <input type="email" class="form-control" placeholder="E-Mail" value="sumitramnani796@gmail.com" required>
            </div>

            <div class="mb-2">
              <label class="form-label small">Password</label>
              <input type="password" class="form-control" placeholder="Password" value="password123" required>
            </div>

            <div class="d-flex align-items-center mt-3">
              <button type="submit" class="btn btn-success">Login</button>
              <a href="#" class="ms-auto small">Forgot Password ?</a>
            </div>
          </form>
        </div>
      </div>

      <!-- Right: Account settings -->
      <div class="col-lg-4">
        <div class="card account-sidebar p-3">
          <div class="card-body">
            <h6 class="mb-3"><i class="fa fa-user-circle"></i> ACCOUNT SETTINGS</h6>
            <ul class="list-unstyled mb-0">
              <li class="mb-2"><a href="#">Login</a></li>
              <li class="mb-2"><a href="#">Register</a></li>
              <li class="mb-2"><a href="#">Forgot Password</a></li>
              <li class="mb-2"><a href="#">My Account</a></li>
            </ul>
          </div>
        </div>

        <div class="card mt-4 p-3">
          <div class="card-body small text-muted">
            <strong>SAVER GROCERY</strong><br>
            Saver Grocery is the first food grocery in the region operating on a discount model, offering the best quality products to its customers at the best price.
            <p class="mt-3 mb-0"><i class="fa fa-map-marker-alt"></i> DSP Warehouse Complex, Block-C19, Al Barsha South, P.O.Box 251723, Dubai, UAE</p>
            <p class="mb-0"><i class="fa fa-phone"></i> +971-542526215</p>
            <p class="mb-0"><i class="fa fa-envelope"></i> info@savergrocery.com</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="row gy-4">
        <div class="col-md-4">
          <img src="https://via.placeholder.com/160x48?text=Saver+Logo" alt="Saver Grocery" class="mb-3 logo-small">
          <p class="small text-muted">Saver Grocery is the first food grocery in the region operating on a discount model, offering the best quality products to its customers at the best price.</p>
        </div>

        <div class="col-md-2">
          <h6>INFORMATION</h6>
          <ul class="list-unstyled small">
            <li><a href="#">About Us</a></li>
            <li><a href="#">Delivery Information</a></li>
            <li><a href="#">Privacy Policy</a></li>
            <li><a href="#">Terms & Conditions</a></li>
          </ul>
        </div>

        <div class="col-md-2">
          <h6>MY ACCOUNT</h6>
          <ul class="list-unstyled small">
            <li><a href="#">My Account</a></li>
            <li><a href="#">Order History</a></li>
            <li><a href="#">Wishlist</a></li>
            <li><a href="#">Sitemap</a></li>
          </ul>
        </div>

        <div class="col-md-4">
          <h6>SIGN UP FOR NEWSLETTER</h6>
          <p class="small text-muted">Make sure that you never miss our interesting news and exclusive promotions. No spam, ever.</p>
          <form class="d-flex">
            <input class="form-control me-2" placeholder="Your email address">
            <button class="btn btn-success" type="button">Subscribe</button>
          </form>

          <div class="mt-3">
            <a href="#" class="me-2"><img src="https://via.placeholder.com/120x40?text=Google+Play" alt="Play"></a>
            <a href="#"><img src="https://via.placeholder.com/120x40?text=App+Store" alt="AppStore"></a>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // small demo behavior (replace with real auth)
    document.getElementById('loginForm').addEventListener('submit', function(e) {
      e.preventDefault();
      alert('Login submitted (demo). Replace with your back-end auth.');
    });
  </script>
</body>
</html>
