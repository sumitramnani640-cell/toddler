<!-- ================= HEADER CSS (included inside header section) ================= -->
<style> 
    /* ---------- Reset & base ---------- */
    *{box-sizing:border-box;margin:0;padding:0}
    body,html{font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;background:#fff;color:#7a4242}
    .container{max-width:1200px;margin:0 auto;padding:0 1rem}

    /* ---------- Top thin nav ---------- */
    .nav-bottom { background: linear-gradient(135deg,#087030 0%,#0e6424 100%); color:#fff; }
    .nav-bottom a{ color:rgba(255,255,255,0.95); text-decoration:none; font-size:0.95rem; }

    /* ---------- Header / search ---------- */
    header.site-header{ background:#fff; padding:12px 0; border-bottom:1px solid #eee; }
    .site-logo { font-weight:700; color:#0b662e; font-size:1.25rem; display:flex; align-items:center; gap:.5rem }
    .site-logo i{ color:#0b662e }

    form.search-form .form-select,
    form.search-form .form-control { height:40px; border-radius:6px; }

    /* ---------- HERO / BANNER CAROUSEL ---------- */
    .banner-carousel { height:250px; width:100%; object-fit:cover; border-radius:6px; display:block; }

    /* ---------- SHOP BY CATEGORY (cards like product) ---------- */
    #categories { padding:40px 0; background:#f7faf9; }
    #categories .section-title { text-align:center; font-size:28px; margin-bottom:20px; font-weight:700; }

    .category-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; align-items:stretch; }
    .category-card { background:#fff; border-radius:12px; box-shadow:0 8px 24px rgba(18,38,63,0.06); overflow:hidden; display:flex; flex-direction:column; }
    .category-card a{ display:block; color:inherit; text-decoration:none; height:100% }
    .category-img-wrap { height:290px; display:flex; align-items:center; justify-content:center; padding:14px; background:#fff }
    .category-img-wrap img { width:100%; height:100%; object-fit:cover; border-radius:8px; transition:transform .25s; }
    .category-card:hover .category-img-wrap img{ transform:scale(1.03) }

    /* hide small caption area to match "image-only" look */
    .category-card .card-body{ padding:10px; text-align:center; display:none; }

    /* ---------- Category Block (banner + product preview row) ---------- */
    .category-block{ margin:40px 0; padding:0 0 6px; }
    .category-banner-wrap{ width:100%; display:flex; justify-content:center; margin: 20px 0; padding:0 12px; }
    .category-banner-wrap .banner-link { display:block; width:100%; max-width:2000px; border-radius:8px; overflow:hidden; box-shadow:0 8px 30px rgba(15,40,60,0.06); }
    .category-banner-img { display:block; width:100%; height:200px; object-fit:cover; object-position:center; transition:transform .35s ease; }
    .category-banner-wrap .banner-link:hover .category-banner-img { transform: translateY(-2px) scale(1.01); }

    .category-header { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-top:12px; margin-bottom:8px; }
    .category-header h2 { color:#0b662e; font-weight:700; margin:0; font-size:20px; }
    .view-all-btn { color:#0b662e; text-decoration:none; font-weight:600; }

    /* ---------- PRODUCT PREVIEW GRID (fuller product cards) ---------- */
    .product-preview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 12px;
    }

    .product-card {
      background: #fff;
      border-radius: 12px;
      padding: 14px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
      transition: transform .18s ease, box-shadow .18s ease;
      display:flex;
      flex-direction:column;
      height:100%;
    }

    .product-card:hover { transform: translateY(-6px); box-shadow: 0 14px 34px rgba(0,0,0,0.10); }

    .product-card a { color:inherit; text-decoration:none; display:block; height:100%; }
    .product-card img { width:100%; height:170px; object-fit:contain; border-radius:8px; background:#fff; display:block; margin:0 auto; }
    .product-card h4 { font-size:1rem; margin:10px 0 6px; color:#333; height:44px; overflow:hidden; }
    .product-card .price { color:#087030; font-weight:700; font-size:1.05rem; margin-bottom:10px; }
    .actions { margin-top:auto; display:flex; gap:8px; align-items:center; justify-content:space-between; }
    .qty { width:60px; padding:6px; border-radius:6px; border:1px solid #ddd; text-align:center; }
    .add-to-cart { background:#087030; color:#fff; border:none; padding:8px 12px; border-radius:6px; cursor:pointer; }

    /* ---------- FEATURED PRODUCTS ---------- */
    #products { padding:40px 0; }
    .featured-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
    .featured-card{ background:#fff;border-radius:12px; box-shadow:0 8px 24px rgba(18,38,63,0.06); padding:12px; display:flex; flex-direction:column; gap:8px }
    .featured-card img{ width:100%; height:150px; object-fit:contain; border-radius:8px }
    .featured-card h6{ font-size:0.95rem; font-weight:700; color:#222; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
.login-btn:hover {
  color: #0b662e !important;
}

.dropdown-menu {
  margin-top: 8px !important;
}

    
    /* ---------- RESPONSIVE ---------- */
    @media (max-width:1199px){ .category-grid{ grid-template-columns:repeat(3,1fr) } .featured-grid{ grid-template-columns:repeat(3,1fr) } }
    @media (max-width: 900px){
      .category-grid{ grid-template-columns:repeat(2,1fr) }
      .product-preview-grid{ grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap:14px; }
      .category-banner-img{ height:220px; }
    }
    @media (max-width: 600px){
      .category-grid{ grid-template-columns:repeat(1,1fr) }
      .featured-grid{ grid-template-columns:repeat(2,1fr) }
      .category-banner-img{ height:160px; }
      .product-card img{ height:130px; }
    }
 
/* ------------------------------------
   BASE & GLOBAL
------------------------------------ */
* { box-sizing: border-box; margin: 0; padding: 0; }
body, html {
  font-family: 'Segoe UI', Tahoma, sans-serif;
  background: #fff;
  color: #333;
}
.container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }

/* ------------------------------------
   TOP THIN STRIP
------------------------------------ */
.nav-bottom {
  background: linear-gradient(135deg, #087030 0%, #0e6424 100%);
  color: #fff;
}
.nav-bottom a { color: #fff; text-decoration: none; }

/* ------------------------------------
   HEADER
------------------------------------ */
.site-header {
  background: #fff;
  padding: 14px 0;
  border-bottom: 1px solid #eee;
}
.site-logo {
  font-size: 1.3rem;
  font-weight: 700;
  color: #0b662e;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: .5rem;
}
.search-form input {
  height: 40px;
  border-radius: 6px;
}
.search-form button {
  background: #0b662e;
  color: #fff;
  border-radius: 6px;
  padding: 0 16px;
}

/* ACCOUNT DROPDOWN */
.login-btn {
  color: #0b662e !important;
  font-weight: 700;
}   
.login-btn:hover { color: #f70000 !important; }
.dropdown-menu { margin-top: 8px !important; border-radius: 10px; }

/* ------------------------------------
   DELIVERY STRIP
------------------------------------ */
.delivery-strip {
  background: #1b683f;
  color: #fff;
  font-size: 0.9rem;
  padding: 8px 0;
}

/* ------------------------------------
   CATEGORY BAR
------------------------------------ */
.categories-bar {
  background: #f7faf9;
  border-bottom: 1px solid #e2e2e2;
}
.categories-bar a {
  color: #333; 
  text-decoration: none; 
  font-weight: 500;
}
.categories-bar a:hover { color: #0b662e; }

/* DROPDOWN */
.categories-bar .dropdown-toggle {
  font-weight: 600;
  font-size: 15px;
  color: #333;
}
.categories-bar .dropdown-menu a:hover {
  background: #f1f1f1;
}


/* SEARCH BOX */
.search-form {
  max-width: 850px;
  width: 100%;
  margin: 0 15px;
  margin-left: 10px;
}

.search-input {
  height: 36px;
  border: 1px solid #ccc;
  padding: 0 12px;
  border-radius: 6px 0 0 6px;
  width: 100%;
  font-size: 14px;
  margin-left: 10px;
}

.search-btn {
  height: 40px;
  width: 45px;
  background: #095f2a;
  color: #fff;
  border: none;
  border-radius: 0 6px 6px 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  cursor: pointer;
  margin-left: 10px;
}

.search-btn:hover {
  background: #0b662e;
}
/* Sidebar Card */
.sidebar-card {
  border-radius: 8px;
  background: #fff;
  border: 1px solid #e5e5e5;
}

/* Section Headings */
.sidebar-card h6 {
  font-size: 20px;
  color: #333;
  letter-spacing: 0.3px;
}

/* Sidebar Links */
.sidebar-card ul li a {
  color: #000000;
  font-size: 17px;
  padding-left: 4px;
  transition: 0.2s;
}

/* Hover Effect */
.sidebar-card ul li a:hover {
  color: #0b662e;       /* green */
  padding-left: 8px;    /* slight slide effect */
}

/* Icons spacing handled by me-2 already */


/* MOBILE RESPONSIVE */
@media (max-width: 576px) {
  .search-form {
    max-width: 100%;
    margin: 0;
  }

  .search-input {
    height: 34px;
    font-size: 13px;
  }

  .search-btn {
    height: 34px;
    width: 40px;
    font-size: 13px;
  }
}


</style>

<!-- ================= HEADER HTML ================= -->

<!-- 🔹 TOP BAR -->
<div class="nav-bottom py-2">
  <div class="container d-flex justify-content-between">
    <div class="d-flex gap-4">
      <div><i class="fas fa-truck me-2"></i>Fast & Free Delivery</div>
      <div><i class="fas fa-shopping-basket me-2"></i>Thousands of products</div>
    </div>
    <div>
      <i class="fas fa-phone me-2"></i>
      <a href="tel:+971542526215">+971-542526215</a>
    </div>
  </div>
</div>

<!-- 🔹 MAIN HEADER -->
<header class="site-header">
  <div class="container d-flex align-items-center gap-3">

   <a href="/" class="site-logo">
  <img src="/assets/logo.png" alt="Saver Grocery" style="height:45px;">
  <!-- <i class="fas fa-shopping-cart"></i> Savers Grocery -->
</a>


  <form class="search-form d-flex align-items-center flex-grow-1" action="/search" method="GET">
  <input 
    type="text" 
    name="q" 
    class="search-input" 
    placeholder="Search products..." 
    required
  >
  <button class="search-btn">
    <i class="fas fa-search"></i>
  </button>
</form>




    <!-- ACCOUNT DROPDOWN -->
   <div class="dropdown">

  <% if (!user) { %>
    <a class="login-btn" id="loginDropdown" data-bs-toggle="dropdown" style="cursor:pointer;">
      <i class="fas fa-user me-1"></i> Login & Register
    </a>

    <div class="dropdown-menu dropdown-menu-end p-3 shadow">
      <h6>Your Account</h6>
      <div class="d-flex flex-column gap-2 mt-2">
        <a href="/register" class="btn btn-sm btn-outline-dark">Register</a>
        <a href="/login" class="btn btn-sm btn-success">Login</a>
      </div>
    </div>

  <% } else { %>

    <a class="login-btn" id="accountDropdown" data-bs-toggle="dropdown" style="cursor:pointer;">
      <i class="fas fa-user-circle me-1"></i> <%= user.name %>
    </a>

    <div class="dropdown-menu dropdown-menu-end p-3 shadow">
      <h6>Hello, <%= user.name %></h6>

      <div class="d-flex flex-column gap-2 mt-2">
        <a href="/account" class="btn btn-sm btn-outline-dark">
            <i class="fa fa-user-pen"></i>My Account</a>

        <!-- LOGOUT BUTTON -->
   <!-- LOGOUT BUTTON -->
<button class="btn btn-danger w-100 logout-btn">
  <i class="fa fa-sign-out-alt me-1"></i> Logout
</button>

        <!-- HIDDEN LOGOUT FORM -->
        <form id="logoutForm" action="/logout" method="POST" class="d-none"></form>
        
        <!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const logoutButtons = document.querySelectorAll('.logout-btn');  // now matches
  const logoutForm = document.getElementById('logoutForm');

  if (!logoutButtons.length || !logoutForm) return;

  logoutButtons.forEach(btn => {
    btn.addEventListener('click', function (e) {
      e.preventDefault();

      Swal.fire({
        title: 'Logout?',
        text: 'Do you want to log out from your account?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Logout',
        cancelButtonText: 'Cancel'
      }).then((result) => {
        if (result.isConfirmed) {
          logoutForm.submit();
        }
      });
    });
  });
});
</script>


      </div>
    </div>

  <% } %>

</div>


    <!-- CART -->
    <a href="/cart" class="position-relative" style="color:#0b662e;">
      <i class="fas fa-shopping-cart fa-lg"></i>
      <span class="badge bg-warning text-dark position-absolute top-0 start-100 translate-middle">
        <%= cartCount || 0 %>
      </span>
    </a>

  </div>
</header>

<!-- 🔹 DELIVERY STRIP -->
<div class="delivery-strip">
  <div class="container d-flex justify-content-between">
    <div><i class="fas fa-truck me-2"></i>Next Standard Delivery Today 6PM – 10PM</div>
    <div><i class="fas fa-map-marker-alt me-2"></i>Deliver to: Dubai Festival City</div>
  </div>
</div>

