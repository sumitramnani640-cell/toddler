<footer>

  <!-- ICON STRIP -->
  <div class="footer-icons-strip">
    <div class="container d-flex justify-content-between flex-wrap">

      <div class="icon-box">
        <i class="fas fa-headset" aria-hidden="true"></i>
        <p>24/7 Support</p>
        <span>We’re Always Here To Help</span>
      </div>

      <div class="icon-box">
        <i class="fas fa-shield-alt" aria-hidden="true"></i>
        <p>Secure Payments</p>
        <span>Online & Offline Payments</span>
      </div>

      <div class="icon-box">
        <i class="fas fa-shipping-fast" aria-hidden="true"></i>
        <p>Same Day Delivery</p>
        <span>All Over Dubai</span>
      </div>

      <div class="icon-box">
        <i class="fas fa-truck" aria-hidden="true"></i>
        <p>Free Delivery</p>
        <span>For Orders Above AED 200</span>
      </div>

    </div>
  </div>

  <!-- MAIN FOOTER -->
  <div class="container footer-main">
    <div class="row">

      <!-- Left Column -->
      <div class="col-md-4">
        <img src="/assets/logo.png" class="footer-logo" alt="Saver Grocery logo">

        <p class="footer-about">
          Saver Grocery is the finest food grocery in the region operating
          on a discount model, offering the best quality products to its
          customers at the best price.
        </p>

        <p class="footer-contact"><i class="fa fa-map-marker-alt" aria-hidden="true"></i>
          DSP Warehouse Complex, Block-C19,<br>
          Al Barsha South, P.O.Box 231722,<br>
          Dubai, United Arab Emirates
        </p>

        <p class="footer-contact"><i class="fa fa-phone" aria-hidden="true"></i>
          <a href="tel:+971542526215">+971-542526215</a>
        </p>

        <p class="footer-contact"><i class="fa fa-envelope" aria-hidden="true"></i>
          <a href="mailto:info@savergrocery.com">info@savergrocery.com</a>
        </p>
      </div>

      <!-- Info Column -->
      <div class="col-md-3 footer-links">
        <h6 class="fw-bold mb-3">INFORMATION</h6>

        <% if (Array.isArray(cmsPages) && cmsPages.length) { %>
          <% cmsPages.forEach(function(page){ if (page && page.slug && page.title) { %>
            <a href="/page/<%= encodeURIComponent(page.slug) %>"><%= page.title %></a>
          <% } }) %>
        <% } else { %>
          <p>No pages available</p>
        <% } %>
      </div>

      <!-- My Account -->
      <div class="col-md-2 footer-links">
        <h6 class="fw-bold mb-3">MY ACCOUNT</h6>

        <a href="/account">My Account</a>
        <a href="/order-history">Order History</a>
        <a href="/wishlist">Wishlist <span id="wishlistCount" class="small text-muted">(0)</span></a>
      </div>

      <!-- Newsletter -->
      <div class="col-md-3">
        <h6 class="fw-bold mb-3">SIGN UP FOR NEWSLETTER</h6>

        <p class="small text-muted">Make sure that you never miss our interesting news and exclusive promotions. No spam, ever.</p>

        <!-- AJAX alert -->
        <div id="newsletterAlert" style="display:none;" class="mb-2"></div>

        <form id="newsletterForm" class="newsletter-box d-flex mb-3" action="/subscribe" method="POST">
          <input class="form-control me-2" name="email" id="newsletterEmail" placeholder="Your email address" required aria-label="Email address">
          <button type="submit">Subscribe</button>
        </form>

        <div class="d-flex">
          <img src="/assets/android.png" class="app-btn-img" alt="Android app">
          <img src="/assets/iphone.png" class="app-btn-img" alt="iPhone app">
        </div>
      </div>

    </div>
  </div>

  <!-- COPYRIGHT BAR -->
  <div class="footer-bottom">
    <div class="footer-social mb-2">
      <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
      <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
      <a href="https://www.youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
      <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
    </div>

    Copyright © 2025 SAVER GROCERY FOOD STUFF TRADING L.L.C.
    All rights reserved.
  </div>

</footer>

<script>
  // ===== AJAX NEWSLETTER SUBMIT =====
  (function () {
    const form = document.getElementById('newsletterForm');
    const emailInput = document.getElementById('newsletterEmail');
    const alertBox = document.getElementById('newsletterAlert');

    if (!form || !emailInput || !alertBox) return;

    function showAlert(message, type) {
      alertBox.style.display = 'block';
      alertBox.className = 'alert mb-2 alert-' + (type === 'error' ? 'danger' : 'success');
      alertBox.textContent = message;
      setTimeout(() => {
        alertBox.style.display = 'none';
      }, 4000);
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      const email = emailInput.value.trim();
      if (!email) {
        showAlert('Please enter your email address.', 'error');
        return;
      }

      const formData = new FormData(form);

      fetch(form.action, {
        method: 'POST',
        body: formData,
        credentials: 'same-origin'
      })
        .then(res => {
          if (res.ok) {
            showAlert('Subscribed successfully!', 'success');
            form.reset();
          } else {
            showAlert('Something went wrong. Please try again.', 'error');
          }
        })
        .catch(err => {
          console.error(err);
          showAlert('Unable to subscribe at the moment.', 'error');
        });
    });
  })();
</script>

<script>
  // ===== AJAX WISHLIST COUNT =====
  (function () {
    const counter = document.getElementById('wishlistCount');
    if (!counter) return;

    fetch('/api/wishlist/count', {
      method: 'GET',
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' }
    })
      .then(res => res.json())
      .then(data => {
        if (data && typeof data.count === 'number') {
          counter.textContent = '(' + data.count + ')';
        }
      })
      .catch(() => {
        // silently fail, keep default (0)
      });
  })();
</script>
