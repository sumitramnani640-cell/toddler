}

/* Links */
.footer-links a {
  display: block;
  color: #333;
  font-size: 14px;
  margin-bottom: 8px;
  text-decoration: none;
}
.footer-links a:hover {
  color: #0b662e;
  text-decoration: underline;
}

/* Newsletter */
.newsletter-box input {
  border: 1px solid #ccc;
  border-radius: 4px;
}
.newsletter-box button {
