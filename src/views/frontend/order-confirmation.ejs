<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || "Order Confirmation" %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    body, html { height:100%; margin:0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background:#fff; color:#222; }
    .wrap { min-height:100%; display:flex; flex-direction:column; }
    .content { flex:1; display:flex; align-items:center; justify-content:center; padding:60px 20px; }
    .card-confirm { max-width:920px; width:100%; text-align:center; padding:40px 32px; border-radius:8px; box-shadow:0 6px 30px rgba(0,0,0,0.06); background: linear-gradient(180deg,#ffffff, #fbfdff); }
    .check-circle { width:92px; height:92px; display:inline-flex; align-items:center; justify-content:center; border-radius:50%; background:#2f9b66; color:#fff; font-size:40px; margin-bottom:18px; }
    h2 { font-weight:700; margin-bottom:6px; }
    .muted { color:#666; margin-bottom:14px; }
    .order-meta { margin-top:18px; background:#f8faf8; border:1px solid #eee; padding:12px 16px; border-radius:6px; display:inline-block; text-align:left; min-width:260px; }
    .order-meta div { margin-bottom:6px; }
    .btn-continue { background:#2f9b66; color:#fff; border:none; padding:10px 20px; border-radius:6px; }
    footer { padding:20px 0; text-align:center; font-size:0.9rem; color:#777; }
    .items-list { text-align:left; margin-top:14px; }
    .items-list .item { display:flex; gap:12px; align-items:center; padding:8px 0; border-bottom:1px dashed #eee; }
    .items-list img { width:56px; height:56px; object-fit:cover; border-radius:6px; }
    .items-list .title { font-weight:600; }
    .items-list .meta { color:#666; font-size:0.9rem; }
    @media (max-width: 768px) { .card-confirm { padding:20px; } }
  </style>
</head>
<body>
  <%- include('layouts/header') %>

  <div class="wrap">
    <div class="content">
      <div class="card-confirm">
        <div class="check-circle">
          <i class="fas fa-check"></i>
        </div>

        <h2>YOUR ORDER HAS BEEN PLACED!</h2>
        <p class="muted">Thanks — we received your order and are preparing it now.</p>

        <% if (typeof order !== 'undefined' && order) { %>
          <div class="order-meta">
            <div><strong>Order #</strong>: <%= order.id || order.orderNumber || '—' %></div>

            <% if (order.items && Array.isArray(order.items) && order.items.length) { %>
              <div><strong>Items:</strong></div>
              <div class="items-list">
                <% order.items.forEach(function(it){ %>
                  <div class="item">
                    <% if (it.imageUrl || it.image) { %>
                      <img src="<%= (it.imageUrl || it.image) %>" alt="item">
                    <% } else { %>
                      <img src="/images/placeholder.png" alt="item">
                    <% } %>
                    <div>
                      <div class="title"><%= it.name || it.product_name || 'Product' %></div>
                      <div class="meta">Qty: <%= Number(it.qty || it.quantity || 0) %> &middot; AED <%= Number(it.price || it.unit_price || 0).toFixed(2) %></div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <% if (order.totalAmount || order.total) { %>
              <div><strong>Total:</strong> AED <%= (order.totalAmount || order.total).toFixed ? (order.totalAmount || order.total).toFixed(2) : (order.totalAmount || order.total) %></div>
            <% } %>

            <% if (order.createdAt) { %>
              <div><strong>Placed on:</strong> <%= new Date(order.createdAt).toLocaleString() %></div>
            <% } %>

            <% if (order.screenshotUrl || order.screenshot_url) { %>
              <div>
                <!-- <a href="<%= order.screenshotUrl || order.screenshot_url %>" target="_blank" class="small">View receipt / screenshot</a> -->
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="order-meta">
            <div>Your order has been received. You will receive a confirmation email shortly.</div>
          </div>
        <% } %>

        <div style="margin-top:22px;">
          <a href="/" class="btn btn-continue">Continue Shopping</a>
          <a href="/order-history" class="btn btn-outline-secondary ms-2">View Orders</a>
          <a href="/contact" class="btn btn-outline-secondary ms-2">Contact Support</a>
        </div>
      </div>
    </div>

    <footer>
      © <%= new Date().getFullYear() %> Savers Grocery — All Rights Reserved
    </footer>
  </div>

  <%- include('layouts/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/js/all.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    (function(){
      // show a small toast or modal if you want; server already renders details
      document.addEventListener('DOMContentLoaded', function(){
        // optional small toast (uncomment if desired)
        // Swal.fire({ icon:'success', title:'Order placed', text:'Thanks — your order is confirmed.' });
      });
    })();
  </script>
</body>
</html>
