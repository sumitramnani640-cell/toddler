<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= product.name %> - Savers Grocery</title>

  <!-- Libraries -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/frontend/css/style.css">
</head>
<body>

  <!-- ✅ HEADER START -->
  <header>
    <!-- Top bar -->
    <div class="top-bar bg-success text-white small">
      <div class="container d-flex align-items-center justify-content-between py-1">
        <div class="d-flex align-items-center gap-3">
          <div><i class="fas fa-shipping-fast me-2"></i> Fast &amp; Free Delivery</div>
          <div class="d-none d-md-flex align-items-center">
            <i class="fas fa-store me-2"></i> Shop from over thousand products
          </div>
        </div>
        <div class="d-flex align-items-center gap-3">
          <div class="d-none d-md-flex align-items-center">
            <i class="fas fa-phone me-2"></i>
            <a href="tel:+971542526215" class="text-white text-decoration-none">+971-542526215</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Main header -->
    <div class="main-header bg-white border-bottom">
      <div class="container d-flex align-items-center justify-content-between py-3">
        <!-- Logo -->
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-light d-md-none" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
            <i class="fas fa-bars"></i>
          </button>
          <a href="/" class="text-black fw-bold fs-4 text-decoration-none d-flex align-items-center">
            <i class="fas fa-shopping-cart me-2"></i> Savers Grocery
          </a>
        </div>

        <!-- Search bar -->
        <div class="flex-fill px-3 d-none d-md-block">
          <form action="/search" method="GET" class="d-flex">
            <input name="q" class="form-control me-2" type="search" placeholder="Search Products">
            <button class="btn btn-success" type="submit"><i class="fas fa-search"></i></button>
          </form>
        </div>

        <!-- User + Cart -->
        <div class="d-flex align-items-center gap-2">
          <a href="/login" class="d-flex align-items-center text-decoration-none text-dark">
            <i class="fas fa-user-circle fs-5 me-1"></i>
            <span class="d-none d-lg-inline">Login &amp; Register</span>
          </a>
          <a href="/cart" class="btn btn-outline-secondary position-relative">
            <i class="fas fa-shopping-cart"></i>
            <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Sub info bar -->
    <div class="sub-bar bg-success text-white small">
      <div class="container d-flex align-items-center justify-content-between py-1">
        <div><i class="fas fa-clock me-2"></i> Next Standard Delivery Today <strong>6:00 PM–10:00 PM</strong></div>
        <div><i class="fas fa-map-marker-alt me-1"></i> Deliver to: <strong>Dubai Festival City – Dubai</strong></div>
      </div>
    </div>

    <!-- Breadcrumb / category -->
    <div class="category-nav border-top bg-light">
      <div class="container">
        <nav class="nav py-2 overflow-auto align-items-center">
          <a class="nav-link px-2 d-flex align-items-center" href="/">
            <i class="fas fa-home me-1"></i> Home
          </a>

          <% if (product.category) { %>
            <!-- if category.slug doesn't exist, fallback to id -->
            <a class="nav-link px-2 text-secondary" href="/shop/<%= product.category.slug || product.category.id %>">
              <i class="fas fa-angle-right mx-1"></i> <%= product.category.name %>
            </a>
          <% } %>

          <span class="nav-link px-2 fw-bold text-dark">
            <i class="fas fa-angle-right text-secondary mx-1"></i>
            <%= product.name %>
          </span>
        </nav>
      </div>
    </div>

    <!-- Offcanvas -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
      </div>
      <div class="offcanvas-body">
        <ul class="list-unstyled">
          <li><a href="/" class="d-block py-2 text-dark">Home</a></li>
          <% if (typeof categories !== 'undefined') { %>
            <% categories.forEach(cat => { %>
              <li><a href="/shop/<%= cat.slug || cat.id %>" class="d-block py-2 text-dark"><%= cat.name %></a></li>
            <% }) %>
          <% } %>
        </ul>
      </div>
    </div>

    <style>
      .top-bar, .sub-bar { background-color: #2f8a4a; }
      .product-img { object-fit: contain; max-height: 320px; }
    </style>
  </header>
  <!-- ✅ HEADER END -->


  <!-- ✅ PRODUCT DETAILS -->
  <div class="container py-5">
    <div class="row g-4 align-items-start">
      <!-- Image -->
      <div class="col-md-5 text-center">
        <% 
          // product.image may already be a full path (/uploads/...), or just a filename.
          const productImage = product.image
            ? (product.image.startsWith('/') ? product.image : '/uploads/products/' + product.image)
            : '/uploads/products/placeholder.jpg';
        %>
        <img src="<%= productImage %>"
             class="img-fluid border rounded product-img"
             alt="<%= product.name %>">
      </div>

      <!-- Info -->
      <div class="col-md-7">
        <h2 class="fw-bold mb-3"><%= product.name %></h2>
        <% if (product.category) { %>
          <p class="text-muted small mb-1">
            <i class="fas fa-tag me-1"></i>
            Category: <a href="/shop/<%= product.category.slug || product.category.id %>" class="text-success text-decoration-none"><%= product.category.name %></a>
          </p>
        <% } %>
        <h4 class="text-success fw-bold mb-3">₹<%= product.price %></h4>

        <% if (product.stock > 0) { %>
          <p class="text-success mb-3"><i class="fas fa-check-circle me-1"></i> In Stock</p>
        <% } else { %>
          <p class="text-danger mb-3"><i class="fas fa-times-circle me-1"></i> Out of Stock</p>
        <% } %>

        <p class="mb-4"><%= product.description || 'No description available.' %></p>

        <div class="d-flex align-items-center gap-3">
          <!-- Add-to-cart posts product id so backend can handle without slug -->
          <form action="/cart/add" method="POST" class="d-inline">
            <input type="hidden" name="productId" value="<%= product.id %>">
            <button type="submit" class="btn btn-success px-4 py-2">
              <i class="fas fa-cart-plus me-2"></i> Add to Cart
            </button>
          </form>

          <button class="btn btn-outline-dark px-4 py-2">
            <i class="fas fa-heart me-2"></i> Wishlist
          </button>
        </div>
      </div>
    </div>
  </div>


  <!-- ✅ RELATED PRODUCTS -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
  <div class="container py-5 border-top">
    <h4 class="fw-bold mb-4">Related Products</h4>
    <div class="row g-4">
      <% relatedProducts.forEach(p => { %>
        <% 
          const pImage = p.image ? (p.image.startsWith('/') ? p.image : '/uploads/products/' + p.image) : '/uploads/products/placeholder.jpg';
        %>
        <div class="col-md-3 col-6">
          <div class="card shadow-sm h-100">
            <img src="<%= pImage %>" class="card-img-top" alt="<%= p.name %>">
            <div class="card-body text-center">
              <h6 class="fw-bold text-truncate"><%= p.name %></h6>
              <p class="text-success fw-bold">₹<%= p.price %></p>
              <!-- Link by ID to avoid requiring slug column -->
              <a href="/product/<%= p.id %>" class="btn btn-dark btn-sm w-100">View Product</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>


  <!-- ✅ FOOTER -->
  <footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="m-0">© 2025 Savers Grocery. All Rights Reserved.</p>
  </footer>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
