<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= product?.name ? product.name + ' - Savers Grocery' : 'Product - Savers Grocery' %></title>

  <!-- Libraries -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/frontend/css/style.css">
</head>
<body>

  <!-- ✅ HEADER -->
  <header>
    <div class="top-bar bg-success text-white small">
      <div class="container d-flex align-items-center justify-content-between py-1">
        <div class="d-flex align-items-center gap-3">
          <div><i class="fas fa-shipping-fast me-2"></i> Fast &amp; Free Delivery</div>
          <div class="d-none d-md-flex align-items-center">
            <i class="fas fa-store me-2"></i> Shop from over thousand products
          </div>
        </div>
        <div class="d-flex align-items-center gap-3">
          <div class="d-none d-md-flex align-items-center">
            <i class="fas fa-phone me-2"></i>
            <a href="tel:+971542526215" class="text-white text-decoration-none">+971-542526215</a>
          </div>
        </div>
      </div>
    </div>

    <div class="main-header bg-white border-bottom">
      <div class="container d-flex align-items-center justify-content-between py-3">
        <a href="/" class="text-black fw-bold fs-4 text-decoration-none d-flex align-items-center">
          <i class="fas fa-shopping-cart me-2"></i> Savers Grocery
        </a>

        <div class="flex-fill px-3 d-none d-md-block">
          <form action="/search" method="GET" class="d-flex">
            <input name="q" class="form-control me-2" type="search" placeholder="Search Products">
            <button class="btn btn-success" type="submit"><i class="fas fa-search"></i></button>
          </form>
        </div>

    
          <!-- LOGIN -->
     <!-- AUTH / USER MENU -->
<% if (typeof user !== 'undefined' && user) { %>
  <div class="d-flex align-items-center gap-3">
    <a href="/account" class="text-decoration-none" style="color:#0b662e;">
      <i class="fas fa-user me-1"></i> <%= user.name || user.email || 'My Account' %>
    </a>

    <button id="logoutBtn" class="btn btn-danger btn-sm w-100">
    <i class="fa fa-sign-out-alt me-1"></i> Logout
</button>

<!-- Hidden form -->
<form id="logoutForm" action="/logout" method="POST" class="d-none"></form>

</form>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.getElementById("logoutBtn")?.addEventListener("click", function (e) {
    e.preventDefault();

    Swal.fire({
        title: 'Logout?',
        text: 'Do you want to log out from your account?',
        icon: 'warning',
        width: '320px',
        padding: '0.8rem',
        showCancelButton: true,
        confirmButtonText: 'Logout',
        cancelButtonText: 'Cancel',
        buttonsStyling: false,
        customClass: {
            popup: 'rounded-3',
            confirmButton: 'btn btn-danger me-2',
            cancelButton: 'btn btn-secondary'
        }
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById("logoutForm").submit();
        }
    });
});
</script>
  </div>
<% } else { %>
  <a href="/login" class="d-flex align-items-center text-decoration-none" style="color:#0b662e;">
    <i class="fas fa-user me-1"></i> Login & Register
  </a>
<% } %>
         <a href="/cart" class="position-relative" style="color:#0b662e;">
        <i class="fas fa-shopping-cart fa-lg"></i>
        <span class="badge bg-warning text-dark position-absolute top-0 start-100 translate-middle">
          <%= cartCount || 0 %>
        </span>
      </a>
        </div>
      </div>
    </div>

    <div class="sub-bar bg-success text-white small">
      <div class="container d-flex align-items-center justify-content-between py-1">
        <div><i class="fas fa-clock me-2"></i> Next Standard Delivery Today <strong>6:00 PM–10:00 PM</strong></div>
        <div><i class="fas fa-map-marker-alt me-1"></i> Deliver to: <strong>Dubai Festival City – Dubai</strong></div>
      </div>
    </div>

    <style>
      .top-bar, .sub-bar { background-color: #2f8a4a; }
      .product-img { object-fit: contain; max-height: 320px; }
    </style>
  </header>
  <!-- ✅ END HEADER -->


  <!-- ✅ PRODUCT DETAILS -->
  <div class="container py-5">
    <div class="row g-4 align-items-start">
      <!-- Product Image -->
      <div class="col-md-5 text-center">
        <% const imagePath = product?.image ? (product.image.startsWith('/') ? product.image : '/uploads/products/' + product.image) : '/uploads/products/placeholder.jpg'; %>
        <img src="<%= imagePath %>" alt="<%= product?.name || 'Product' %>" class="img-fluid border rounded product-img">
      </div>

      <!-- Product Info -->
      <div class="col-md-7">
        <h2 class="fw-bold mb-3"><%= product?.name || 'Unnamed Product' %></h2>

        <% if (product?.category) { %>
          <p class="text-muted small mb-2">
            <i class="fas fa-tag me-1"></i> Category:
            <a href="/shop/<%= product.category.slug || product.category.id %>" class="text-success text-decoration-none"><%= product.category.name %></a>
          </p>
        <% } %>

        <h4 class="text-success fw-bold mb-3">₹<%= product?.price ? Number(product.price).toFixed(2) : '0.00' %></h4>

        <% if (product?.stock > 0) { %>
          <p class="text-success mb-3"><i class="fas fa-check-circle me-1"></i> In Stock</p>
        <% } else { %>
          <p class="text-danger mb-3"><i class="fas fa-times-circle me-1"></i> Out of Stock</p>
        <% } %>

        <!-- <p class="mb-4"><%= product?.description || 'No description available.' %></p> -->

        <div class="d-flex align-items-center gap-3">
          <% if (product?.id) { %>
            <form action="/cart/add" method="POST" class="d-inline">
              <input type="hidden" name="productId" value="<%= product.id %>">
              <button type="submit" class="btn btn-success px-4 py-2">
                <i class="fas fa-cart-plus me-2"></i> Add to Cart
              </button>
            </form>
          <% } else { %>
            <button class="btn btn-secondary px-4 py-2" disabled>
              <i class="fas fa-cart-plus me-2"></i> Add to Cart
            </button>
          <% } %>

          <button class="btn btn-outline-dark px-4 py-2">
            <i class="fas fa-heart me-2"></i> Wishlist
          </button>
        </div>
      </div>
    </div>
  </div>
  <br>


  <div>
    <div class="container pb-5">
      <h4 class="fw-bold mb-4">Product Description</h4>
      <p><%= product?.description || 'No description available.' %></p>
    </div>
  </div>


  <!-- ✅ RELATED PRODUCTS -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
  <div class="container py-5 border-top">
    <h4 class="fw-bold mb-4">Related Products</h4>
    <div class="row g-4">
      <% relatedProducts.slice(0, 4).forEach(p => { %>
        <% const relImg = p?.image ? (p.image.startsWith('/') ? p.image : '/uploads/products/' + p.image) : '/uploads/products/placeholder.jpg'; %>
        <div class="col-md-3 col-6">
          <div class="card shadow-sm h-100">
            <img src="<%= relImg %>" class="card-img-top" alt="<%= p?.name || 'Product' %>">
            <div class="card-body text-center">
              <h6 class="fw-bold text-truncate"><%= p?.name || 'Unnamed' %></h6>
              <p class="text-success fw-bold">₹<%= p?.price ? Number(p.price).toFixed(2) : '0.00' %></p>

              <% if (p?.id) { %>
                <a href="/product/<%= p.slug %>" class="btn btn-dark btn-sm w-100">View Product</a>
              <% } else { %>
                <button class="btn btn-secondary btn-sm w-100" disabled>View Product</button>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>


  <!-- ✅ FOOTER -->
  <footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="m-0">© 2025 Savers Grocery. All Rights Reserved.</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Prevent navigation to /product/ with no ID -->
  <script>
    document.addEventListener('click', e => {
      const link = e.target.closest('a');
      if (link && /\/product\/\s*$/.test(link.getAttribute('href') || '')) {
        e.preventDefault();
        alert('Product not available.');
      }
    });
  </script>
</body>
</html>
