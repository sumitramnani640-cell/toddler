<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= product?.name ? product.name + ' - Savers Grocery' : 'Product - Savers Grocery' %></title>

  <!-- Libraries -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/frontend/css/style.css">
</head>
<body>

   <%- include("layouts/header") %>
 <!-- CATEGORIES BAR -->
<div class="categories-bar py-2">
  <div class="container d-flex align-items-center gap-4 flex-wrap">


    <!-- Dynamic Category List -->
    <div class="d-flex align-items-center gap-4 flex-wrap">
      <% categories.slice(0, 8).forEach(cat => { %>
        <a href="/category/<%= cat.slug %>" class="category-link text-dark">
          <%= cat.name %>
        </a>
      <% }) %>
    </div>

  </div>
</div>


  <!-- ✅ PRODUCT DETAILS -->
  <div class="container py-5">
    <div class="row g-4 align-items-start">
      <!-- Product Image -->
      <div class="col-md-5 text-center">
        <% const imagePath = product?.image ? (product.image.startsWith('/') ? product.image : '/uploads/products/' + product.image) : '/uploads/products/placeholder.jpg'; %>
        <img src="<%= imagePath %>" alt="<%= product?.name || 'Product' %>" class="img-fluid border rounded product-img">
      </div>

      <!-- Product Info -->
      <div class="col-md-7">
        <h2 class="fw-bold mb-3"><%= product?.name || 'Unnamed Product' %></h2>

        <% if (product?.category) { %>
          <p class="text-muted small mb-2">
            <i class="fas fa-tag me-1"></i> Category:
            <a href="/shop/<%= product.category.slug || product.category.id %>" class="text-success text-decoration-none"><%= product.category.name %></a>
          </p>
        <% } %>

        <h4 class="text-success fw-bold mb-3">₹<%= product?.price ? Number(product.price).toFixed(2) : '0.00' %></h4>

        <% if (product?.stock > 0) { %>
          <p class="text-success mb-3"><i class="fas fa-check-circle me-1"></i> In Stock</p>
        <% } else { %>
          <p class="text-danger mb-3"><i class="fas fa-times-circle me-1"></i> Out of Stock</p>
        <% } %>

        <!-- <p class="mb-4"><%= product?.description || 'No description available.' %></p> -->

        <div class="d-flex align-items-center gap-3">
          <% if (product?.id) { %>
            <form action="/cart/add" method="POST" class="d-inline">
              <input type="hidden" name="productId" value="<%= product.id %>">
              <button type="submit" class="btn btn-success px-4 py-2">
                <i class="fas fa-cart-plus me-2"></i> Add to Cart
              </button>
            </form>
          <% } else { %>
            <button class="btn btn-secondary px-4 py-2" disabled>
              <i class="fas fa-cart-plus me-2"></i> Add to Cart
            </button>
          <% } %>

          <button class="btn btn-outline-dark px-4 py-2">
            <i class="fas fa-heart me-2"></i> Wishlist
          </button>
        </div>
      </div>
    </div>
  </div>
  <br>


  <div>
    <div class="container pb-5">
      <h4 class="fw-bold mb-4">Product Description</h4>
      <p><%= product?.description || 'No description available.' %></p>
    </div>
  </div>


  <!-- ✅ RELATED PRODUCTS -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
  <div class="container py-5 border-top">
    <h4 class="fw-bold mb-4">Related Products</h4>
    <div class="row g-4">
      <% relatedProducts.slice(0, 4).forEach(p => { %>
        <% const relImg = p?.image ? (p.image.startsWith('/') ? p.image : '/uploads/products/' + p.image) : '/uploads/products/placeholder.jpg'; %>
        <div class="col-md-3 col-6">
          <div class="card shadow-sm h-100">
            <img src="<%= relImg %>" class="card-img-top" alt="<%= p?.name || 'Product' %>">
            <div class="card-body text-center">
              <h6 class="fw-bold text-truncate"><%= p?.name || 'Unnamed' %></h6>
              <p class="text-success fw-bold">₹<%= p?.price ? Number(p.price).toFixed(2) : '0.00' %></p>

              <% if (p?.id) { %>
                <a href="/product/<%= p.slug %>" class="btn btn-dark btn-sm w-100">View Product</a>
              <% } else { %>
                <button class="btn btn-secondary btn-sm w-100" disabled>View Product</button>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>


  <!-- ✅ FOOTER -->
   <%- include("layouts/footer") %>

  <!-- Prevent navigation to /product/ with no ID -->
  <script>
    document.addEventListener('click', e => {
      const link = e.target.closest('a');
      if (link && /\/product\/\s*$/.test(link.getAttribute('href') || '')) {
        e.preventDefault();
        alert('Product not available.');
      }
    });
  </script>
</body>
</html>
