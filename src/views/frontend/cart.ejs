<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || "Shopping Cart" %></title>

  <!-- Bootstrap + Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">



  <%- include("layouts/header") %>

  <!-- ========== SHOPPING CART SECTION ========== -->
  <div class="container py-4">

    <h4 class="fw-bold mb-3">Shopping Cart</h4>

    <div class="row g-4">
      <!-- LEFT CART ITEMS -->
      <div class="col-lg-8">

        <% if (!cart || !cart.items || cart.items.length === 0) { %>
          <div class="alert alert-info">Your cart is empty.</div>
        <% } else { %>

          <% cart.items.forEach(item => { %>
            <div class="cart-item-box d-flex gap-3">

              <img src="<%= item.imageUrl %>" class="cart-thumb">

              <div class="flex-grow-1">
                <h6><%= item.name %></h6>
                <div class="text-muted small"><%= item.sku || '' %></div>
                <div class="fw-bold text-success">AED <%= item.price %></div>

               <div class="d-flex align-items-center mt-2 gap-2">

  <!-- UPDATE QTY -->
  <form method="POST" action="/cart/update" class="d-flex gap-2 align-items-center">
  <!-- must send productId because controller reads req.body.productId -->
  <input type="hidden" name="productId" value="<%= item.productId %>">

  <!-- decrement -> submits form with op=dec -->
  <button type="submit" name="op" value="dec" class="btn btn-light border px-2">-</button>

  <!-- numeric qty (Enter will submit form) -->
  <input type="number" name="qty" value="<%= item.qty %>" min="0" class="form-control text-center" style="width:60px;">

  <!-- increment -> submits form with op=inc -->
  <button type="submit" name="op" value="inc" class="btn btn-light border px-2">+</button>
</form>


  <!-- REMOVE ITEM -->
  <form action="/cart/remove" method="POST">
    <input type="hidden" name="productId" value="<%= item.productId %>">
    <button class="btn btn-outline-danger btn-sm">
      <i class="fas fa-trash"></i>
    </button>
  </form>

</div>

              </div>

            </div>
          <% }) %>

          <!-- COUPON -->
          <div class="mt-4">
            <h6>USE COUPON CODE</h6>
            <form method="POST" action="/cart/apply-coupon" class="row g-2">
              <div class="col-md-8"><input type="text" name="coupon" class="form-control"></div>
              <div class="col-md-4"><button class="btn btn-success w-100">Apply Coupon</button></div>
            </form>
          </div>

        <% } %>

      </div>

      <!-- RIGHT SUMMARY -->
      <div class="col-lg-4">
        <div class="promo-box mb-3">
          <strong>Free delivery over AED 200</strong><br>
          <small>When you choose Standard grocery delivery</small>
        </div>

        <div class="summary-box">
          <h6>Order Summary</h6>

          <div class="d-flex justify-content-between">
            <span>Subtotal:</span>
            <span>AED <%= subtotal.toFixed(2) %></span>
          </div>

          <div class="d-flex justify-content-between">
            <span>VAT (5%):</span>
            <span>AED <%= vat.toFixed(2) %></span>
          </div>

          <hr>

          <div class="d-flex justify-content-between fw-bold">
            <span>Total:</span>
            <span>AED <%= total.toFixed(2) %></span>
          </div>
<!-- Use a GET form -->
<form action="/checkout" method="GET">
  <button type="submit" class="btn btn-danger">CHECKOUT ALL</button>
</form>

          <div class="alert alert-warning small mt-3">
            A minimum order of AED150 is required for groceries.
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- 🔥 FOOTER ( SAME AS HOME PAGE ) -->
  <%- include("layouts/footer") %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
