<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || "Shopping Cart" %></title>

  <!-- Bootstrap + Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    /* basic cart styles (kept concise) */
    .cart-item-box { display:flex; gap:16px; align-items:flex-start; padding:12px; border:1px solid #eee; border-radius:8px; margin-bottom:12px; background:#fff; }
    .cart-thumb { width:96px; height:96px; object-fit:cover; border-radius:6px; }
    .promo-box { background:#e8f7ea; border-left:4px solid #0b662e; padding:12px; border-radius:6px; }
    .summary-box { border:1px solid #eee; padding:16px; border-radius:8px; background:#fff; }
    .btn-qty { width:36px; height:36px; display:inline-flex; align-items:center; justify-content:center; }
    .small-muted { font-size:0.9rem; color:#6b6b6b; }
    @media (max-width: 768px){ .cart-thumb{ width:72px; height:72px } }
  </style>
</head>
<body>

  <!-- header (shared) -->
  <%- include("layouts/header") %>

  <!-- ========== SHOPPING CART SECTION ========== -->
  <div class="container py-4">

    <h4 class="fw-bold mb-3">Shopping Cart</h4>

    <div class="row g-4">
      <!-- LEFT CART ITEMS -->
      <div class="col-lg-8">

        <% if (!cart || !Array.isArray(cart.items) || cart.items.length === 0) { %>
          <div class="alert alert-info">Your cart is empty.</div>
        <% } else { %>

          <% cart.items.forEach(function(item){ %>
            <div class="cart-item-box">

              <img src="<%= item.imageUrl || '/images/no-image.png' %>" alt="<%= item.name %>" class="cart-thumb">

              <div class="flex-grow-1">
                <h6 class="mb-1"><%= item.name %></h6>
                <% if (item.sku) { %><div class="text-muted small mb-1"><%= item.sku %></div><% } %>
                <div class="fw-bold text-success mb-2">AED <%= (Number(item.price) || 0).toFixed(2) %></div>

                <div class="d-flex align-items-center gap-3 flex-wrap">

                  <!-- UPDATE QTY: this form posts productId + qty and op (inc/dec) -->
                  <form method="POST" action="/cart/update" class="d-flex gap-2 align-items-center">
                    <input type="hidden" name="productId" value="<%= item.productId %>">

                    <button type="submit" name="op" value="dec" class="btn btn-light border btn-qty">-</button>

                    <input type="number" name="qty" value="<%= Number(item.qty || 1) %>" min="0" class="form-control text-center" style="width:80px;">

                    <button type="submit" name="op" value="inc" class="btn btn-light border btn-qty">+</button>
                  </form>

                  <!-- REMOVE ITEM -->
                  <form action="/cart/remove" method="POST" style="margin:0;">
                    <input type="hidden" name="productId" value="<%= item.productId %>">
                    <button class="btn btn-outline-danger btn-sm" title="Remove item">
                      <i class="fas fa-trash"></i>
                    </button>
                  </form>

                </div>
              </div>

            </div>
          <% }) %>

          <!-- COUPON -->
          <div class="mt-4">
            <h6>USE COUPON CODE</h6>
            <form method="POST" action="/cart/apply-coupon" class="row g-2">
              <div class="col-md-8"><input type="text" name="coupon" class="form-control" placeholder="Enter coupon code"></div>
              <div class="col-md-4"><button class="btn btn-success w-100">Apply Coupon</button></div>
            </form>
          </div>

        <% } %>

      </div>

      <!-- RIGHT SUMMARY -->
      <div class="col-lg-4">
        <div class="promo-box mb-3">
          <strong>Free delivery over AED 200</strong><br>
          <small>When you choose Standard grocery delivery</small>
        </div>

        <div class="summary-box">
          <h6>Order Summary</h6>

          <div class="d-flex justify-content-between">
            <span>Subtotal:</span>
            <span>AED <%= (typeof subtotal !== 'undefined' ? Number(subtotal) : (cart && cart.subtotal) || 0).toFixed(2) %></span>
          </div>

          <div class="d-flex justify-content-between">
            <span>VAT (5%):</span>
            <span>AED <%= (typeof vat !== 'undefined' ? Number(vat) : (cart && cart.vat) || 0).toFixed(2) %></span>
          </div>

          <hr>

          <div class="d-flex justify-content-between fw-bold">
            <span>Total:</span>
            <span>AED <%= (typeof total !== 'undefined' ? Number(total) : (cart && cart.total) || 0).toFixed(2) %></span>
          </div>

          <!-- Use GET to go to checkout (your routes expect GET /checkout to show checkout page) -->
          <form action="/checkout" method="GET" class="mt-3">
            <button type="submit" class="btn btn-danger w-100">CHECKOUT ALL</button>
          </form>

          <div class="alert alert-warning small mt-3 mb-0">
            A minimum order of AED150 is required for groceries.
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- FOOTER -->
  <%- include("layouts/footer") %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Optional: update the cart badge (header) if it exists, using server-provided cartCount
    (function(){
      var badge = document.getElementById('cartBadge') || document.getElementById('cart-badge') || document.querySelector('.badge[data-cart-badge]');
      try {
        var count = <%= (typeof cartCount !== 'undefined' ? Number(cartCount) : (cart && Array.isArray(cart.items) ? cart.items.length : 0)) %>;
        if (badge) badge.textContent = count;
      } catch (e) {
        // ignore template parse if cartCount missing
      }
    })();
  </script>
</body>
</html>
