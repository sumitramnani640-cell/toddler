<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">
          <i class="fas fa-gift mr-2"></i>
          Product Feature - <%= feature.name %>
        </h3>

        <div class="card-tools">
          <a href="/admin/product-features/<%= feature.id %>/edit" class="btn btn-warning btn-sm">
            <i class="fas fa-edit mr-1"></i> Edit
          </a>

          <form action="/admin/product-features/<%= feature.id %>?_method=DELETE" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete this product feature?');">
              <i class="fas fa-trash mr-1"></i> Delete
            </button>
          </form>

          <a href="/admin/product-features" class="btn btn-secondary btn-sm ml-2">
            <i class="fas fa-arrow-left mr-1"></i> Back
          </a>
        </div>
      </div>

      <div class="card-body">
        <div class="row">
          <!-- Left: Image -->
          <div class="col-md-4 text-center">
            <% if (feature.image) { %>
              <img src="/uploads/<%= feature.image %>" alt="<%= feature.name %>" class="img-fluid rounded" style="max-height:300px; object-fit:cover;">
            <% } else { %>
              <div class="border rounded py-5">
                <i class="fas fa-image fa-3x text-muted"></i>
                <p class="text-muted mt-2">No image</p>
              </div>
            <% } %>
          </div>

          <!-- Right: Details -->
          <div class="col-md-8">
            <h4><%= feature.name %></h4>

            <p>
              <% if (feature.description) { %>
                <%= feature.description %>
              <% } else { %>
                <span class="text-muted">No description provided.</span>
              <% } %>
            </p>

            <dl class="row">
              <dt class="col-sm-4">Category</dt>
              <dd class="col-sm-8">
                <% if (feature.category && feature.category.name) { %>
                  <span class="badge badge-info"><%= feature.category.name %></span>
                <% } else { %>
                  <span class="text-muted">Unassigned</span>
                <% } %>
              </dd>

              <dt class="col-sm-4">Status</dt>
              <dd class="col-sm-8">
                <span class="badge badge-<%= feature.status === 'active' ? 'success' : 'secondary' %>">
                  <%= feature.status %>
                </span>
              </dd>

              <dt class="col-sm-4">Created At</dt>
              <dd class="col-sm-8"><%= new Date(feature.createdAt).toLocaleString() %></dd>

              <dt class="col-sm-4">Last Updated</dt>
              <dd class="col-sm-8"><%= new Date(feature.updatedAt).toLocaleString() %></dd>
            </dl>
          </div>
        </div>

        <!-- Optional: related products / items list -->
        <% if (feature.products && feature.products.length > 0) { %>
          <hr>
          <h5>Related Products</h5>
          <div class="row">
            <% feature.products.forEach(p => { %>
              <div class="col-sm-6 col-md-4 mb-3">
                <div class="card h-100">
                  <% if (p.image) { %>
                    <img src="/uploads/<%= p.image %>" class="card-img-top" style="height:140px; object-fit:cover;" alt="<%= p.name %>">
                  <% } %>
                  <div class="card-body">
                    <h6 class="card-title mb-1"><%= p.name %></h6>
                    <p class="small text-muted mb-0"><%= p.description ? p.description.substring(0, 60) + '...' : '' %></p>
                  </div>
                  <div class="card-footer text-right">
                    <a href="/admin/products/<%= p.id %>" class="btn btn-sm btn-outline-primary">View</a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>

      </div>
    </div>
  </div>
</div>
