<div class="row">
  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">
          <i class="fas fa-info-circle mr-2"></i> Product Feature Details
        </h3>
        <div class="card-tools">
          <a href="/admin/product-features/<%= feature.id %>/edit" class="btn btn-warning btn-sm">
            <i class="fas fa-edit mr-1"></i> Edit
          </a>
          <a href="/admin/product-features" class="btn btn-secondary btn-sm ms-2">Back</a>
        </div>
      </div>

      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-4">
            <% if (feature.image) { %>
              <img src="/uploads/<%= feature.image %>" alt="<%= feature.title %>" class="img-fluid rounded" style="max-height:240px;object-fit:cover;">
            <% } else { %>
              <div class="border rounded p-4 text-center text-muted">No image</div>
            <% } %>
          </div>

          <div class="col-md-8">
            <h4 class="mb-2"><%= feature.title %></h4>

            <p>
              <strong>Value:</strong>
              <span class="ms-2"><%= feature.value || '-' %></span>
            </p>

            <p>
              <strong>Product:</strong>
              <span class="ms-2">
                <% if (feature.product) { %>
                  <a href="/admin/products/<%= feature.product.id %>/edit"><%= feature.product.name %></a>
                <% } else { %>
                  <span class="text-muted">No product</span>
                <% } %>
              </span>
            </p>

            <p>
              <strong>Category:</strong>
              <span class="ms-2">
                <% if (feature.product && feature.product.category) { %>
                  <%= feature.product.category.name %>
                <% } else { %>
                  <span class="text-muted">No category</span>
                <% } %>
              </span>
            </p>

            <p>
              <strong>Status:</strong>
              <span class="ms-2">
                <span class="badge bg-<%= feature.status === 'active' ? 'success' : 'secondary' %>">
                  <%= feature.status %>
                </span>
              </span>
            </p>

            <% if (feature.createdAt) { %>
              <p class="text-muted small">Created: <%= new Date(feature.createdAt).toLocaleString() %></p>
            <% } %>
            <% if (feature.updatedAt) { %>
              <p class="text-muted small">Updated: <%= new Date(feature.updatedAt).toLocaleString() %></p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
