<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-gift mr-2"></i>
          <%= action === 'edit' ? 'Edit Product Feature' : 'Add New Product Feature' %>
        </h3>
      </div>

      <form
        action="<%= action === 'edit' ? ('/admin/product-features/' + feature.id) : '/admin/product-features' %>"
        method="POST"
        enctype="multipart/form-data"
      >
        <div class="card-body">
          <!-- Name -->
          <div class="form-group">
            <label for="name">Feature Name <span class="text-danger">*</span></label>
            <input type="text" id="name" name="name" class="form-control" required
                   value="<%= feature && feature.name ? feature.name : '' %>" placeholder="Enter feature name">
            <small class="form-text text-muted">Short, clear name for the feature.</small>
          </div>

          <!-- Description -->
          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" class="form-control" rows="4" placeholder="Optional description"><%= feature && feature.description ? feature.description : '' %></textarea>
          </div>

          <!-- Category select (if categories provided) -->
          <div class="form-group">
            <label for="categoryFeatureId">Category</label>
            <select id="categoryFeatureId" name="categoryFeatureId" class="form-control">
              <option value="">-- None / Unassigned --</option>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(c => { %>
                  <% 
                    const selectedCatId = (feature && (feature.categoryFeatureId || feature.category_id || (feature.category && feature.category.id) || (feature.categoryFeature && feature.categoryFeature.id))) || '';
                    const value = c.id;
                  %>
                  <option value="<%= value %>" <%= (String(selectedCatId) === String(value)) ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
              <% } %>
            </select>
            <small class="form-text text-muted">Assign this product feature to a category feature.</small>
          </div>

          <!-- Image upload + preview -->
          <div class="form-group">
            <label for="image">Image</label>
            <% if (feature && feature.image) { %>
              <div class="mb-2">
                <img src="/uploads/<%= feature.image %>" alt="current image" style="height:100px; object-fit:cover; border-radius:4px;">
              </div>
            <% } %>
            <input type="file" id="image" name="image" class="form-control-file">
            <small class="form-text text-muted">Optional. Recommended size: 800x600 or similar.</small>
          </div>

          <!-- Status -->
          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status" class="form-control">
              <option value="active" <%= feature && feature.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= feature && feature.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>
        </div>

        <div class="card-footer">
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-1"></i>
            <%= action === 'edit' ? 'Update Feature' : 'Create Feature' %>
          </button>
          <a href="/admin/product-features" class="btn btn-secondary ml-2">
            <i class="fas fa-times mr-1"></i> Cancel
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Sidebar guidelines -->
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="fas fa-info-circle mr-2"></i> Tips</h3>
      </div>
      <div class="card-body">
        <ul class="list-unstyled">
          <li><i class="fas fa-check text-success mr-2"></i>Keep names concise</li>
          <li><i class="fas fa-check text-success mr-2"></i>Provide short description for clarity</li>
          <li><i class="fas fa-image text-muted mr-2"></i>Upload a clear image (if applicable)</li>
          <li><i class="fas fa-toggle-on text-success mr-2"></i>Mark inactive features when not needed</li>
        </ul>
      </div>
    </div>
  </div>
</div>
