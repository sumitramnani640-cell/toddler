<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-gift mr-2"></i>Product Features Management
        </h3>
        <div class="card-tools">
          <a href="/admin/product-features/create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-1"></i> Add Product Feature
          </a>
        </div>
      </div>

      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>Feature Name</th>
                <th>Category Feature</th>
                <th>Link</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% if (products && products.length > 0) { %>
                <% products.forEach(product => { %>
                  <tr>
                    <td><%= product.id %></td>
                    <td><strong><%= product.name %></strong></td>
                    <td>
                      <%= product.category ? product.category.name : '<span class="text-muted">None</span>' %>
                    </td>
                    <td>
                      <% if (product.link) { %>
                        <a href="<%= product.link %>" target="_blank"><%= product.link %></a>
                      <% } else { %>
                        <span class="text-muted">No link</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge badge-<%= product.status === 'active' ? 'success' : 'secondary' %>">
                        <%= product.status %>
                      </span>
                    </td>
                    <td>
                      <div class="btn-group" role="group">
                        <a href="/admin/product-features/<%= product.id %>" class="btn btn-info btn-sm" title="View">
                          <i class="fas fa-eye"></i>
                        </a>
                        <a href="/admin/product-features/<%= product.id %>/edit" class="btn btn-warning btn-sm" title="Edit">
                          <i class="fas fa-edit"></i>
                        </a>
                        <form action="/admin/product-features/<%= product.id %>" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-danger btn-sm delete-btn" title="Delete">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center text-muted">No product features found</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
