<div class="row">
  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">
          <i class="fas fa-gift mr-2"></i>
          <%= action === 'edit' ? 'Edit Product Feature' : 'Add Product Feature' %>
        </h3>
        <div class="card-tools">
          <a href="/admin/product-features" class="btn btn-secondary btn-sm">Back to list</a>
        </div>
      </div>

      <div class="card-body">
        <form
          action="<%= action === 'edit' ? '/admin/product-features/' + feature.id + '?_method=PUT' : '/admin/product-features' %>"
          method="POST"
          enctype="multipart/form-data"
        >
          <div class="row g-3">
            <div class="col-md-6">
              <label for="productId" class="form-label">Product</label>
              <select id="productId" name="productId" class="form-select" required>
                <option value="">-- Select product --</option>
                <% if (products && products.length) { %>
                  <% products.forEach(function(prod) { %>
                    <option value="<%= prod.id %>" <%= (feature.product_id && feature.product_id === prod.id) || (feature.product && feature.product.id === prod.id) ? 'selected' : '' %> >
                      <%= prod.name %>
                    </option>
                  <% }) %>
                <% } %>
              </select>
            </div>

            <div class="col-md-6">
              <label for="title" class="form-label">Feature Title</label>
              <input id="title" name="title" type="text" class="form-control" required
                     value="<%= feature.title || '' %>">
            </div>

            <div class="col-md-6">
              <label for="value" class="form-label">Value</label>
              <input id="value" name="value" type="text" class="form-control"
                     value="<%= feature.value || '' %>">
            </div>

            <div class="col-md-6">
              <label for="status" class="form-label">Status</label>
              <select id="status" name="status" class="form-select">
                <option value="active" <%= feature.status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="inactive" <%= feature.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
              </select>
            </div>

            <div class="col-12">
              <label class="form-label">Feature Image</label>
              <% if (feature.image) { %>
                <div class="mb-2">
                  <img src="/uploads/<%= feature.image %>" alt="Feature image" style="width:140px;height:100px;object-fit:cover;border-radius:6px;">
                </div>
              <% } %>
              <input type="file" name="image" class="form-control">
            </div>

            <div class="col-12 text-end">
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-1"></i> <%= action === 'edit' ? 'Update' : 'Create' %>
              </button>
              <a href="/admin/product-features" class="btn btn-secondary ms-2">Cancel</a>
            </div>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>
