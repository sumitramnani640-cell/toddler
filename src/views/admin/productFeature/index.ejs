<div class="row">
  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">
          <i class="fas fa-gift mr-2"></i> Product Features Management
        </h3>
        <div class="card-tools">
          <a href="/admin/product-features/create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-1"></i> Add Product Feature
          </a>
        </div>
      </div>

      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped align-middle">
            <thead class="table-light">
              <tr>
                <th style="width:60px;">ID</th>
                <th>Feature Title</th>
                <th>Value</th>
                <th>Product</th>
                <th>Category</th>
                <th>Image</th>
                <th>Status</th>
                <th style="width:160px;">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% if (features && features.length > 0) { %>
                <% features.forEach(feature => { %>
                  <tr>
                    <td><%= feature.id %></td>

                    <!-- Feature Title -->
                    <td><strong><%= feature.title %></strong></td>

                    <!-- Value -->
                    <td>
                      <% if (feature.value) { %>
                        <%= feature.value %>
                      <% } else { %>
                        <span class="text-muted">No value</span>
                      <% } %>
                    </td>

                    <!-- Product -->
                    <td>
                      <% if (feature.product) { %>
                        <span class="badge bg-primary"><%= feature.product.name %></span>
                      <% } else { %>
                        <span class="text-muted">No product</span>
                      <% } %>
                    </td>

                    <!-- Category -->
                    <td>
                      <% if (feature.product && feature.product.category) { %>
                        <span class="badge bg-info text-dark">
                          <%= feature.product.category.name %>
                        </span>
                      <% } else { %>
                        <span class="text-muted">No category</span>
                      <% } %>
                    </td>

                    <!-- Image -->
                    <td>
                      <% if (feature.image) { %>
                        <img src="<%= feature.image %>" alt="<%= feature.title %>"
                             style="width:70px;height:50px;object-fit:cover;border-radius:4px;">
                      <% } else { %>
                        <span class="text-muted">No image</span>
                      <% } %>
                    </td>

                    <!-- Status -->
                    <td>
                      <span class="badge bg-<%= feature.status === 'active' ? 'success' : 'secondary' %>">
                        <%= feature.status %>
                      </span>
                    </td>

                    <!-- Actions -->
                    <td>
                      <div class="btn-group" role="group">
                        <a href="/admin/product-features/<%= feature.id %>" class="btn btn-info btn-sm" title="View">
                          <i class="fas fa-eye"></i>
                        </a>
                        <a href="/admin/product-features/<%= feature.id %>/edit" class="btn btn-warning btn-sm" title="Edit">
                          <i class="fas fa-edit"></i>
                        </a>
                        <form action="/admin/product-features/<%= feature.id %>?_method=DELETE" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-danger btn-sm" title="Delete"
                            onclick="return confirm('Are you sure you want to delete this product feature?');">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center text-muted py-4">
                    No product features found
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
