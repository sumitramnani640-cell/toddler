<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-gift mr-2"></i> Product Features Management
        </h3>
        <div class="card-tools">
          <a href="/admin/product-features/create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-1"></i> Add Product Feature
          </a>
        </div>
      </div>

      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>Feature Name</th>
                <th>Description</th>
                <th>Category</th>
                <th>Image</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% if (products && products.length > 0) { %>
                <% products.forEach(product => { %>
                  <tr>
                    <td><%= product.id %></td>
                    <td><strong><%= product.name %></strong></td>
                    <td>
                      <% if (product.description) { %>
                        <%= product.description.substring(0, 60) %>...
                      <% } else { %>
                        <span class="text-muted">No description</span>
                      <% } %>
                    </td>

                    <!-- Category Name -->
                    <td>
                      <% if (product.category && product.category.name) { %>
                        <span class="badge badge-info"><%= product.category.name %></span>
                      <% } else { %>
                        <span class="text-muted">No category</span>
                      <% } %>
                    </td>

                    <!-- Image -->
                    <td>
                      <% if (product.image) { %>
                        <img src="/uploads/<%= product.image %>" alt="<%= product.name %>" 
                          style="width:70px;height:50px;object-fit:cover;border-radius:4px;">
                      <% } else { %>
                        <span class="text-muted">No image</span>
                      <% } %>
                    </td>

                    <!-- Status -->
                    <td>
                      <span class="badge badge-<%= product.status === 'active' ? 'success' : 'secondary' %>">
                        <%= product.status %>
                      </span>
                    </td>

                    <!-- Actions -->
                    <td>
                      <div class="btn-group" role="group">
                        <a href="/admin/product-features/<%= product.id %>" class="btn btn-info btn-sm" title="View">
                          <i class="fas fa-eye"></i>
                        </a>
                        <a href="/admin/product-features/<%= product.id %>/edit" class="btn btn-warning btn-sm" title="Edit">
                          <i class="fas fa-edit"></i>
                        </a>
                        <form action="/admin/product-features/<%= product.id %>?_method=DELETE" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-danger btn-sm delete-btn" title="Delete"
                            onclick="return confirm('Are you sure you want to delete this product feature?');">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center text-muted">
                    No product features found
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
