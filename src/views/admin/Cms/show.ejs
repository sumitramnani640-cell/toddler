<div class="row">
  <div class="col-12">
    <div class="card shadow-sm">
      
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">
          <i class="fas fa-file-alt mr-2"></i>
          CMS Page Details
        </h3>

        <div class="card-tools">
          <% if (page) { %>

            <a href="/admin/cms/<%= page.id %>/edit" class="btn btn-warning btn-sm">
              <i class="fas fa-edit mr-1"></i> Edit
            </a>

            <form 
              action="/admin/cms/<%= page.id %>" 
              method="POST" 
              class="d-inline"
              onsubmit="return confirm('Are you sure you want to delete this page?');"
            >
              <button type="submit" class="btn btn-danger btn-sm">
                <i class="fas fa-trash mr-1"></i> Delete
              </button>
            </form>

          <% } %>

          <a href="/admin/cms" class="btn btn-secondary btn-sm ml-2">
            <i class="fas fa-arrow-left mr-1"></i> Back
          </a>
        </div>
      </div>

      <div class="card-body">
        <% if (!page) { %>

          <div class="alert alert-warning text-center">CMS Page not found.</div>

        <% } else { %>

          <div class="row">

            <!-- CMS Info -->
            <div class="col-md-12">
              <h4><%= page.title %></h4>

              <p class="text-muted mb-2">
                <i class="fas fa-link mr-1"></i>
                <strong>Slug:</strong> /page/<%= page.slug %>
              </p>

              <p class="text-muted mb-3">
                <%= page.content 
                      ? page.content.replace(/(<([^>]+)>)/gi, '').substring(0, 200) + '...' 
                      : 'No content provided.' 
                %>
              </p>

              <dl class="row">

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                  <span class="badge badge-<%= page.status ? 'success' : 'secondary' %>">
                    <%= page.status ? 'Active' : 'Inactive' %>
                  </span>
                </dd>

                <dt class="col-sm-4">Footer Position</dt>
                <dd class="col-sm-8"><%= page.position %></dd>

                <dt class="col-sm-4">Created At</dt>
                <dd class="col-sm-8">
                  <%= new Date(page.createdAt).toLocaleString() %>
                </dd>

                <dt class="col-sm-4">Updated At</dt>
                <dd class="col-sm-8">
                  <%= new Date(page.updatedAt).toLocaleString() %>
                </dd>

              </dl>
            </div>

          </div>

          <hr />

          <!-- Full Content Preview -->
          <h5 class="mt-4 mb-2">
            <i class="fas fa-file-alt mr-1"></i> Full Content
          </h5>

          <div class="border p-3 rounded bg-light">
            <% if (page.content) { %>
              <%- page.content %>
            <% } else { %>
              <p class="text-muted">No content available for this page.</p>
            <% } %>
          </div>

        <% } %>
      </div>

    </div>
  </div>
</div>
