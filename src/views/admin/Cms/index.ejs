<!-- views/admin/cms/index.ejs -->
<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-folder-tree mr-2"></i> CMS Pages Management
        </h3>
        <div class="card-tools">
          <a href="/admin/cms/create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-1"></i> Add CMS Page
          </a>
        </div>
      </div>

      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Slug</th>
                <th>Content</th>
                <th>Position</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% if (pages && pages.length > 0) { %>
                <% pages.forEach(page => { %>
                  <tr>
                    <td><%= page.id %></td>
                    <td><strong><%= page.title %></strong></td>
                    <td>
                      <code>/page/<%= page.slug %></code>
                    </td>
                    <td>
                      <% if (page.content) { %>
                        <%= page.content.replace(/(<([^>]+)>)/gi, '').substring(0, 60) %>...
                      <% } else { %>
                        <span class="text-muted">No content</span>
                      <% } %>
                    </td>
                    <td><%= page.position || 0 %></td>
                    <td>
                      <span class="badge badge-<%= page.status ? 'success' : 'secondary' %>">
                        <%= page.status ? 'Active' : 'Inactive' %>
                      </span>
                    </td>
                    <td>
                      <div class="btn-group" role="group">
                        <a href="/page/<%= page.slug %>" target="_blank" class="btn btn-info btn-sm" title="View on Site">
                          <i class="fas fa-external-link-alt"></i>
                        </a>

                        <a href="/admin/cms/<%= page.id %>/edit" class="btn btn-warning btn-sm" title="Edit">
                          <i class="fas fa-edit"></i>
                        </a>

                        <form action="/admin/cms/<%= page.id %>" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-danger btn-sm delete-btn" title="Delete">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center text-muted">No CMS pages found</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
