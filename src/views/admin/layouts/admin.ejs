    <style>
  /* ================= GLOBAL ================= */
body {
  font-family: 'Source Sans Pro', sans-serif;
}

.content-wrapper {
  background: #f6f9f7;
}

/* ================= NAVBAR ================= */
.main-header {
  background: linear-gradient(135deg, #0b662e, #087030);
  border-bottom: none;
}

.main-header .nav-link {
  color: #fff !important;
  font-weight: 500;
}

.main-header .nav-link:hover {
  opacity: 0.9;
}

/* ================= SIDEBAR ================= */
.main-sidebar {
  background: #ffffff !important;
  box-shadow: 2px 0 12px rgba(0,0,0,0.08);
}

.sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link {
  color: #444;
  margin: 6px 12px;
  border-radius: 10px;
  font-weight: 500;
}

.sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link:hover {
  background: #eaf5ee;
  color: #0b662e;
}

.sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link.active {
  background: linear-gradient(135deg, #0b662e, #087030);
  color: #fff;
  box-shadow: 0 6px 16px rgba(11,102,46,0.35);
}

/* ================= DASHBOARD STAT CARDS ================= */
.small-box {
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 10px 28px rgba(0,0,0,0.08);
  transition: all 0.3s ease;
}

.small-box:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 40px rgba(0,0,0,0.12);
}

/* Number */
.small-box h3 {
  font-size: 38px;
  font-weight: 800;
  margin-bottom: 6px;
}

/* Label text */
.small-box p {
  font-size: 15px;
  opacity: 0.95;
}

/* Icon */
.small-box .icon {
  font-size: 72px;
  opacity: 0.2;
  top: 18px;
  right: 20px;
}

/* Footer */
.small-box-footer {
  background: rgba(0,0,0,0.08);
  font-weight: 600;
  padding: 10px 0;
  transition: background 0.3s ease;
}

.small-box-footer:hover {
  background: rgba(0,0,0,0.15);
}

/* ================= COLOR THEMES ================= */

/* Products */
.bg-info {
  background: linear-gradient(135deg, #f17c7c, #f7a2a2) !important;
  
}

/* Categories (Primary Grocery Green) */
.bg-success {
  background: linear-gradient(135deg, #95ecb6, #2a6d42) !important;
}

/* Customers */
.bg-warning {
  background: linear-gradient(135deg, #afe0ec, #02566b) !important;
  color: #000 !important;
}

/* Banners */
.bg-danger {
  background: linear-gradient(135deg, #b897ec, #582c9e) !important;
}

/* CMS */
