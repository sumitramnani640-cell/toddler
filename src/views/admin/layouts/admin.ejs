  background: linear-gradient(135deg, #e8f0a3, #adc004) !important;
}

/* Orders */
.bg-orange {
  background: linear-gradient(135deg, #b3e0f1, #10a585) !important;
}

/* ================= ICON COLOR FIX ================= */
.small-box .icon i {
  color: rgba(255,255,255,0.9);
}


/* Sidebar Icons */
.nav-sidebar .nav-icon {
  color: inherit;
}

/* ================= BRAND LOGO ================= */
