  border: none;
  box-shadow: 0 8px 24px rgba(0,0,0,0.06);
}

.card-header {
  background: #ffffff;
  border-bottom: 1px solid #eee;
  font-weight: 600;
}

.card-title {
  color: #0b662e;
}

/* ================= BUTTONS ================= */
.btn-primary {
  background: linear-gradient(135deg, #0b662e, #087030);
  border: none;
}

.btn-primary:hover {
  background: #087030;
}

.btn-success {
  background: #0b662e;
  border: none;
}

.btn-danger {
  background: #d63031;
  border: none;
}

.btn-sm {
  border-radius: 6px;
}

/* ================= TABLE ================= */
.table {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}

.table th {
  background: #f0f5f2;
  font-weight: 600;
  border: none;
}

.table td {
  vertical-align: middle;
  border-color: #eee;
}

.table-striped tbody tr:nth-of-type(odd) {
  background: #fafcfa;
}

/* ================= IMAGES ================= */
.table img,
.img-thumbnail {
  border-radius: 10px;
  object-fit: cover;
}

/* ================= FORMS ================= */
.form-control {
  border-radius: 10px;
  border: 1px solid #ddd;
}

.form-control:focus {
  border-color: #0b662e;
  box-shadow: 0 0 0 0.15rem rgba(11,102,46,0.25);
}

/* ================= BADGES ================= */
.badge-success {
  background: #0b662e;
}

.badge-warning {
  background: #f1c40f;
  color: #000;
}

.badge-danger {
  background: #e74c3c;
}

/* ================= FOOTER ================= */
.main-footer {
  background: #ffffff;
  border-top: 1px solid #eee;
  color: #666;
  font-size: 14px;
}

/* ================= DROPDOWN ================= */
.dropdown-menu {
  border-radius: 10px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.12);
}

/* ================= JODIT EDITOR ================= */
.jodit-container {
  border-radius: 12px;
  border-color: #ddd;
}

/* ================= ALERTS ================= */
.alert {
  border-radius: 10px;
}
.alert-success {
  background: #d4edda;
  color: #155724;
}
.alert-danger {
  background: #f8d7da;
  color: #721c24;
}
</style>
</head>

