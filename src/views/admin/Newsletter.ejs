<div class="card cms-card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title">
      <i class="fas fa-envelope mr-2"></i> Newsletter Subscribers
    </h3>
  </div>

  <div class="card-body p-0">
    <% if (subscribers.length === 0) { %>
      <div class="p-3 text-muted">No subscribers yet.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover table-bordered mb-0 cms-table">
          <thead>
            <tr>
              <th style="width:60px">#</th>
              <th>Email</th>
              <th>Subscribed At</th>
              <th style="width:120px">Action</th>
            </tr>
          </thead>
          <tbody>
            <% subscribers.forEach((sub, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= sub.email %></td>
                <td><%= new Date(sub.subscribedAt).toLocaleString() %></td>
                <td>
                  <a href="/admin/newsletters/delete/<%= sub.id %>"
                     class="btn btn-sm btn-danger action-btn"
                     onclick="return confirm('Are you sure you want to delete this subscriber?')">
                    <i class="fas fa-trash"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
