<div class="row">
  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">
          <i class="fas fa-layer-group mr-2"></i>
          Category Feature Details
        </h3>
        <div class="card-tools">
          <% if (category) { %>
            <a href="/admin/category-features/<%= category.id %>/edit" class="btn btn-warning btn-sm">
              <i class="fas fa-edit mr-1"></i> Edit
            </a>
            <form
              action="/admin/category-features/<%= category.id %>"
              method="POST"
              class="d-inline"
              onsubmit="return confirm('Are you sure you want to delete this feature?');"
            >
              <button type="submit" class="btn btn-danger btn-sm">
                <i class="fas fa-trash mr-1"></i> Delete
              </button>
            </form>
          <% } %>
          <a href="/admin/category-features" class="btn btn-secondary btn-sm ml-2">
            <i class="fas fa-arrow-left mr-1"></i> Back
          </a>
        </div>
      </div>

      <div class="card-body">
        <% if (!category) { %>
          <div class="alert alert-warning text-center">Category Feature not found.</div>
        <% } else { %>
          <div class="row">
            <!-- Category Image -->
            <div class="col-md-4 text-center">
              <% if (category.image) { %>
                <img
                  src="/uploads/<%= category.image %>"
                  alt="<%= category.name %>"
                  class="img-fluid rounded shadow-sm mb-3"
                  style="max-height: 250px; object-fit: cover;"
                />
              <% } else { %>
                <div class="border rounded py-5">
                  <i class="fas fa-image fa-3x text-muted"></i>
                  <p class="text-muted mt-2">No image available</p>
                </div>
              <% } %>
            </div>

            <!-- Category Info -->
            <div class="col-md-8">
              <h4><%= category.name %></h4>
              <p class="text-muted mb-3"><%= category.description || 'No description provided.' %></p>

              <dl class="row">
                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                  <span class="badge badge-<%= category.status === 'active' ? 'success' : 'secondary' %>">
                    <%= category.status %>
                  </span>
                </dd>

                <dt class="col-sm-4">Created At</dt>
                <dd class="col-sm-8">
                  <%= new Date(category.createdAt).toLocaleString() %>
                </dd>

                <dt class="col-sm-4">Updated At</dt>
                <dd class="col-sm-8">
                  <%= new Date(category.updatedAt).toLocaleString() %>
                </dd>
              </dl>
            </div>
          </div>

          <% if (category.products && category.products.length > 0) { %>
            <hr />
            <h5 class="mt-4 mb-3">
              <i class="fas fa-box mr-2"></i> Products in this Feature
              <span class="badge badge-info"><%= category.products.length %></span>
            </h5>

            <div class="table-responsive">
              <table class="table table-striped table-bordered">
                <thead class="thead-light">
                  <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Image</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% category.products.forEach(product => { %>
                    <tr>
                      <td><%= product.id %></td>
                      <td><%= product.name %></td>
                      <td>
                        <% if (product.image) { %>
                          <img src="/uploads/<%= product.image %>" alt="<%= product.name %>" style="width: 60px; height: 60px; object-fit: cover;" class="rounded shadow-sm" />
                        <% } else { %>
                          <span class="text-muted">No image</span>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge badge-<%= product.status === 'active' ? 'success' : 'secondary' %>">
                          <%= product.status %>
                        </span>
                      </td>
                      <td><%= new Date(product.createdAt).toLocaleDateString() %></td>
                      <td>
                        <a href="/admin/product-features/<%= product.id %>" class="btn btn-info btn-sm">
                          <i class="fas fa-eye"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <hr />
            <p class="text-muted text-center mt-3">
              <i class="fas fa-box-open mr-1"></i> No product features found for this category.
            </p>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</div>
