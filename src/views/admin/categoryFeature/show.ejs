<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-layer-group mr-2"></i>Category Feature Details: <%= category.name %>
        </h3>
        <div class="card-tools">
          <a href="/admin/category-features/<%= category.id %>/edit" class="btn btn-warning btn-sm">
            <i class="fas fa-edit mr-1"></i> Edit
          </a>
        </div>
      </div>

      <div class="card-body">
        <dl class="row">
          <dt class="col-sm-3">Feature Name:</dt>
          <dd class="col-sm-9"><strong><%= category.name %></strong></dd>

          <dt class="col-sm-3">Description:</dt>
          <dd class="col-sm-9"><%= category.description || 'No description provided' %></dd>

          <dt class="col-sm-3">Status:</dt>
          <dd class="col-sm-9">
            <span class="badge badge-<%= category.status === 'active' ? 'success' : 'secondary' %>">
              <%= category.status %>
            </span>
          </dd>

          <dt class="col-sm-3">Created:</dt>
          <dd class="col-sm-9"><%= new Date(category.createdAt).toLocaleString() %></dd>

          <dt class="col-sm-3">Updated:</dt>
          <dd class="col-sm-9"><%= new Date(category.updatedAt).toLocaleString() %></dd>
        </dl>
      </div>

      <div class="card-footer">
        <a href="/admin/category-features" class="btn btn-secondary">
          <i class="fas fa-arrow-left mr-1"></i> Back
        </a>
        <a href="/admin/category-features/<%= category.id %>/edit" class="btn btn-warning ml-2">
          <i class="fas fa-edit mr-1"></i> Edit
        </a>
        <form action="/admin/category-features/<%= category.id %>" method="POST" class="d-inline ml-2">
          <button type="submit" class="btn btn-danger delete-btn">
            <i class="fas fa-trash mr-1"></i> Delete
          </button>
        </form>
      </div>
    </div>

    <!-- Linked Product Features -->
    <% if (category.products && category.products.length > 0) { %>
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fas fa-gift mr-2"></i>Product Features under this Category
          </h3>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Product Feature</th>
                  <th>Link</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% category.products.forEach(product => { %>
                  <tr>
                    <td><%= product.id %></td>
                    <td><strong><%= product.name %></strong></td>
                    <td>
                      <% if (product.link) { %>
                        <a href="<%= product.link %>" target="_blank"><%= product.link %></a>
                      <% } else { %>
                        <span class="text-muted">No link</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge badge-<%= product.status === 'active' ? 'success' : 'secondary' %>">
                        <%= product.status %>
                      </span>
                    </td>
                    <td>
                      <a href="/admin/product-features/<%= product.id %>" class="btn btn-info btn-sm" title="View">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/admin/product-features/<%= product.id %>/edit" class="btn btn-warning btn-sm" title="Edit">
                        <i class="fas fa-edit"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="card">
        <div class="card-body text-center text-muted">
          <i class="fas fa-box fa-3x mb-3"></i>
          <p>No Product Features linked with this Category Feature yet.</p>
          <a href="/admin/product-features/create" class="btn btn-primary">
            <i class="fas fa-plus mr-1"></i> Add Product Feature
          </a>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Sidebar -->
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-chart-bar mr-2"></i>Quick Stats
        </h3>
      </div>
      <div class="card-body">
        <div class="info-box">
          <span class="info-box-icon bg-info">
            <i class="fas fa-gift"></i>
          </span>
          <div class="info-box-content">
            <span class="info-box-text">Total Product Features</span>
            <span class="info-box-number"><%= category.products ? category.products.length : 0 %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-tools mr-2"></i>Quick Actions
        </h3>
      </div>
      <div class="card-body">
        <div class="d-grid gap-2">
          <a href="/admin/category-features/<%= category.id %>/edit" class="btn btn-warning mb-2">
            <i class="fas fa-edit mr-1"></i> Edit Feature
          </a>
          <a href="/admin/product-features/create" class="btn btn-primary">
            <i class="fas fa-plus mr-1"></i> Add Product Feature
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
