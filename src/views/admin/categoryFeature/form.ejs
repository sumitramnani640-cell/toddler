<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-plus mr-2"></i>
          <%= action === 'edit' ? 'Edit Category Feature' : 'Add New Category Feature' %>
        </h3>
      </div>

      <form
        action="<%= action === 'edit' ? '/admin/category-features/' + category.id : '/admin/category-features' %>"
        method="POST"
      >
        <div class="card-body">
          <!-- Feature Name -->
          <div class="form-group">
            <label for="name">Feature Name <span class="text-danger">*</span></label>
            <input
              type="text"
              class="form-control"
              id="name"
              name="name"
              value="<%= category.name || '' %>"
              placeholder="Enter category feature name"
              required
            />
            <small class="form-text text-muted">Enter a descriptive name for the category feature.</small>
          </div>

          <!-- Description -->
          <div class="form-group">
            <label for="description">Description</label>
            <textarea
              class="form-control"
              id="description"
              name="description"
              rows="4"
              placeholder="Enter category feature description"
            ><%= category.description || '' %></textarea>
            <small class="form-text text-muted">Optional short description for this feature.</small>
          </div>

          <!-- Status -->
          <div class="form-group">
            <label for="status">Status</label>
            <select class="form-control" id="status" name="status">
              <option value="active" <%= category.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= category.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>
        </div>

        <div class="card-footer">
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-1"></i>
            <%= action === 'edit' ? 'Update Feature' : 'Create Feature' %>
          </button>
          <a href="/admin/category-features" class="btn btn-secondary ml-2">
            <i class="fas fa-times mr-1"></i> Cancel
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Sidebar (Guidelines / Info) -->
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-info-circle mr-2"></i> Feature Guidelines
        </h3>
      </div>
      <div class="card-body">
        <h5>Feature Information</h5>
        <ul class="list-unstyled">
          <li><i class="fas fa-check text-success mr-2"></i>Use short and clear names</li>
          <li><i class="fas fa-check text-success mr-2"></i>Describe feature purpose briefly</li>
          <li><i class="fas fa-check text-success mr-2"></i>Keep it simple and user-friendly</li>
          <li><i class="fas fa-check text-success mr-2"></i>Ensure consistent naming conventions</li>
        </ul>

        <h5>Status Tips</h5>
        <ul class="list-unstyled">
          <li><i class="fas fa-toggle-on text-success mr-2"></i>Active — visible on website</li>
          <li><i class="fas fa-toggle-off text-muted mr-2"></i>Inactive — hidden temporarily</li>
        </ul>

        <h5>Examples</h5>
        <ul class="list-unstyled">
          <li><strong>Name:</strong> Trending Products</li>
          <li><strong>Description:</strong> Displays the latest trending items</li>
          <li><strong>Name:</strong> Seasonal Offers</li>
          <li><strong>Description:</strong> Highlights current promotional products</li>
        </ul>
      </div>
    </div>
  </div>
</div>
