<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-layer-group mr-2"></i>Category Features Management
        </h3>
        <div class="card-tools">
          <a href="/admin/category-features/create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus mr-1"></i> Add Category Feature
          </a>
        </div>
      </div>

      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>Feature Name</th>
                <th>Description</th>
                <th>Products</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(category => { %>
                  <tr>
                    <td><%= category.id %></td>
                    <td><strong><%= category.name %></strong></td>
                    <td>
                      <% if (category.description) { %>
                        <%= category.description.substring(0, 60) %>...
                      <% } else { %>
                        <span class="text-muted">No description</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge badge-info">
                        <%= category.products ? category.products.length : 0 %> products
                      </span>
                    </td>
                    <td>
                      <span class="badge badge-<%= category.status === 'active' ? 'success' : 'secondary' %>">
                        <%= category.status %>
                      </span>
                    </td>
                    <td>
                      <div class="btn-group" role="group">
                        <a href="/admin/category-features/<%= category.id %>" class="btn btn-info btn-sm" title="View">
                          <i class="fas fa-eye"></i>
                        </a>
                        <a href="/admin/category-features/<%= category.id %>/edit" class="btn btn-warning btn-sm" title="Edit">
                          <i class="fas fa-edit"></i>
                        </a>
                        <form action="/admin/category-features/<%= category.id %>" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-danger btn-sm delete-btn" title="Delete">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center text-muted">No category features found</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
