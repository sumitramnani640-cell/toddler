<!-- views/admin/categories/create.ejs -->
<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-plus mr-2"></i>Add New Category
        </h3>
      </div>

      <!-- FORM -->
      <form action="/admin/categories" method="POST" enctype="multipart/form-data">
        <div class="card-body">
          <!-- Name -->
          <div class="form-group">
            <label for="name">Category Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="name" name="name" required>
          </div>

          <!-- Slug -->
          <div class="form-group">
            <label for="slug">Slug <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="slug" name="slug" required>
            <small class="form-text text-muted">URL-friendly version of the name (lowercase, use hyphens)</small>
          </div>

          <!-- Description -->
          <div class="form-group">
            <label for="description">Description</label>
            <textarea class="form-control" id="description" name="description" rows="4" placeholder="Enter category description"></textarea>
          </div>

          <!-- Status -->
          <div class="form-group">
            <label for="status">Status</label>
            <select class="form-control" id="status" name="status">
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>

          <!-- IMAGES SECTION (2 columns) -->
          <div class="row">
            <!-- Category Image -->
            <div class="col-md-6">
              <div class="form-group">
                <label for="image">Category Image</label>
                <div class="custom-file">
                  <input type="file" class="custom-file-input" id="image" name="image" accept="image/*">
                  <label class="custom-file-label" for="image">Choose file</label>
                </div>
                <small class="form-text text-muted">
                  Recommended square format (e.g., 600×600). Max 5MB.
                </small>

                <div id="imagePreview" class="mt-2" style="display:none;">
                  <img id="previewImg" src="" alt="Preview" class="img-thumbnail" style="max-width:100%; height:150px; object-fit:cover;">
                </div>
              </div>
            </div>

            <!-- Banner Image -->
            <div class="col-md-6">
              <div class="form-group">
                <label for="banner_image">Banner 0................/ Cover Image</label>
                <div class="custom-file">
                  <input type="file" class="custom-file-input" id="banner_image" name="banner_image" accept="image/*">
                  <label class="custom-file-label" for="banner_image">Choose file</label>
                </div>
                <small class="form-text text-muted">
                  Recommended banner size ~1200×300. Max 5MB.
                </small>

                <div id="bannerPreview" class="mt-2" style="display:none;">
                  <img id="bannerPreviewImg" src="" alt="Banner Preview" class="img-thumbnail" style="max-width:100%; height:150px; object-fit:cover;">
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card-footer">
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-1"></i> Create Category
          </button>
          <a href="/admin/categories" class="btn btn-secondary ml-2">
            <i class="fas fa-times mr-1"></i> Cancel
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Guidelines -->
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-info-circle mr-2"></i>Category Guidelines
        </h3>
      </div>
      <div class="card-body">
        <h5>Category Information</h5>
        <ul class="list-unstyled">
          <li><i class="fas fa-check text-success mr-2"></i>Use clear, descriptive names</li>
          <li><i class="fas fa-check text-success mr-2"></i>Keep names concise</li>
          <li><i class="fas fa-check text-success mr-2"></i>Use consistent naming</li>
          <li><i class="fas fa-check text-success mr-2"></i>Include helpful descriptions</li>
        </ul>

        <h5 class="mt-3">Image Tips</h5>
        <ul class="list-unstyled">
          <li><i class="fas fa-check text-success mr-2"></i>Category image: 600×600 (square)</li>
          <li><i class="fas fa-check text-success mr-2"></i>Banner image: 1900×300 (wide)</li>
          <li><i class="fas fa-check text-success mr-2"></i>Use JPG/PNG/WebP</li>
          <li><i class="fas fa-check text-success mr-2"></i>Keep under 5MB each</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  // Auto-generate slug
  document.getElementById('name').addEventListener('input', function(e) {
    const name = e.target.value;
    const slug = name.toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .trim();
    document.getElementById('slug').value = slug;
  });

  // Preview helper function
  function setupPreview(inputId, labelSelector, previewId, imgId) {
    const input = document.getElementById(inputId);
    const label = document.querySelector(labelSelector);
    const previewBox = document.getElementById(previewId);
    const img = document.getElementById(imgId);

    input.addEventListener('change', (e) => {
      const file = e.target.files[0];
      label.textContent = file ? file.name : 'Choose file';

      if (!file) {
        previewBox.style.display = 'none';
        return;
      }

      const reader = new FileReader();
      reader.onload = (evt) => {
        img.src = evt.target.result;
        previewBox.style.display = 'block';
      };
      reader.readAsDataURL(file);
    });
  }

  // Initialize previews for both images
  setupPreview('image', 'label[for="image"]', 'imagePreview', 'previewImg');
  setupPreview('banner_image', 'label[for="banner_image"]', 'bannerPreview', 'bannerPreviewImg');
</script>
